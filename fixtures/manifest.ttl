<#documentreference-contained-custodian> a bridge:IsomorphicConversionTest ;
  mf:name "documentreference-contained-custodian" ;
  rdfs:comment "A DocumentReference's custodian keeps the document it describes, not the file read: it names no organization, and its contained Organization is a resource of a type not mapped." ;
