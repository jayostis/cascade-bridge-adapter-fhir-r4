    <#medication-statement-every-mapped-element>
    <#medication-request-contained-medication>
    <#medication-request-reference-outside>
    <#bundle-medication-request-and-medication>
    <#medication-request-two-rxnorm-codes>
    <#medication-request-ndc-forms>
    <#bundle-medication-versioned-reference>
    <#bundle-medication-repeated-id>
    <#bundle-pull-collection-versions>
    <#bundle-pull-searchset-outcome>
    <#Bundle-bundle-cgexample>
    <#Bundle-bundle-compound-heterozygote>
    <#Bundle-bundle-oncology-diagnostic>
    <#bundle-genomics-variants>
    <#bundle-genomics-interpretations>
    <#bundle-interpretation-relative-reference-to-urn>
