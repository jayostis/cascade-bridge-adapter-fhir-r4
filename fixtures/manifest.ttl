<#bundle-repeated-condition-id> a bridge:IsomorphicConversionTest ;
  mf:name "bundle-repeated-condition-id" ;
  rdfs:comment "Two entries holding one Condition id: each is named from the document's SHA-256 and its selector, and each carries a finding of the repeated id." ;
  mf:action [
    bridge:input <in/bundle-repeated-condition-id.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-bundle> ;
    bridge:facts <facts/meridian.ttl>
  ] ;
