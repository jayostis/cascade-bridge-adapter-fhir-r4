<#npi-and-its-oid-name-one-organization> a bridge:IdentityRelationTest ;
  mf:name "npi-and-its-oid-name-one-organization" ;
  rdfs:comment "Two documents' custodians, one naming its NPI by the NPI's URI and one by its OID, name one organization record." ;
  mf:action [
    bridge:conversion [
      bridge:input <in/bundle-document-custodian-and-authors.json> ;
      bridge:envelope <../ro-crate-metadata.json#envelope-bundle> ;
      bridge:facts <facts/no-server.ttl> ;
      bridge:selector "/entry/2"
    ] , [
      bridge:input <in/bundle-document-organizations-one-npi.json> ;
      bridge:envelope <../ro-crate-metadata.json#envelope-bundle> ;
      bridge:facts <facts/no-server.ttl> ;
      bridge:selector "/entry/2"
    ]
  ] ;
  mf:result [ bridge:sameRecord true ] .

<#ids-in-two-orders-name-one-organization> a bridge:IdentityRelationTest ;
  mf:name "ids-in-two-orders-name-one-organization" ;
  rdfs:comment "An author entry of a document Bundle and a standalone Composition's contained custodian, listing one organization's identifiers in two orders, name one organization record." ;
  mf:action [
    bridge:conversion [
      bridge:input <in/bundle-document-organizations-one-npi.json> ;
      bridge:envelope <../ro-crate-metadata.json#envelope-bundle> ;
      bridge:facts <facts/no-server.ttl> ;
      bridge:selector "/entry/5"
    ] , [
      bridge:input <in/composition-contained-custodian.json> ;
      bridge:envelope <../ro-crate-metadata.json#envelope-resource> ;
      bridge:facts <facts/no-server.ttl> ;
      bridge:selector "/contained/0"
    ]
  ] ;
  mf:result [ bridge:sameRecord true ] .

<#bundle-document-organizations-one-npi> a bridge:IsomorphicConversionTest ;
  mf:name "bundle-document-organizations-one-npi" ;
  rdfs:comment "A custodian naming its NPI by the NPI's OID and two authors naming it by its URI: one organization record, one version read from the custodian, and one attribution in each role; and an author listing an OID-typed identifier before a urn:ietf:rfc:3986 one, named by the latter." ;
  mf:action [
    bridge:input <in/bundle-document-organizations-one-npi.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-bundle> ;
