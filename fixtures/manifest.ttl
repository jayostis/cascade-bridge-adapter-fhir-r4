  ] ;
  mf:result [
    bridge:expectedGraph <expected/bundle-medication-versioned-reference.ttl> ;
    bridge:expectedFindings <findings/bundle-medication-versioned-reference.ttl>
  ] .

<#bundle-medication-repeated-id> a bridge:IsomorphicConversionTest ;
  mf:name "bundle-medication-repeated-id" ;
  rdfs:comment "A Bundle holding two Medications sharing type and id, and a MedicationRequest referencing that type and id: the reference resolves to neither, so the request names no drug and its reference is a finding, and each Medication is a finding." ;
