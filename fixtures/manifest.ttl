<#lab-potassium-approximate> a bridge:IsomorphicConversionTest ;
  mf:name "lab-potassium-approximate" ;
  rdfs:comment "A laboratory Observation whose value carries the comparator ~, outside FHIR R4's four: no number is typed, the value is text, ~4.1, its unit the unit's text, and the refused comparator is a finding." ;
  mf:action [
    bridge:input <in/lab-potassium-approximate.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-resource> ;
    bridge:facts <facts/meridian.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/lab-potassium-approximate.ttl> ;
    bridge:expectedFindings <findings/lab-potassium-approximate.ttl>
  ] .

<#lab-titre-ratio> a bridge:IsomorphicConversionTest ;
  mf:name "lab-titre-ratio" ;
  rdfs:comment "A laboratory Observation whose value is a titre: a ratio, its numerator and denominator each a quantity with no unit." ;
  mf:action [
    bridge:input <in/lab-titre-ratio.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-resource> ;
    bridge:facts <facts/meridian.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/lab-titre-ratio.ttl> ;
    bridge:expectedFindings <findings/lab-titre-ratio.ttl>
  ] .

<#lab-urine-leukocytes-range> a bridge:IsomorphicConversionTest ;
  mf:name "lab-urine-leukocytes-range" ;
  rdfs:comment "A laboratory Observation whose value is a range: two bounds, each a quantity with its UCUM unit and its display." ;
  mf:action [
    bridge:input <in/lab-urine-leukocytes-range.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-resource> ;
    bridge:facts <facts/meridian.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/lab-urine-leukocytes-range.ttl> ;
    bridge:expectedFindings <findings/lab-urine-leukocytes-range.ttl>
  ] .

<#lab-hepatitis-b-surface-antigen-coded> a bridge:IsomorphicConversionTest ;
  mf:name "lab-hepatitis-b-surface-antigen-coded" ;
  rdfs:comment "A laboratory Observation whose value is coded: the LOINC answer as a code IRI and its text as the value's text; the local code is a finding." ;
  mf:action [
    bridge:input <in/lab-hepatitis-b-surface-antigen-coded.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-resource> ;
    bridge:facts <facts/meridian.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/lab-hepatitis-b-surface-antigen-coded.ttl> ;
    bridge:expectedFindings <findings/lab-hepatitis-b-surface-antigen-coded.ttl>
  ] .

<#lab-leukocytes-exponent-and-ranges> a bridge:IsomorphicConversionTest ;
  mf:name "lab-leukocytes-exponent-and-ranges" ;
  rdfs:comment "A laboratory Observation whose number is written with an exponent: its decimal value is the number written out and its written value is as sent; of the reference range marked normal neither bound is typed, since its low bound carries a comparator, which is a finding, and half a range would read as one-sided; as is the first range's unit outside UCUM and each value of the second range." ;
  mf:action [
    bridge:input <in/lab-leukocytes-exponent-and-ranges.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-resource> ;
    bridge:facts <facts/meridian.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/lab-leukocytes-exponent-and-ranges.ttl> ;
    bridge:expectedFindings <findings/lab-leukocytes-exponent-and-ranges.ttl>
  ] .

<#lab-potassium-identifiers> a bridge:IsomorphicConversionTest ;
  mf:name "lab-potassium-identifiers" ;
  rdfs:comment "A lab result's identifiers: each with a value is a business identifier of its version, typed by its system where it states one and a plain string where it states none; the one with no value is not written." ;
  mf:action [
    bridge:input <in/lab-potassium-identifiers.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-resource> ;
    bridge:facts <facts/meridian.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/lab-potassium-identifiers.ttl> ;
    bridge:expectedFindings <findings/lab-potassium-identifiers.ttl>
  ] .

