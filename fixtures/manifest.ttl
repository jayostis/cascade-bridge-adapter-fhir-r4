@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mf:     <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

<> a mf:Manifest ;
  rdfs:label "cascade-bridge-adapter-fhir-r4 fixture cases" ;
  bridge:adapter <../> ;
  mf:entries (
    <#allergy-with-id>
    <#allergy-every-mapped-element>
    <#allergy-no-id-penicillin>
    <#allergy-no-id-penicillin-compact>
    <#allergy-no-id-sulfa>
    <#condition-with-id>
    <#condition-every-mapped-element>
    <#condition-with-id-meta-fetch-a>
    <#condition-with-id-meta-fetch-b>
    <#condition-no-id-structured-hypertension>
    <#condition-no-id-structured-diabetes>
    <#condition-no-id-narrative-diabetes>
    <#condition-no-id-narrative-breast-cancer>
    <#immunization-with-id>
    <#immunization-every-mapped-element>
    <#immunization-no-id-2024>
    <#immunization-no-id-2025>
    <#procedure-with-id>
    <#procedure-no-id-colonoscopy>
    <#procedure-no-id-echocardiogram>
    <#procedure-with-contained-condition>
    <#patient-with-id>
    <#patient-no-id>
    <#bundle-two-identical-id-less-allergies>
    <#bundle-urn-uuid-full-urls>
    <#bundle-repeated-condition-id>
    <#encounter-with-id>
    <#lab-glucose-fasting>
    <#lab-every-mapped-element>
    <#lab-no-category-potassium>
    <#vital-heartrate-with-id>
    <#vital-no-category-heart-rate>
    <#medication-with-id>
    <#medication-no-id-bare>
    <#medication-no-id-note-only>
    <#medication-request-every-mapped-element>
    <#medication-statement-every-mapped-element>
    <#medication-request-contained-medication>
    <#medication-request-reference-outside>
    <#bundle-medication-request-and-medication>
    <#condition-no-id-differs-only-in-narrative>
    <#condition-no-id-different-structured-content>
    <#allergy-no-id-different-allergen>
    <#immunization-no-id-different-dates>
    <#procedure-no-id-different-procedures>
    <#patient-no-id-different-people>
    <#condition-same-record-two-server-fetches>
    <#condition-id-bearing-differs-from-id-less>
    <#allergy-id-bearing-differs-from-id-less>
    <#immunization-id-bearing-differs-from-id-less>
    <#bundle-two-identical-id-less-allergies-name-two-records>
    <#allergy-no-id-penicillin-imported-twice-names-one-record>
    <#allergy-no-id-penicillin-compact-copy-names-another-record>
    <#bundle-urn-uuid-full-urls-entry-imported-twice-names-one-record>
    <#bundle-repeated-condition-id-names-two-records>
    <#lab-same-day-same-code-different-value>
    <#lab-same-day-same-code-different-value-id-less>
    <#medication-no-id-differs-only-in-narrative>
    <#lab-id-bearing-differs-from-id-less>
  ) .

<#allergy-with-id> a bridge:IsomorphicConversionTest ;
  mf:name "allergy-with-id" ;
  mf:action [
    bridge:input <in/allergy-with-id.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-resource> ;
    bridge:facts <facts/allergyintolerance-alg-pcn-1.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/allergy-with-id.ttl> ;
    bridge:expectedFindings <findings/allergy-with-id.ttl>
  ] .

<#allergy-every-mapped-element> a bridge:IsomorphicConversionTest ;
  mf:name "allergy-every-mapped-element" ;
  mf:action [
    bridge:input <in/allergy-every-mapped-element.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-resource> ;
    bridge:facts <facts/meridian.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/allergy-every-mapped-element.ttl> ;
    bridge:expectedFindings <findings/allergy-every-mapped-element.ttl>
  ] .

