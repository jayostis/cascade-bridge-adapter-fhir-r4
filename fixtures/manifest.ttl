<#bundle-condition-onsets-and-the-fhir-date-forms> a bridge:IsomorphicConversionTest ;
  mf:name "bundle-condition-onsets-and-the-fhir-date-forms" ;
  rdfs:comment "A Bundle of Conditions whose onsetDateTime is each form of FHIR's date and dateTime or none of them: the carried are a leap day, a leap day of a year divisible by 400, a year, a year and month, a time to the minute with an offset (held padded to the second), a fraction of a second and the last second of a day; hour 24, year 0000, a leap second, a time with no zone, with seconds or without, February 29 of 1900 and minute 61 are no value and each is a finding, fhirr4:dateNotCarried." ;
  mf:action [
    bridge:input <in/bundle-condition-onsets-and-the-fhir-date-forms.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-bundle> ;
    bridge:facts <facts/example-org.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/bundle-condition-onsets-and-the-fhir-date-forms.ttl> ;
    bridge:expectedFindings <findings/bundle-condition-onsets-and-the-fhir-date-forms.ttl>
  ] .

<#medication-dispense-prescription-without-server> a bridge:IsomorphicConversionTest ;
  mf:name "medication-dispense-prescription-without-server" ;
  rdfs:comment "A MedicationDispense in a document from no known server, whose prescription is a reference relative to a server: it names no record, since a relative reference means nothing without its server, and is a finding." ;
  mf:action [
    bridge:input <in/medication-dispense-prescription-without-server.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-resource> ;
    bridge:facts <facts/no-server.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/medication-dispense-prescription-without-server.ttl> ;
    bridge:expectedFindings <findings/medication-dispense-prescription-without-server.ttl>
  ] .

<#bundle-medication-dispense-repeated-id-and-patient-not-held> a bridge:IsomorphicConversionTest ;
  mf:name "bundle-medication-dispense-repeated-id-and-patient-not-held" ;
  rdfs:comment "A Bundle of three MedicationDispenses: two of one id, which a reference to that id cannot tell apart, so each is a finding and each is named from the document; and one whose subject is a urn:uuid no entry holds, which names no patient and is a finding." ;
  mf:action [
    bridge:input <in/bundle-medication-dispense-repeated-id-and-patient-not-held.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-bundle> ;
    bridge:facts <facts/meridian.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/bundle-medication-dispense-repeated-id-and-patient-not-held.ttl> ;
    bridge:expectedFindings <findings/bundle-medication-dispense-repeated-id-and-patient-not-held.ttl>
  ] .
