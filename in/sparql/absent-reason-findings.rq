PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:      <http://www.w3.org/ns/shacl#>
PREFIX oa:      <http://www.w3.org/ns/oa#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX fx:      <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:     <http://sparql.xyz/facade-x/data/>
PREFIX bridge:  <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX fhirr4:  <https://ns.cascadeprotocol.org/adapter/fhir-r4/v1-draft#>
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX void:    <http://rdfs.org/ns/void#>

# Each reason a value is absent that absent-reasons.rq does not carry: a coding
# of a lab result's dataAbsentReason in a system other than FHIR's data absent
# reasons and v3 NullFlavor, or with a code its system does not define, a lab
# result's dataAbsentReason given as text alone, valued by its text, and a
# data-absent-reason extension's code the CodeSystem does not define.

CONSTRUCT {
  [] a oa:Annotation ;
    oa:hasTarget [
      oa:hasSource bridge:thisRecord ;
      oa:hasSelector [
        a oa:FragmentSelector ;
        dcterms:conformsTo <https://www.rfc-editor.org/rfc/rfc6901> ;
        rdf:value ?pointer
      ]
    ] ;
    oa:hasBody fhirr4:absentReasonNotCarried ;
    oa:motivatedBy oa:classifying ;
    sh:value ?value .
}
WHERE {
  FILTER NOT EXISTS {
    bridge:thisDocument cascade:sourceFormatVersion ?stated .
    FILTER (!STRSTARTS(?stated, "4.0."))
  }
  ?root a fx:root .
  { ?root xyz:resourceType ?topType . BIND (?root AS ?top) BIND ("" AS ?topStep) }
  UNION
  { ?root xyz:resource ?top . ?top xyz:resourceType ?topType . BIND ("/resource" AS ?topStep) }
  { BIND ("" AS ?containedStep) }
  UNION
  {
    ?top xyz:contained ?containedList .
    ?containedList ?containedSlot ?contained .
    ?contained xyz:resourceType ?containedType .
    BIND (CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?containedSlot), "#_")) - 1)) AS ?containedStep)
  }
  BIND (COALESCE(?contained, ?top) AS ?resource)
  bridge:thisRecord bridge:selector ?recordSelector .
  BIND (CONCAT(?topStep, ?containedStep) AS ?resourcePointer)
  BIND (CONCAT(?recordSelector, ?resourcePointer) AS ?labPointer)
  ?resource xyz:resourceType ?type .
  {
    ?lab fhirr4:labResultAt ?labPointer .
    ?resource xyz:dataAbsentReason ?concept . ?concept xyz:coding ?codings . ?codings ?codingSlot ?coding .
    OPTIONAL { ?coding xyz:system ?system }
    OPTIONAL { ?coding xyz:code ?value }
    BIND (CONCAT("/dataAbsentReason/coding/", STR(xsd:integer(STRAFTER(STR(?codingSlot), "#_")) - 1)) AS ?tail)
  }
  UNION
  {
    ?lab fhirr4:labResultAt ?labPointer .
    ?resource xyz:dataAbsentReason ?concept . ?concept xyz:text ?value .
    FILTER NOT EXISTS { ?concept xyz:coding ?anyCoding }
    BIND ("/dataAbsentReason/text" AS ?tail)
  }
  UNION
  {
    VALUES (?type ?absentKey ?keyName) {
      ("Patient"             xyz:_birthDate          "_birthDate")
      ("Patient"             xyz:_gender             "_gender")
      ("AllergyIntolerance"  xyz:_onsetDateTime      "_onsetDateTime")
      ("Condition"           xyz:_onsetDateTime      "_onsetDateTime")
      ("Condition"           xyz:_abatementDateTime  "_abatementDateTime")
      ("Immunization"        xyz:_occurrenceDateTime "_occurrenceDateTime")
      ("Procedure"           xyz:_performedDateTime  "_performedDateTime")
      ("Observation"         xyz:_effectiveDateTime  "_effectiveDateTime")
      ("MedicationStatement" xyz:_effectiveDateTime  "_effectiveDateTime")
      ("MedicationRequest"   xyz:_authoredOn         "_authoredOn")
      ("DiagnosticReport"    xyz:_effectiveDateTime  "_effectiveDateTime")
      ("DiagnosticReport"    xyz:_issued             "_issued")
      ("DocumentReference"   xyz:_date               "_date")
      ("MedicationDispense"  xyz:_whenPrepared       "_whenPrepared")
      ("MedicationDispense"  xyz:_whenHandedOver     "_whenHandedOver")
    }
    ?resource ?absentKey ?element .
    ?element xyz:extension ?extensions . ?extensions ?extensionSlot ?extension .
    ?extension xyz:url "http://hl7.org/fhir/StructureDefinition/data-absent-reason" ; xyz:valueCode ?value .
    BIND ("http://terminology.hl7.org/CodeSystem/data-absent-reason" AS ?system)
    BIND (CONCAT("/", ?keyName, "/extension/", STR(xsd:integer(STRAFTER(STR(?extensionSlot), "#_")) - 1),
                 "/valueCode") AS ?tail)
  }
  FILTER (?type != "Observation" || EXISTS { ?lab fhirr4:labResultAt ?labPointer })
  FILTER (?type != "DocumentReference" || EXISTS { ?note fhirr4:noteOrDocumentAt ?labPointer })
  BIND (CONCAT(?resourcePointer, ?tail) AS ?pointer)
  BIND (STRDT(COALESCE(?system, ""), xsd:anyURI) AS ?systemUri)
  OPTIONAL { ?codeSystem skos:inScheme fhirr4:codeSystems ; cascade:codingSystemUri ?systemUri ; void:uriSpace ?stem }
  BIND (IRI(CONCAT(?stem, ENCODE_FOR_URI(?value))) AS ?reason)
  FILTER (!BOUND(?reason) || NOT EXISTS { ?reason skos:inScheme fhirr4:absentReasonCodes })
}
