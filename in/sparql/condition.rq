PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX fx:       <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:      <http://sparql.xyz/facade-x/data/>
PREFIX bridge:   <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX cascade:  <https://ns.cascadeprotocol.org/cascade#>
PREFIX foaf:     <http://xmlns.com/foaf/0.1/>
PREFIX skos:     <http://www.w3.org/2004/02/skos/core#>
PREFIX void:     <http://rdfs.org/ns/void#>
PREFIX fhirr4:   <https://ns.cascadeprotocol.org/adapter/fhir-r4/v1-draft#>

# A date is typed by the precision FHIR wrote it to: a year is an xsd:gYear, a
# year and month an xsd:gYearMonth, a day an xsd:date, a time an xsd:dateTime.
# A time written to the minute, as C-CDA on FHIR writes one, is padded to the
# second and keeps a cascade:PaddedDateTime node, <version>#padded- and its
# property's local name, holding what was written.

CONSTRUCT {
  ?version ?p ?o .
  ?version cascade:paddedDateTime ?paddedNode .
  ?paddedNode cascade:paddedDateTimeProperty ?p ;
    cascade:writtenDate ?writtenTime .
}
WHERE {
  FILTER NOT EXISTS {
    bridge:thisDocument cascade:sourceFormatVersion ?stated .
    FILTER (!STRSTARTS(?stated, "4.0."))
  }
  bridge:thisRecord bridge:selector ?recordSelector .
  ?root a fx:root .
  { ?root xyz:resourceType ?topType . BIND (?root AS ?top) BIND ("" AS ?topStep) }
  UNION
  { ?root xyz:resource ?top . ?top xyz:resourceType ?topType . BIND ("/resource" AS ?topStep) }
  { BIND ("" AS ?containedStep) }
  UNION
  {
    ?top xyz:contained ?containedList .
    ?containedList ?containedSlot ?contained .
    ?contained xyz:resourceType ?containedType .
    BIND (CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?containedSlot), "#_")) - 1)) AS ?containedStep)
  }
  BIND (COALESCE(?contained, ?top) AS ?resource)
  ?resource xyz:resourceType "Condition" .
  BIND (IRI(CONCAT("urn:cascade:version-at:", SHA256(CONCAT(?recordSelector, ?topStep, ?containedStep)))) AS ?version)

  {
    ?resource xyz:code ?concept . ?concept xyz:text ?o .
    BIND (cascade:conditionName AS ?p)
  }
  UNION
  {
    ?resource xyz:code ?concept . ?concept xyz:coding ?codings .
    ?codings ?codingSlot ?coding . ?coding xyz:display ?o .
    FILTER NOT EXISTS { ?concept xyz:text ?text }
    FILTER NOT EXISTS {
      ?codings ?earlierSlot ?earlier . ?earlier xyz:display ?earlierDisplay .
      FILTER (xsd:integer(STRAFTER(STR(?earlierSlot), "#_")) < xsd:integer(STRAFTER(STR(?codingSlot), "#_")))
    }
    BIND (cascade:conditionName AS ?p)
  }
  UNION
  {
    ?resource xyz:code ?coded . ?coded xyz:coding ?codings . ?codings ?codingSlot ?coding .
    ?coding xyz:system "http://snomed.info/sct" ;
      xyz:code ?code .
    ?codeSystem skos:inScheme fhirr4:codeSystems ;
      cascade:codingSystemUri "http://snomed.info/sct"^^xsd:anyURI ;
      void:uriSpace ?stem .
    BIND (cascade:snomedCode AS ?p)
    BIND (IRI(CONCAT(?stem, ENCODE_FOR_URI(?code))) AS ?o)
  }
  UNION
  {
    ?resource xyz:code ?coded . ?coded xyz:coding ?codings . ?codings ?codingSlot ?coding .
    ?coding xyz:system "http://hl7.org/fhir/sid/icd-10-cm" ;
      xyz:code ?code .
    ?codeSystem skos:inScheme fhirr4:codeSystems ;
      cascade:codingSystemUri "http://hl7.org/fhir/sid/icd-10-cm"^^xsd:anyURI ;
      void:uriSpace ?stem .
    BIND (cascade:icd10Code AS ?p)
    BIND (IRI(CONCAT(?stem, ENCODE_FOR_URI(?code))) AS ?o)
  }
  UNION
  {
    ?resource xyz:clinicalStatus ?coded . ?coded xyz:coding ?codings . ?codings ?codingSlot ?coding .
    ?coding xyz:system "http://terminology.hl7.org/CodeSystem/condition-clinical" ;
      xyz:code ?code .
    BIND (cascade:clinicalStatus AS ?p)
    BIND (?code AS ?o)
  }
  UNION
  {
    ?resource xyz:verificationStatus ?coded . ?coded xyz:coding ?codings . ?codings ?codingSlot ?coding .
    ?coding xyz:system "http://terminology.hl7.org/CodeSystem/condition-ver-status" ;
      xyz:code ?code .
    BIND (cascade:verificationStatus AS ?p)
    BIND (?code AS ?o)
  }
  UNION
  {
    ?resource xyz:category ?categories . ?categories rdf:_1 ?category .
    ?category xyz:coding ?codings . ?codings ?codingSlot ?coding .
    ?coding xyz:system "http://terminology.hl7.org/CodeSystem/condition-category" ;
      xyz:code ?o .
    BIND (cascade:conditionCategory AS ?p)
  }
  UNION
  {
    ?resource xyz:onsetDateTime ?when .
    BIND (cascade:onsetDate AS ?p)
    BIND (IF(REGEX(?when, "^[0-9]{4}$"), STRDT(?when, xsd:gYear),
             IF(REGEX(?when, "^[0-9]{4}-[0-9]{2}$"), STRDT(?when, xsd:gYearMonth),
             IF(REGEX(?when, "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"), STRDT(?when, xsd:date),
             IF(REGEX(?when, "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})?$"), STRDT(CONCAT(SUBSTR(?when, 1, 16), ":00", SUBSTR(?when, 17)), xsd:dateTime),
             IF(REGEX(?when, "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"), STRDT(?when, xsd:dateTime), 1/0))))) AS ?o)
    BIND (IF(REGEX(?when, "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})?$"), ?when, 1/0) AS ?writtenTime)
  }
  UNION
  {
    ?resource xyz:abatementDateTime ?when .
    BIND (cascade:abatementDate AS ?p)
    BIND (IF(REGEX(?when, "^[0-9]{4}$"), STRDT(?when, xsd:gYear),
             IF(REGEX(?when, "^[0-9]{4}-[0-9]{2}$"), STRDT(?when, xsd:gYearMonth),
             IF(REGEX(?when, "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"), STRDT(?when, xsd:date),
             IF(REGEX(?when, "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})?$"), STRDT(CONCAT(SUBSTR(?when, 1, 16), ":00", SUBSTR(?when, 17)), xsd:dateTime),
             IF(REGEX(?when, "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"), STRDT(?when, xsd:dateTime), 1/0))))) AS ?o)
    BIND (IF(REGEX(?when, "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})?$"), ?when, 1/0) AS ?writtenTime)
  }
  UNION
  {
    ?resource xyz:note ?notes . ?notes ?noteSlot ?note . ?note xyz:text ?o .
    BIND (cascade:notes AS ?p)
  }
  BIND (IF(BOUND(?writtenTime), IRI(CONCAT(STR(?version), "#padded-", STRAFTER(STR(?p), "#"))), 1/0) AS ?paddedNode)
}
