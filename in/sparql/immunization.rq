PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX fx:       <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:      <http://sparql.xyz/facade-x/data/>
PREFIX bridge:   <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX cascade:  <https://ns.cascadeprotocol.org/core/v1#>
PREFIX health:   <https://ns.cascadeprotocol.org/health/v1#>
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX foaf:     <http://xmlns.com/foaf/0.1/>

# A date FHIR writes with less than a day's precision fits no Cascade date, and
# is not carried.

CONSTRUCT {
  ?version ?p ?o .
}
WHERE {
  FILTER NOT EXISTS {
    bridge:thisDocument bridge:sourceFormatVersion ?stated .
    FILTER (!STRSTARTS(?stated, "4.0."))
  }
  bridge:thisRecord bridge:selector ?recordSelector .
  ?root a fx:root .
  { ?root xyz:resourceType ?topType . BIND (?root AS ?top) BIND ("" AS ?topStep) }
  UNION
  { ?root xyz:resource ?top . ?top xyz:resourceType ?topType . BIND ("/resource" AS ?topStep) }
  { BIND ("" AS ?containedStep) }
  UNION
  {
    ?top xyz:contained ?containedList .
    ?containedList ?containedSlot ?contained .
    ?contained xyz:resourceType ?containedType .
    BIND (CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?containedSlot), "#_")) - 1)) AS ?containedStep)
  }
  BIND (COALESCE(?contained, ?top) AS ?resource)
  ?resource xyz:resourceType "Immunization" .
  BIND (IRI(CONCAT("urn:cascade:version-at:", SHA256(CONCAT(?recordSelector, ?topStep, ?containedStep)))) AS ?version)

  {
    ?resource xyz:vaccineCode ?concept . ?concept xyz:text ?o .
    BIND (health:vaccineName AS ?p)
  }
  UNION
  {
    ?resource xyz:vaccineCode ?concept . ?concept xyz:coding ?codings .
    ?codings ?codingSlot ?coding . ?coding xyz:display ?o .
    FILTER NOT EXISTS { ?concept xyz:text ?text }
    FILTER NOT EXISTS {
      ?codings ?earlierSlot ?earlier . ?earlier xyz:display ?earlierDisplay .
      FILTER (xsd:integer(STRAFTER(STR(?earlierSlot), "#_")) < xsd:integer(STRAFTER(STR(?codingSlot), "#_")))
    }
    BIND (health:vaccineName AS ?p)
  }
  UNION
  {
    ?resource xyz:vaccineCode ?coded . ?coded xyz:coding ?codings . ?codings ?codingSlot ?coding .
    ?coding xyz:system "http://hl7.org/fhir/sid/cvx" ;
      xyz:code ?code .
    BIND (health:vaccineCode AS ?p)
    BIND (?code AS ?o)
  }
  UNION
  {
    ?resource xyz:occurrenceDateTime ?when .
    BIND (health:administrationDate AS ?p)
    BIND (IF(REGEX(?when, "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"), STRDT(?when, xsd:date),
             IF(REGEX(?when, "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"), STRDT(?when, xsd:dateTime), 1/0)) AS ?o)
  }
  UNION
  {
    ?resource xyz:status ?o .
    BIND (health:status AS ?p)
  }
  UNION
  {
    ?resource xyz:lotNumber ?o .
    BIND (health:lotNumber AS ?p)
  }
  UNION
  {
    ?resource xyz:doseQuantity ?dose . ?dose xyz:value ?amount .
    OPTIONAL { ?dose xyz:unit ?unit }
    BIND (health:doseQuantity AS ?p)
    BIND (IF(BOUND(?unit), CONCAT(?amount, " ", ?unit), ?amount) AS ?o)
  }
  UNION
  {
    ?resource xyz:route ?concept . ?concept xyz:text ?o .
    BIND (health:route AS ?p)
  }
  UNION
  {
    ?resource xyz:route ?concept . ?concept xyz:coding ?codings .
    ?codings ?codingSlot ?coding . ?coding xyz:display ?o .
    FILTER NOT EXISTS { ?concept xyz:text ?text }
    FILTER NOT EXISTS {
      ?codings ?earlierSlot ?earlier . ?earlier xyz:display ?earlierDisplay .
      FILTER (xsd:integer(STRAFTER(STR(?earlierSlot), "#_")) < xsd:integer(STRAFTER(STR(?codingSlot), "#_")))
    }
    BIND (health:route AS ?p)
  }
  UNION
  {
    ?resource xyz:site ?concept . ?concept xyz:text ?o .
    BIND (health:site AS ?p)
  }
  UNION
  {
    ?resource xyz:site ?concept . ?concept xyz:coding ?codings .
    ?codings ?codingSlot ?coding . ?coding xyz:display ?o .
    FILTER NOT EXISTS { ?concept xyz:text ?text }
    FILTER NOT EXISTS {
      ?codings ?earlierSlot ?earlier . ?earlier xyz:display ?earlierDisplay .
      FILTER (xsd:integer(STRAFTER(STR(?earlierSlot), "#_")) < xsd:integer(STRAFTER(STR(?codingSlot), "#_")))
    }
    BIND (health:site AS ?p)
  }
  UNION
  {
    ?resource xyz:note ?notes . ?notes ?noteSlot ?note . ?note xyz:text ?o .
    BIND (health:notes AS ?p)
  }
}
