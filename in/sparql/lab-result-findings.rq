PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:      <http://www.w3.org/ns/shacl#>
PREFIX oa:      <http://www.w3.org/ns/oa#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX fx:      <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:     <http://sparql.xyz/facade-x/data/>
PREFIX bridge:  <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX fhirr4:  <https://ns.cascadeprotocol.org/adapter/fhir-r4/v1-draft#>
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>

# What lab-result.rq leaves behind at a path the source accounting carries for
# another kind, or carries where it holds one value: the end of the period a
# result was performed over, a code from a system other than LOINC, each value
# of a reference range or an interpretation after the first, a number's unit
# code in a system other than UCUM, a comparator on a bound, a number
# lab-result-quantities.rq refuses for its form, its size or its comparator,
# a coded value's code in a system other than SNOMED CT or LOINC, and, from a
# server, each performer's reference where performers name more than one
# Organization, as lab-result-performer.rq reads them.

CONSTRUCT {
  [] a oa:Annotation ;
    oa:hasTarget [
      oa:hasSource bridge:thisRecord ;
      oa:hasSelector [
        a oa:FragmentSelector ;
        dcterms:conformsTo <https://www.rfc-editor.org/rfc/rfc6901> ;
        rdf:value ?pointer
      ]
    ] ;
    oa:hasBody ?gap ;
    oa:motivatedBy oa:classifying ;
    sh:value ?value .
}
WHERE {
  FILTER NOT EXISTS {
    bridge:thisDocument cascade:sourceFormatVersion ?stated .
    FILTER (!STRSTARTS(?stated, "4.0."))
  }
  bridge:thisRecord bridge:selector ?recordSelector .
  ?root a fx:root .
  { ?root xyz:resourceType ?topType . BIND (?root AS ?top) BIND ("" AS ?topStep) }
  UNION
  { ?root xyz:resource ?top . ?top xyz:resourceType ?topType . BIND ("/resource" AS ?topStep) }
  { BIND ("" AS ?containedStep) }
  UNION
  {
    ?top xyz:contained ?containedList .
    ?containedList ?containedSlot ?contained .
    ?contained xyz:resourceType ?containedType .
    BIND (CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?containedSlot), "#_")) - 1)) AS ?containedStep)
  }
  BIND (COALESCE(?contained, ?top) AS ?resource)
  ?resource xyz:resourceType "Observation" .
  ?lab fhirr4:labResultAt ?labPointer .
  FILTER (?labPointer = CONCAT(?recordSelector, ?topStep, ?containedStep))

  {
    ?resource xyz:effectivePeriod ?period . ?period xyz:end ?value .
    BIND ("/effectivePeriod/end" AS ?step)
    BIND (fhirr4:labResultPeriodEnd AS ?gap)
  }
  UNION
  {
    ?resource xyz:code ?concept . ?concept xyz:coding ?codings . ?codings ?codingSlot ?coding .
    ?coding xyz:code ?value .
    FILTER NOT EXISTS { ?coding xyz:system "http://loinc.org" }
    BIND (CONCAT("/code/coding/", STR(xsd:integer(STRAFTER(STR(?codingSlot), "#_")) - 1), "/code") AS ?step)
    BIND (fhirr4:labResultCode AS ?gap)
  }
  UNION
  {
    ?resource xyz:referenceRange ?ranges . ?ranges ?rangeSlot ?range .
    FILTER (?rangeSlot != rdf:_1)
    {
      ?range xyz:text ?value .
      BIND ("/text" AS ?rangeStep)
    }
    UNION
    {
      ?range ?boundMember ?bound . ?bound xyz:value ?value .
      VALUES (?boundMember ?rangeStep) {
        (xyz:low "/low/value")
        (xyz:high "/high/value")
      }
    }
    BIND (CONCAT("/referenceRange/", STR(xsd:integer(STRAFTER(STR(?rangeSlot), "#_")) - 1), ?rangeStep) AS ?step)
    BIND (fhirr4:labResultRangeRepeated AS ?gap)
  }
  UNION
  {
    ?resource xyz:interpretation ?interpretations . ?interpretations ?interpretationSlot ?interpretation .
    FILTER (?interpretationSlot != rdf:_1)
    {
      ?interpretation xyz:text ?value .
      BIND ("/text" AS ?interpretationStep)
    }
    UNION
    {
      ?interpretation xyz:coding ?interpretationCodings .
      ?interpretationCodings ?interpretationCodingSlot ?interpretationCoding .
      ?interpretationCoding xyz:code ?value .
      BIND (CONCAT("/coding/", STR(xsd:integer(STRAFTER(STR(?interpretationCodingSlot), "#_")) - 1), "/code")
            AS ?interpretationStep)
    }
    BIND (CONCAT("/interpretation/", STR(xsd:integer(STRAFTER(STR(?interpretationSlot), "#_")) - 1),
                 ?interpretationStep) AS ?step)
    BIND (fhirr4:labResultInterpretationRepeated AS ?gap)
  }
  UNION
  {
    {
      ?resource xyz:valueQuantity ?quantity .
      BIND ("/valueQuantity" AS ?place) BIND ("value" AS ?held)
    }
    UNION
    {
      ?resource ?valueMember ?valueNode . ?valueNode ?partMember ?quantity .
      VALUES (?valueMember ?partMember ?place ?held) {
        (xyz:valueRatio xyz:numerator "/valueRatio/numerator" "value")
        (xyz:valueRatio xyz:denominator "/valueRatio/denominator" "value")
        (xyz:valueRange xyz:low "/valueRange/low" "bound")
        (xyz:valueRange xyz:high "/valueRange/high" "bound")
      }
    }
    UNION
    {
      ?resource xyz:referenceRange ?quantityRanges . ?quantityRanges ?quantityRangeSlot ?quantityRange .
      ?quantityRange ?boundSide ?quantity .
      VALUES (?boundSide ?side) { (xyz:low "/low") (xyz:high "/high") }
      BIND (CONCAT("/referenceRange/", STR(xsd:integer(STRAFTER(STR(?quantityRangeSlot), "#_")) - 1), ?side) AS ?place)
      BIND ("bound" AS ?held)
    }
    {
      ?quantity xyz:code ?value .
      FILTER NOT EXISTS { ?quantity xyz:system "http://unitsofmeasure.org" }
      BIND ("/code" AS ?suffix)
      BIND (fhirr4:labResultUnitCodeOutsideUcum AS ?quantityGap)
    }
    UNION
    {
      ?quantity xyz:comparator ?value .
      BIND ("/comparator" AS ?suffix)
      BIND (fhirr4:labResultBoundWithComparator AS ?quantityGap)
    }
    UNION
    {
      ?quantity xyz:value ?value .
      BIND ("/value" AS ?suffix)
      BIND (fhirr4:labResultNumberRefused AS ?quantityGap)
      BIND (STR(?value) AS ?number)
      BIND (REPLACE(REPLACE(?number, "^[+-]", ""), "[eE].*$", "") AS ?mantissa)
      BIND (IF(CONTAINS(?mantissa, "."), STRBEFORE(?mantissa, "."), ?mantissa) AS ?whole)
      BIND (STRLEN(?whole) + IF(REGEX(?number, "[eE]"), xsd:integer(REPLACE(?number, "^[^eE]*[eE]", "")), 0) AS ?point)
      FILTER (!REGEX(?number, "^[+-]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)([eE][+-]?[0-9]+)?$")
              || COALESCE(?point + 20 < 0 || ?point - STRLEN(CONCAT(?whole, STRAFTER(?mantissa, "."))) > 20, true))
    }
    BIND (IF(?suffix != "/comparator" || ?held = "bound", ?quantityGap,
             IF(?value IN ("<", "<=", ">=", ">"), 1/0, fhirr4:labResultNumberRefused)) AS ?gap)
    FILTER (BOUND(?gap))
    BIND (CONCAT(?place, ?suffix) AS ?step)
  }
  UNION
  {
    ?resource xyz:valueInteger ?value .
    BIND ("/valueInteger" AS ?step)
    BIND (fhirr4:labResultNumberRefused AS ?gap)
    BIND (STR(?value) AS ?number)
    BIND (REPLACE(REPLACE(?number, "^[+-]", ""), "[eE].*$", "") AS ?mantissa)
    BIND (IF(CONTAINS(?mantissa, "."), STRBEFORE(?mantissa, "."), ?mantissa) AS ?whole)
    BIND (STRLEN(?whole) + IF(REGEX(?number, "[eE]"), xsd:integer(REPLACE(?number, "^[^eE]*[eE]", "")), 0) AS ?point)
    FILTER (!REGEX(?number, "^[+-]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)([eE][+-]?[0-9]+)?$")
            || COALESCE(?point + 20 < 0 || ?point - STRLEN(CONCAT(?whole, STRAFTER(?mantissa, "."))) > 20, true))
  }
  UNION
  {
    ?resource xyz:valueCodeableConcept ?answerConcept . ?answerConcept xyz:coding ?answerCodings .
    ?answerCodings ?answerSlot ?answerCoding .
    ?answerCoding xyz:code ?value .
    FILTER NOT EXISTS {
      ?answerCoding xyz:system ?answerSystem .
      FILTER (?answerSystem IN ("http://snomed.info/sct", "http://loinc.org"))
    }
    BIND (CONCAT("/valueCodeableConcept/coding/", STR(xsd:integer(STRAFTER(STR(?answerSlot), "#_")) - 1), "/code")
          AS ?step)
    BIND (fhirr4:labResultValueCode AS ?gap)
  }
  UNION
  {
    {
      SELECT ?resource (COUNT(DISTINCT ?performerId) AS ?organizations) WHERE {
        bridge:thisDocument cascade:serverBaseUrl ?performerServer .
        ?resource xyz:resourceType "Observation" ;
          xyz:performer ?countedPerformers .
        ?countedPerformers ?countedSlot ?countedPerformer .
        ?countedPerformer xyz:reference ?written .
        BIND (REPLACE(?written, "/_history/[A-Za-z0-9.-]{1,64}$", "") AS ?unversioned)
        BIND (IF(STRSTARTS(?unversioned, CONCAT(?performerServer, "/")), STRAFTER(?unversioned, CONCAT(?performerServer, "/")),
                 ?unversioned) AS ?relative)
        FILTER (REGEX(?relative, "^Organization/[A-Za-z0-9.-]{1,64}$"))
        BIND (STRAFTER(?relative, "Organization/") AS ?performerId)
      } GROUP BY ?resource
    }
    FILTER (?organizations > 1)
    ?resource xyz:performer ?performers .
    ?performers ?performerSlot ?performer .
    ?performer xyz:reference ?value .
    BIND (CONCAT("/performer/", STR(xsd:integer(STRAFTER(STR(?performerSlot), "#_")) - 1), "/reference") AS ?step)
    BIND (fhirr4:performerCarriedOnlyAsOneOrganizationRecord AS ?gap)
  }
  BIND (CONCAT(?topStep, ?containedStep, ?step) AS ?pointer)
}
