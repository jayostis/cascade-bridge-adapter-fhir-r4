PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX fx:       <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:      <http://sparql.xyz/facade-x/data/>
PREFIX bridge:   <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX cascade:  <https://ns.cascadeprotocol.org/cascade#>
PREFIX skos:     <http://www.w3.org/2004/02/skos/core#>
PREFIX void:     <http://rdfs.org/ns/void#>
PREFIX fhirr4:   <https://ns.cascadeprotocol.org/adapter/fhir-r4/v1-draft#>

# Which Observation is a lab result is lab-result-table.rq's to say.
#
# A value is of one of five kinds: a valueQuantity or a valueInteger is a
# quantity, a valueRatio a ratio, a valueRange a range, each number a node
# lab-result-quantities.rq writes; a valueCodeableConcept is coded, its codes
# in SNOMED CT and LOINC as IRIs and its text or first display as the value's
# text; a valueString is text. A value holding a number lab-result-quantities.rq
# refuses is text instead, its numbers as the source wrote them and a
# quantity's unit as its text, so that no number is lost; lab-result-findings.rq
# reports the refused number. A reference range's text is written as
# cascade-cli writes one where the source gives no text for it, and a range
# with one bound as that bound and its comparator, a FHIR range's bounds being
# inclusive; its typed bounds are lab-result-quantities.rq's. A lab result
# states one reference range text and one interpretation, the first of each,
# but every LOINC code its concept carries: the vocabulary takes one test code
# per coding, and a result shares any of them with the same result elsewhere.
# The time a result was issued is not when it was performed, and is not
# carried. A date FHIR writes with less than a day's precision fits no Cascade
# date, and is not carried.

CONSTRUCT {
  ?version cascade:testName ?testName ;
    cascade:testCode ?testCode ;
    cascade:resultValueKind ?valueKind ;
    cascade:resultValue ?resultValue ;
    cascade:resultUnit ?resultUnit ;
    cascade:resultCode ?resultCode ;
    cascade:referenceRange ?referenceRange ;
    cascade:resultInterpretation ?interpretation ;
    cascade:resultClinicallyRelevantTime ?performedDate ;
    cascade:notes ?note ;
    cascade:workflowStatus ?status .
}
WHERE {
  FILTER NOT EXISTS {
    bridge:thisDocument cascade:sourceFormatVersion ?stated .
    FILTER (!STRSTARTS(?stated, "4.0."))
  }
  bridge:thisRecord bridge:selector ?recordSelector .
  ?root a fx:root .
  { ?root xyz:resourceType ?topType . BIND (?root AS ?top) BIND ("" AS ?topStep) }
  UNION
  { ?root xyz:resource ?top . ?top xyz:resourceType ?topType . BIND ("/resource" AS ?topStep) }
  { BIND ("" AS ?containedStep) }
  UNION
  {
    ?top xyz:contained ?containedList .
    ?containedList ?containedSlot ?contained .
    ?contained xyz:resourceType ?containedType .
    BIND (CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?containedSlot), "#_")) - 1)) AS ?containedStep)
  }
  BIND (COALESCE(?contained, ?top) AS ?resource)
  ?resource xyz:resourceType "Observation" .
  BIND (CONCAT(?recordSelector, ?topStep, ?containedStep) AS ?resourcePointer)
  ?lab fhirr4:labResultAt ?resourcePointer .
  BIND (IRI(CONCAT("urn:cascade:version-at:", SHA256(?resourcePointer))) AS ?version)

  OPTIONAL { ?resource xyz:code ?textConcept . ?textConcept xyz:text ?conceptText }
  OPTIONAL {
    ?resource xyz:code ?displayConcept .
    ?displayConcept xyz:coding ?displayCodings .
    ?displayCodings ?displaySlot ?displayCoding .
    ?displayCoding xyz:display ?conceptDisplay .
    FILTER NOT EXISTS {
      ?displayCodings ?earlierSlot ?earlier . ?earlier xyz:display ?earlierDisplay .
      FILTER (xsd:integer(STRAFTER(STR(?earlierSlot), "#_")) < xsd:integer(STRAFTER(STR(?displaySlot), "#_")))
    }
  }
  BIND (COALESCE(?conceptText, ?conceptDisplay) AS ?testName)

  OPTIONAL {
    ?resource xyz:code ?codedConcept .
    ?codedConcept xyz:coding ?codedCodings .
    ?codedCodings ?codedSlot ?codedCoding .
    ?codedCoding xyz:system "http://loinc.org" ;
      xyz:code ?loinc .
    ?codeSystem skos:inScheme fhirr4:codeSystems ;
      cascade:codingSystemUri "http://loinc.org"^^xsd:anyURI ;
      void:uriSpace ?stem .
  }
  BIND (IRI(CONCAT(?stem, ENCODE_FOR_URI(?loinc))) AS ?testCode)

  OPTIONAL { ?resource xyz:valueQuantity ?quantity }
  OPTIONAL { ?resource xyz:valueRatio ?ratio }
  OPTIONAL { ?resource xyz:valueRange ?valueRange }
  OPTIONAL { ?resource xyz:valueCodeableConcept ?codedValue }
  OPTIONAL { ?resource xyz:valueString ?valueString }
  OPTIONAL { ?resource xyz:valueInteger ?valueInteger }
  OPTIONAL { ?resource xyz:valueCodeableConcept ?valueConcept . ?valueConcept xyz:text ?valueText }
  OPTIONAL {
    ?resource xyz:valueCodeableConcept ?valueDisplayConcept .
    ?valueDisplayConcept xyz:coding ?valueCodings .
    ?valueCodings ?valueSlot ?valueCoding .
    ?valueCoding xyz:display ?valueDisplay .
    FILTER NOT EXISTS {
      ?valueCodings ?earlierValueSlot ?earlierValue . ?earlierValue xyz:display ?earlierValueDisplay .
      FILTER (xsd:integer(STRAFTER(STR(?earlierValueSlot), "#_")) < xsd:integer(STRAFTER(STR(?valueSlot), "#_")))
    }
  }
  OPTIONAL {
    ?resource xyz:valueCodeableConcept ?answerConcept .
    ?answerConcept xyz:coding ?answerCodings .
    ?answerCodings ?answerSlot ?answerCoding .
    ?answerCoding xyz:system ?answerSystem ;
      xyz:code ?answer .
    VALUES ?answerScheme { fhirr4:codeSystemSnomedCt fhirr4:codeSystemLoinc }
    ?answerScheme cascade:codingSystemUri ?answerSystemUri ;
      void:uriSpace ?answerStem .
    FILTER (?answerSystem = STR(?answerSystemUri))
  }
  BIND (IRI(CONCAT(?answerStem, ENCODE_FOR_URI(?answer))) AS ?resultCode)
  BIND (EXISTS {
    {
      ?resource xyz:valueQuantity ?refusedQuantity . ?refusedQuantity xyz:value ?refusedWritten .
      OPTIONAL { ?refusedQuantity xyz:comparator ?refusedComparator }
      BIND (false AS ?refusedBound)
    }
    UNION
    {
      ?resource xyz:valueInteger ?refusedWritten .
      BIND (false AS ?refusedBound)
    }
    UNION
    {
      ?resource xyz:valueRatio ?refusedRatio . ?refusedRatio ?refusedPart ?refusedQuantity .
      VALUES ?refusedPart { xyz:numerator xyz:denominator }
      ?refusedQuantity xyz:value ?refusedWritten .
      OPTIONAL { ?refusedQuantity xyz:comparator ?refusedComparator }
      BIND (false AS ?refusedBound)
    }
    UNION
    {
      ?resource xyz:valueRange ?refusedRange . ?refusedRange ?refusedPart ?refusedQuantity .
      VALUES ?refusedPart { xyz:low xyz:high }
      ?refusedQuantity xyz:value ?refusedWritten .
      OPTIONAL { ?refusedQuantity xyz:comparator ?refusedComparator }
      BIND (true AS ?refusedBound)
    }
    BIND (STR(?refusedWritten) AS ?refusedText)
    BIND (REPLACE(REPLACE(?refusedText, "^[+-]", ""), "[eE].*$", "") AS ?refusedMantissa)
    BIND (IF(CONTAINS(?refusedMantissa, "."), STRBEFORE(?refusedMantissa, "."), ?refusedMantissa) AS ?refusedWhole)
    BIND (STRLEN(?refusedWhole)
          + IF(REGEX(?refusedText, "[eE]"), xsd:integer(REPLACE(?refusedText, "^[^eE]*[eE]", "")), 0) AS ?refusedPoint)
    FILTER (!REGEX(?refusedText, "^[+-]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)([eE][+-]?[0-9]+)?$")
            || COALESCE(?refusedPoint + 20 < 0
                        || ?refusedPoint - STRLEN(CONCAT(?refusedWhole, STRAFTER(?refusedMantissa, "."))) > 20, true)
            || (BOUND(?refusedComparator) && (?refusedBound || !(?refusedComparator IN ("<", "<=", ">=", ">")))))
  } AS ?valueRefused)
  OPTIONAL { ?resource xyz:valueQuantity ?writtenQuantity . ?writtenQuantity xyz:value ?quantityValue }
  OPTIONAL { ?resource xyz:valueQuantity ?comparedQuantity . ?comparedQuantity xyz:comparator ?quantityComparator }
  OPTIONAL { ?resource xyz:valueQuantity ?unitQuantity . ?unitQuantity xyz:unit ?quantityUnit }
  OPTIONAL { ?resource xyz:valueQuantity ?codeQuantity . ?codeQuantity xyz:code ?quantityCode }
  OPTIONAL { ?resource xyz:valueRatio ?numeratorRatio . ?numeratorRatio xyz:numerator ?numerator . ?numerator xyz:value ?numeratorValue }
  OPTIONAL { ?resource xyz:valueRatio ?denominatorRatio . ?denominatorRatio xyz:denominator ?denominator . ?denominator xyz:value ?denominatorValue }
  OPTIONAL {
    ?resource xyz:valueRange ?lowValueRange . ?lowValueRange xyz:low ?valueLow . ?valueLow xyz:value ?valueLowValue .
    OPTIONAL { ?valueLow xyz:unit ?valueLowUnit }
  }
  OPTIONAL {
    ?resource xyz:valueRange ?highValueRange . ?highValueRange xyz:high ?valueHigh . ?valueHigh xyz:value ?valueHighValue .
    OPTIONAL { ?valueHigh xyz:unit ?valueHighUnit }
  }
  BIND (IF(BOUND(?valueLowValue) && BOUND(?valueHighValue), CONCAT(STR(?valueLowValue), "-", STR(?valueHighValue)),
           IF(BOUND(?valueLowValue), CONCAT(">=", STR(?valueLowValue)), CONCAT("<=", STR(?valueHighValue)))) AS ?valueBounds)
  BIND (IF(BOUND(?quantity), CONCAT(COALESCE(?quantityComparator, ""), STR(?quantityValue)),
        IF(BOUND(?valueInteger), STR(?valueInteger),
        IF(BOUND(?ratio), CONCAT(COALESCE(STR(?numeratorValue), ""), ":", COALESCE(STR(?denominatorValue), "")),
        IF(BOUND(?valueLowUnit) || BOUND(?valueHighUnit), CONCAT(?valueBounds, " ", COALESCE(?valueLowUnit, ?valueHighUnit)),
           ?valueBounds)))) AS ?refusedValue)
  BIND (IF(?valueRefused, ?refusedValue, COALESCE(?valueString, ?valueText, ?valueDisplay)) AS ?resultValue)
  BIND (IF(?valueRefused && BOUND(?quantity), COALESCE(?quantityUnit, ?quantityCode), 1/0) AS ?resultUnit)
  BIND (IF(?valueRefused, cascade:TextResultValue,
        IF(BOUND(?quantity) || BOUND(?valueInteger), cascade:QuantityResultValue,
        IF(BOUND(?ratio), cascade:RatioResultValue,
        IF(BOUND(?valueRange), cascade:RangeResultValue,
        IF(BOUND(?codedValue), cascade:CodedResultValue,
        IF(BOUND(?valueString), cascade:TextResultValue, 1/0)))))) AS ?valueKind)

  OPTIONAL { ?resource xyz:referenceRange ?ranges . ?ranges rdf:_1 ?range . ?range xyz:text ?rangeText }
  OPTIONAL {
    ?resource xyz:referenceRange ?lowRanges . ?lowRanges rdf:_1 ?lowRange .
    ?lowRange xyz:low ?low . ?low xyz:value ?lowValue .
    OPTIONAL { ?low xyz:unit ?lowUnit }
  }
  OPTIONAL {
    ?resource xyz:referenceRange ?highRanges . ?highRanges rdf:_1 ?highRange .
    ?highRange xyz:high ?high . ?high xyz:value ?highValue .
    OPTIONAL { ?high xyz:unit ?highUnit }
  }
  BIND (IF(BOUND(?lowValue) && BOUND(?highValue), CONCAT(?lowValue, "-", ?highValue),
           IF(BOUND(?lowValue), CONCAT(">=", ?lowValue), CONCAT("<=", ?highValue))) AS ?bounds)
  BIND (COALESCE(?rangeText, IF(BOUND(?lowUnit) || BOUND(?highUnit),
                                CONCAT(?bounds, " ", COALESCE(?lowUnit, ?highUnit)), ?bounds)) AS ?referenceRange)

  OPTIONAL {
    ?resource xyz:interpretation ?interpretations . ?interpretations rdf:_1 ?firstInterpretation .
    ?firstInterpretation xyz:coding ?interpretationCodings . ?interpretationCodings rdf:_1 ?interpretationCoding .
    ?interpretationCoding xyz:code ?interpretationCode .
  }
  OPTIONAL {
    ?resource xyz:interpretation ?textInterpretations . ?textInterpretations rdf:_1 ?textInterpretation .
    ?textInterpretation xyz:text ?interpretationText .
  }
  BIND (COALESCE(?interpretationCode, ?interpretationText) AS ?interpretation)

  OPTIONAL { ?resource xyz:effectiveDateTime ?effective }
  OPTIONAL { ?resource xyz:effectivePeriod ?period . ?period xyz:start ?periodStart }
  OPTIONAL { ?resource xyz:effectiveInstant ?instant }
  BIND (COALESCE(?effective, ?periodStart, ?instant) AS ?performed)
  BIND (IF(REGEX(?performed, "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"), STRDT(?performed, xsd:date),
           IF(REGEX(?performed, "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"), STRDT(?performed, xsd:dateTime), 1/0)) AS ?performedDate)

  OPTIONAL { ?resource xyz:note ?notes . ?notes ?noteSlot ?noteItem . ?noteItem xyz:text ?note }

  OPTIONAL { ?resource xyz:status ?status }
}
