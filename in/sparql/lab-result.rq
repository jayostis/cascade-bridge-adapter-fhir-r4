PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX fx:       <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:      <http://sparql.xyz/facade-x/data/>
PREFIX bridge:   <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX health:   <https://ns.cascadeprotocol.org/health/v1#>
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX fhirr4:   <https://ns.cascadeprotocol.org/adapter/fhir-r4/v1-draft#>

# Which Observation is a lab result is lab-result-table.rq's to say.
#
# A value is written as the source wrote it, a number included, so that two
# sources stating one value state one literal, and a comparator stays in front
# of its number: "<0.01" is not a measured 0.01. A reference range is written
# as cascade-cli writes one where the source gives no text for it, and a range
# with one bound as that bound and its comparator, a FHIR range's bounds being
# inclusive. A lab result states one reference range and one interpretation,
# the first of each. The time a result was issued is not when it was
# performed, and is not carried. A date FHIR writes with less than a day's
# precision fits no Cascade date, and is not carried.

CONSTRUCT {
  ?version health:testName ?testName ;
    health:testCode ?testCode ;
    health:resultValue ?resultValue ;
    health:resultUnit ?resultUnit ;
    health:referenceRange ?referenceRange ;
    health:interpretation ?interpretation ;
    health:performedDate ?performedDate ;
    health:notes ?note ;
    clinical:status ?status .
}
WHERE {
  FILTER NOT EXISTS {
    bridge:thisDocument bridge:sourceFormatVersion ?stated .
    FILTER (!STRSTARTS(?stated, "4.0."))
  }
  bridge:thisRecord bridge:selector ?recordSelector .
  ?root a fx:root .
  { ?root xyz:resourceType ?topType . BIND (?root AS ?top) BIND ("" AS ?topStep) }
  UNION
  { ?root xyz:resource ?top . ?top xyz:resourceType ?topType . BIND ("/resource" AS ?topStep) }
  { BIND ("" AS ?containedStep) }
  UNION
  {
    ?top xyz:contained ?containedList .
    ?containedList ?containedSlot ?contained .
    ?contained xyz:resourceType ?containedType .
    BIND (CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?containedSlot), "#_")) - 1)) AS ?containedStep)
  }
  BIND (COALESCE(?contained, ?top) AS ?resource)
  ?resource xyz:resourceType "Observation" .
  BIND (CONCAT(?recordSelector, ?topStep, ?containedStep) AS ?resourcePointer)
  ?lab fhirr4:labResultAt ?resourcePointer .
  BIND (IRI(CONCAT("urn:cascade:version-at:", SHA256(?resourcePointer))) AS ?version)

  OPTIONAL { ?resource xyz:code ?textConcept . ?textConcept xyz:text ?conceptText }
  OPTIONAL {
    ?resource xyz:code ?displayConcept .
    ?displayConcept xyz:coding ?displayCodings .
    ?displayCodings ?displaySlot ?displayCoding .
    ?displayCoding xyz:display ?conceptDisplay .
    FILTER NOT EXISTS {
      ?displayCodings ?earlierSlot ?earlier . ?earlier xyz:display ?earlierDisplay .
      FILTER (xsd:integer(STRAFTER(STR(?earlierSlot), "#_")) < xsd:integer(STRAFTER(STR(?displaySlot), "#_")))
    }
  }
  BIND (COALESCE(?conceptText, ?conceptDisplay) AS ?testName)

  OPTIONAL {
    ?resource xyz:code ?codedConcept .
    ?codedConcept xyz:coding ?codedCodings .
    ?codedCodings ?codedSlot ?codedCoding .
    ?codedCoding xyz:system "http://loinc.org" ;
      xyz:code ?loinc .
  }
  BIND (IRI(CONCAT("http://loinc.org/rdf/", ENCODE_FOR_URI(?loinc))) AS ?testCode)

  OPTIONAL { ?resource xyz:valueQuantity ?quantity . ?quantity xyz:value ?quantityValue }
  OPTIONAL { ?resource xyz:valueQuantity ?unitQuantity . ?unitQuantity xyz:unit ?quantityUnit }
  OPTIONAL { ?resource xyz:valueQuantity ?codeQuantity . ?codeQuantity xyz:code ?quantityCode }
  OPTIONAL { ?resource xyz:valueQuantity ?comparedQuantity . ?comparedQuantity xyz:comparator ?comparator }
  OPTIONAL { ?resource xyz:valueString ?valueString }
  OPTIONAL { ?resource xyz:valueInteger ?valueInteger }
  OPTIONAL { ?resource xyz:valueCodeableConcept ?valueConcept . ?valueConcept xyz:text ?valueText }
  OPTIONAL {
    ?resource xyz:valueCodeableConcept ?valueDisplayConcept .
    ?valueDisplayConcept xyz:coding ?valueCodings .
    ?valueCodings ?valueSlot ?valueCoding .
    ?valueCoding xyz:display ?valueDisplay .
    FILTER NOT EXISTS {
      ?valueCodings ?earlierValueSlot ?earlierValue . ?earlierValue xyz:display ?earlierValueDisplay .
      FILTER (xsd:integer(STRAFTER(STR(?earlierValueSlot), "#_")) < xsd:integer(STRAFTER(STR(?valueSlot), "#_")))
    }
  }
  BIND (COALESCE(CONCAT(COALESCE(?comparator, ""), ?quantityValue), ?valueString, ?valueInteger, ?valueText, ?valueDisplay) AS ?resultValue)
  BIND (IF(BOUND(?quantityValue), COALESCE(?quantityUnit, ?quantityCode), 1/0) AS ?resultUnit)

  OPTIONAL { ?resource xyz:referenceRange ?ranges . ?ranges rdf:_1 ?range . ?range xyz:text ?rangeText }
  OPTIONAL {
    ?resource xyz:referenceRange ?lowRanges . ?lowRanges rdf:_1 ?lowRange .
    ?lowRange xyz:low ?low . ?low xyz:value ?lowValue .
    OPTIONAL { ?low xyz:unit ?lowUnit }
  }
  OPTIONAL {
    ?resource xyz:referenceRange ?highRanges . ?highRanges rdf:_1 ?highRange .
    ?highRange xyz:high ?high . ?high xyz:value ?highValue .
    OPTIONAL { ?high xyz:unit ?highUnit }
  }
  BIND (IF(BOUND(?lowValue) && BOUND(?highValue), CONCAT(?lowValue, "-", ?highValue),
           IF(BOUND(?lowValue), CONCAT(">=", ?lowValue), CONCAT("<=", ?highValue))) AS ?bounds)
  BIND (COALESCE(?rangeText, IF(BOUND(?lowUnit) || BOUND(?highUnit),
                                CONCAT(?bounds, " ", COALESCE(?lowUnit, ?highUnit)), ?bounds)) AS ?referenceRange)

  OPTIONAL {
    ?resource xyz:interpretation ?interpretations . ?interpretations rdf:_1 ?firstInterpretation .
    ?firstInterpretation xyz:coding ?interpretationCodings . ?interpretationCodings rdf:_1 ?interpretationCoding .
    ?interpretationCoding xyz:code ?interpretationCode .
  }
  OPTIONAL {
    ?resource xyz:interpretation ?textInterpretations . ?textInterpretations rdf:_1 ?textInterpretation .
    ?textInterpretation xyz:text ?interpretationText .
  }
  BIND (COALESCE(?interpretationCode, ?interpretationText) AS ?interpretation)

  OPTIONAL { ?resource xyz:effectiveDateTime ?effective }
  OPTIONAL { ?resource xyz:effectivePeriod ?period . ?period xyz:start ?periodStart }
  OPTIONAL { ?resource xyz:effectiveInstant ?instant }
  BIND (COALESCE(?effective, ?periodStart, ?instant) AS ?performed)
  BIND (IF(REGEX(?performed, "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"), STRDT(?performed, xsd:date),
           IF(REGEX(?performed, "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"), STRDT(?performed, xsd:dateTime), 1/0)) AS ?performedDate)

  OPTIONAL { ?resource xyz:note ?notes . ?notes ?noteSlot ?noteItem . ?noteItem xyz:text ?note }

  OPTIONAL { ?resource xyz:status ?status }
}
