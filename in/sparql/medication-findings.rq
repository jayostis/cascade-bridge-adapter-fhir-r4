PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:      <http://www.w3.org/ns/shacl#>
PREFIX oa:      <http://www.w3.org/ns/oa#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX fx:      <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:     <http://sparql.xyz/facade-x/data/>
PREFIX bridge:  <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX fhirr4:  <https://ns.cascadeprotocol.org/adapter/fhir-r4/v1-draft#>
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>

# What medication.rq and medication-supply-and-dosages.rq leave behind at a
# path the source accounting carries for another kind, or carries where it
# holds one value: a prescribed request's intent outside the eight codes of
# FHIR's medicationrequest-intent, a reference that resolves to no one
# Medication, a note, every coding with no system, a system
# coding-system-table.rq gives no row, or no code, and every NDC that
# medication.rq makes no 11-digit code of, whether the medication's own or the
# referenced Medication's, every dosage text but the first, every dose
# quantity of a dosage after its first, a course of therapy's coding outside
# FHIR's three codes or after the first of them and its text where no coding
# is carried, an expected supply duration in no unit of time, and its
# comparator, a bound the exposure derivation reads no end from, a dose
# quantity's unit code outside UCUM, and a number or a period unit the
# structure of a dosage or the supply states in a form no predicate takes. A
# reference resolves as medication-table.rq says, and a Medication's codes are
# reported only where a reference resolves to it: resource-type-findings.rq
# reports one nothing resolves to. A MedicationDispense states a Medication
# reference, a note and codings as a request does, and nothing else of these;
# medication-dispense-findings.rq reports the rest of a dispense.

CONSTRUCT {
  [] a oa:Annotation ;
    oa:hasTarget [
      oa:hasSource bridge:thisRecord ;
      oa:hasSelector [
        a oa:FragmentSelector ;
        dcterms:conformsTo <https://www.rfc-editor.org/rfc/rfc6901> ;
        rdf:value ?pointer
      ]
    ] ;
    oa:hasBody ?gap ;
    oa:motivatedBy oa:classifying ;
    sh:value ?value .
}
WHERE {
  FILTER NOT EXISTS {
    bridge:thisDocument cascade:sourceFormatVersion ?stated .
    FILTER (!STRSTARTS(?stated, "4.0."))
  }
  bridge:thisRecord bridge:selector ?recordSelector .
  ?root a fx:root .
  { ?root xyz:resourceType ?topType . BIND (?root AS ?top) BIND ("" AS ?topStep) }
  UNION
  { ?root xyz:resource ?top . ?top xyz:resourceType ?topType . BIND ("/resource" AS ?topStep) }
  { BIND ("" AS ?containedStep) }
  UNION
  {
    ?top xyz:contained ?containedList .
    ?containedList ?containedSlot ?contained .
    ?contained xyz:resourceType ?containedType .
    BIND (CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?containedSlot), "#_")) - 1)) AS ?containedStep)
  }
  BIND (COALESCE(?contained, ?top) AS ?resource)
  BIND (CONCAT(?recordSelector, ?topStep, ?containedStep) AS ?resourcePointer)
  ?resource xyz:resourceType ?type .

  {
    ?resource xyz:medicationReference ?reference .
    ?reference xyz:reference ?value .
    BIND ("/medicationReference/reference" AS ?step)
    BIND (fhirr4:medicationReferenceUnresolved AS ?gap)
  }
  UNION
  {
    ?resource xyz:resourceType "MedicationRequest" ;
      xyz:intent ?value .
    FILTER (!(?value IN ("proposal", "plan", "order", "original-order", "reflex-order",
                           "filler-order", "instance-order", "option"))
      && NOT EXISTS { ?resource xyz:reportedReference ?reportedReference }
      && NOT EXISTS { ?resource xyz:reportedBoolean "true" })
    BIND ("/intent" AS ?step)
    BIND (fhirr4:medicationRequestIntentNotMapped AS ?gap)
  }
  UNION
  {
    ?resource xyz:note ?notes . ?notes ?noteSlot ?note . ?note xyz:text ?value .
    BIND (CONCAT("/note/", STR(xsd:integer(STRAFTER(STR(?noteSlot), "#_")) - 1), "/text") AS ?step)
    BIND (fhirr4:medicationNote AS ?gap)
  }
  UNION
  {
    ?resource ?codeMember ?concept .
    VALUES (?codeMember ?codeStep) {
      (xyz:medicationCodeableConcept "/medicationCodeableConcept")
      (xyz:code "/code")
    }
    ?concept xyz:coding ?codings . ?codings ?codingSlot ?coding .
    FILTER (STRSTARTS(STR(?codingSlot), STR(rdf:_)))
    OPTIONAL { ?coding xyz:code ?codeWritten }
    OPTIONAL { ?coding xyz:system ?systemWritten }
    FILTER (BOUND(?codeWritten) || BOUND(?systemWritten))
    OPTIONAL {
      ?systemRow fhirr4:systemWritten ?rowSystem ;
        fhirr4:systemRead ?system .
      FILTER (sameTerm(?rowSystem, ?systemWritten))
    }
    BIND (COALESCE(REPLACE(STR(?codeWritten), "^\\s+|\\s+$", ""), "") AS ?code)
    BIND (IF(!BOUND(?system) || ?code = "", fhirr4:codingNotCarried,
             IF(?system = "http://hl7.org/fhir/sid/ndc"
                  && !REGEX(?code, "^([0-9]{11}|[0-9]{5}-[0-9]{4}-[0-9]{2}|[0-9]{4}-[0-9]{4}-[0-9]{2}|[0-9]{5}-[0-9]{3}-[0-9]{2}|[0-9]{5}-[0-9]{4}-[0-9])$"),
                fhirr4:ndcNotNormalised, 1/0)) AS ?gap)
    FILTER (BOUND(?gap))
    BIND (IF(!BOUND(?systemWritten) || (BOUND(?system) && BOUND(?codeWritten)), "/code", "/system") AS ?part)
    BIND (IF(?part = "/code", ?codeWritten, ?systemWritten) AS ?value)
    BIND (CONCAT(?codeStep, "/coding/", STR(xsd:integer(STRAFTER(STR(?codingSlot), "#_")) - 1), ?part) AS ?step)
  }
  UNION
  {
    ?resource ?dosageMember ?dosages .
    VALUES (?dosageMember ?dosageStep) {
      (xyz:dosage "/dosage/")
      (xyz:dosageInstruction "/dosageInstruction/")
    }
    ?dosages ?dosageSlot ?dosage . ?dosage xyz:text ?value .
    FILTER (?dosageSlot != rdf:_1)
    BIND (CONCAT(?dosageStep, STR(xsd:integer(STRAFTER(STR(?dosageSlot), "#_")) - 1), "/text") AS ?step)
    BIND (fhirr4:medicationDosageRepeated AS ?gap)
  }
  UNION
  {
    ?resource ?laterDosageMember ?laterDosages .
    VALUES (?laterDosageMember ?laterDosageStep) {
      (xyz:dosage "/dosage/")
      (xyz:dosageInstruction "/dosageInstruction/")
    }
    ?laterDosages ?laterDosageSlot ?laterDosage .
    ?laterDosage xyz:doseAndRate ?doseRates . ?doseRates ?doseSlot ?doseRate .
    ?doseRate xyz:doseQuantity ?laterDose . ?laterDose xyz:value ?value .
    FILTER EXISTS {
      ?doseRates ?earlierDoseSlot ?earlierDoseRate . ?earlierDoseRate xyz:doseQuantity ?earlierDose .
      FILTER (xsd:integer(STRAFTER(STR(?earlierDoseSlot), "#_")) < xsd:integer(STRAFTER(STR(?doseSlot), "#_")))
    }
    BIND (CONCAT(?laterDosageStep, STR(xsd:integer(STRAFTER(STR(?laterDosageSlot), "#_")) - 1), "/doseAndRate/",
                 STR(xsd:integer(STRAFTER(STR(?doseSlot), "#_")) - 1), "/doseQuantity/value") AS ?step)
    BIND (fhirr4:dosageElementNotCarried AS ?gap)
  }
  UNION
  {
    ?resource xyz:courseOfTherapyType ?course .
    {
      ?course xyz:coding ?courseCodings . ?courseCodings ?courseSlot ?courseCoding .
      FILTER (STRSTARTS(STR(?courseSlot), STR(rdf:_)))
      ?courseCoding xyz:code ?value .
      FILTER NOT EXISTS {
        ?courseCoding xyz:system "http://terminology.hl7.org/CodeSystem/medicationrequest-course-of-therapy" .
        FILTER (?value IN ("continuous", "acute", "seasonal"))
        FILTER NOT EXISTS {
          ?courseCodings ?earlierCourseSlot ?earlierCourse .
          ?earlierCourse xyz:system "http://terminology.hl7.org/CodeSystem/medicationrequest-course-of-therapy" ;
            xyz:code ?earlierCourseCode .
          FILTER (?earlierCourseCode IN ("continuous", "acute", "seasonal")
            && xsd:integer(STRAFTER(STR(?earlierCourseSlot), "#_")) < xsd:integer(STRAFTER(STR(?courseSlot), "#_")))
        }
      }
      BIND (CONCAT("/courseOfTherapyType/coding/", STR(xsd:integer(STRAFTER(STR(?courseSlot), "#_")) - 1), "/code")
            AS ?step)
    }
    UNION
    {
      ?course xyz:text ?value .
      FILTER NOT EXISTS {
        ?course xyz:coding ?carriedCourseCodings . ?carriedCourseCodings ?carriedCourseSlot ?carriedCourseCoding .
        ?carriedCourseCoding xyz:system "http://terminology.hl7.org/CodeSystem/medicationrequest-course-of-therapy" ;
          xyz:code ?carriedCourse .
        FILTER (?carriedCourse IN ("continuous", "acute", "seasonal"))
      }
      BIND ("/courseOfTherapyType/text" AS ?step)
    }
    BIND (fhirr4:courseOfTherapyTypeNotMapped AS ?gap)
  }
  UNION
  {
    ?resource xyz:dispenseRequest ?durationRequest .
    ?durationRequest xyz:expectedSupplyDuration ?duration .
    FILTER NOT EXISTS {
      ?duration xyz:system "http://unitsofmeasure.org" ;
        xyz:code ?unitOfTime .
      FILTER (?unitOfTime IN ("s", "min", "h", "d", "wk", "mo", "a"))
    }
    OPTIONAL { ?duration xyz:code ?durationCode }
    OPTIONAL { ?duration xyz:unit ?durationUnit }
    OPTIONAL { ?duration xyz:value ?durationValue }
    BIND (COALESCE(?durationCode, ?durationUnit, ?durationValue) AS ?value)
    FILTER (BOUND(?value))
    BIND (CONCAT("/dispenseRequest/expectedSupplyDuration/",
                 IF(BOUND(?durationCode), "code", IF(BOUND(?durationUnit), "unit", "value"))) AS ?step)
    BIND (fhirr4:expectedSupplyDurationNotInUnitOfTime AS ?gap)
  }
  UNION
  {
    ?resource xyz:dispenseRequest ?boundRequest .
    ?boundRequest xyz:expectedSupplyDuration ?boundDuration .
    ?boundDuration xyz:comparator ?value .
    BIND ("/dispenseRequest/expectedSupplyDuration/comparator" AS ?step)
    BIND (fhirr4:expectedSupplyDurationBound AS ?gap)
  }
  UNION
  {
    ?resource ?doseMember ?doseDosages .
    VALUES (?doseMember ?doseStep) {
      (xyz:dosage "/dosage/")
      (xyz:dosageInstruction "/dosageInstruction/")
    }
    ?doseDosages ?doseDosageSlot ?doseDosage .
    ?doseDosage xyz:doseAndRate ?doseRates . ?doseRates ?doseSlot ?doseRate .
    ?doseRate xyz:doseQuantity ?doseQuantity .
    FILTER NOT EXISTS { ?doseQuantity xyz:comparator ?doseComparator }
    FILTER NOT EXISTS {
      ?doseRates ?earlierDoseSlot ?earlierDoseRate . ?earlierDoseRate xyz:doseQuantity ?earlierDose .
      FILTER (xsd:integer(STRAFTER(STR(?earlierDoseSlot), "#_")) < xsd:integer(STRAFTER(STR(?doseSlot), "#_")))
    }
    {
      ?doseQuantity xyz:code ?value .
      FILTER NOT EXISTS { ?doseQuantity xyz:system "http://unitsofmeasure.org" }
      BIND ("code" AS ?doseLeaf)
      BIND (fhirr4:doseUnitCodeOutsideUcum AS ?gap)
    }
    UNION
    {
      ?doseQuantity xyz:value ?value .
      FILTER (!REGEX(STR(?value), "^[+-]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)([eE][+-]?[0-9]+)?$"))
      BIND ("value" AS ?doseLeaf)
      BIND (fhirr4:medicationNumberNotCarried AS ?gap)
    }
    BIND (CONCAT(?doseStep, STR(xsd:integer(STRAFTER(STR(?doseDosageSlot), "#_")) - 1), "/doseAndRate/",
                 STR(xsd:integer(STRAFTER(STR(?doseSlot), "#_")) - 1), "/doseQuantity/", ?doseLeaf) AS ?step)
  }
  UNION
  {
    ?resource ?repeatMember ?repeatDosages .
    VALUES (?repeatMember ?repeatStep) {
      (xyz:dosage "/dosage/")
      (xyz:dosageInstruction "/dosageInstruction/")
    }
    ?repeatDosages ?repeatDosageSlot ?repeatDosage .
    ?repeatDosage xyz:timing ?repeatTiming . ?repeatTiming xyz:repeat ?repeat .
    {
      ?repeat xyz:frequency ?value .
      FILTER (!REGEX(STR(?value), "^[0-9]*[1-9][0-9]*$"))
      BIND ("frequency" AS ?repeatLeaf)
      BIND (fhirr4:medicationNumberNotCarried AS ?gap)
    }
    UNION
    {
      ?repeat xyz:period ?value .
      FILTER (!REGEX(STR(?value), "^[+-]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)([eE][+-]?[0-9]+)?$"))
      BIND ("period" AS ?repeatLeaf)
      BIND (fhirr4:medicationNumberNotCarried AS ?gap)
    }
    UNION
    {
      ?repeat xyz:periodUnit ?value .
      FILTER (!(?value IN ("s", "min", "h", "d", "wk", "mo", "a")))
      BIND ("periodUnit" AS ?repeatLeaf)
      BIND (fhirr4:dosageRepeatPeriodUnitNotCarried AS ?gap)
    }
    BIND (CONCAT(?repeatStep, STR(xsd:integer(STRAFTER(STR(?repeatDosageSlot), "#_")) - 1), "/timing/repeat/", ?repeatLeaf)
          AS ?step)
  }
  UNION
  {
    ?resource xyz:dispenseRequest ?supplyRequest .
    {
      ?supplyRequest xyz:numberOfRepeatsAllowed ?value .
      FILTER (!REGEX(STR(?value), "^[0-9]+$"))
      BIND ("/dispenseRequest/numberOfRepeatsAllowed" AS ?step)
    }
    UNION
    {
      ?supplyRequest xyz:expectedSupplyDuration ?supplyDuration .
      ?supplyDuration xyz:system "http://unitsofmeasure.org" ;
        xyz:code ?supplyUnit ;
        xyz:value ?value .
      FILTER (?supplyUnit IN ("s", "min", "h", "d", "wk", "mo", "a")
        && !REGEX(STR(?value), "^[+-]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)([eE][+-]?[0-9]+)?$"))
      BIND ("/dispenseRequest/expectedSupplyDuration/value" AS ?step)
    }
    BIND (fhirr4:medicationNumberNotCarried AS ?gap)
  }
  FILTER (IF(?type = "Medication",
             STRSTARTS(?step, "/code/") && EXISTS {
               ?resolving fhirr4:medicationReferenceFrom ?from ;
                 fhirr4:medicationReferenceTo ?key ;
                 fhirr4:medicationScope ?scope .
               ?held fhirr4:medicationAt ?resourcePointer ;
                 fhirr4:medicationKey ?key ;
                 fhirr4:medicationScope ?scope .
               FILTER NOT EXISTS {
                 ?rival fhirr4:medicationAt ?rivalPointer ;
                   fhirr4:medicationKey ?key ;
                   fhirr4:medicationScope ?scope .
                 FILTER (?rivalPointer != ?resourcePointer)
               }
             },
             (?type IN ("MedicationRequest", "MedicationStatement")
               || (?type = "MedicationDispense"
                   && ?gap IN (fhirr4:medicationReferenceUnresolved, fhirr4:medicationNote, fhirr4:codingNotCarried,
                               fhirr4:ndcNotNormalised)))
             && !STRSTARTS(?step, "/code/")
             && (?gap != fhirr4:medicationReferenceUnresolved || NOT EXISTS {
               ?resolving fhirr4:medicationReferenceFrom ?resourcePointer ;
                 fhirr4:medicationReferenceTo ?key ;
                 fhirr4:medicationScope ?scope .
               ?held fhirr4:medicationAt ?medicationPointer ;
                 fhirr4:medicationKey ?key ;
                 fhirr4:medicationScope ?scope .
               FILTER NOT EXISTS {
                 ?rival fhirr4:medicationAt ?rivalPointer ;
                   fhirr4:medicationKey ?key ;
                   fhirr4:medicationScope ?scope .
                 FILTER (?rivalPointer != ?medicationPointer)
               }
             })))
  BIND (CONCAT(?topStep, ?containedStep, ?step) AS ?pointer)
}
