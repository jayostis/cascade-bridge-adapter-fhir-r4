PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX fx:       <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:      <http://sparql.xyz/facade-x/data/>
PREFIX bridge:   <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX cascade:  <https://ns.cascadeprotocol.org/cascade#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX void:     <http://rdfs.org/ns/void#>
PREFIX fhirr4:   <https://ns.cascadeprotocol.org/adapter/fhir-r4/v1-draft#>

# A prescription and an entry on a list of what the person takes are one kind,
# told apart by cascade:prescribedOrReported. A MedicationStatement is reported
# use, and so is a MedicationRequest whose reported[x] says it was reported
# rather than ordered: reportedBoolean true, or any reportedReference. Any other
# request is prescribed, and only a prescribed one states its intent, one of
# R4's eight codes as FHIR writes it; a code outside them states none.
#
# A drug named by reference is read from the Medication the reference resolves
# to in the document, as medication-table.rq says. One that resolves to no one
# Medication leaves the reference's display as the name.
#
# A medication states every RxNorm code and every NDC its codings give, every
# code in any other system as a cascade:medicationCodeInOtherSystem literal
# typed by the system, SNOMED CT's among them, and one dosage, the first
# dosage's text; its supply and its dosages' structure are
# medication-supply-and-dosages.rq's. A coding's system is read as
# coding-system-table.rq reads it, and its code trimmed of leading and trailing
# whitespace. An NDC is Cascade's 11-digit code: FHIR's is
# the 10-digit label code with its hyphens, in one of three segmentings, which
# the missing digit tells apart; ten digits with no hyphens, or any other
# value, are no code, and medication-findings.rq reports them. The coding the
# source marked userSelected is the selected code, the first such RxNorm or NDC
# IRI: a code in another system marks nothing.
# Every other value is single, so each is bound beside the others rather than
# in a branch of its own, and a medication stating nothing still states whether
# it was prescribed or reported. A MedicationDispense is a record of its own
# kind, never a medication: its drug, codes and status are read here as a
# request's are, and it states neither whether it was prescribed or reported,
# nor an intent, a dosage or a date of use; medication-dispense.rq reads the
# rest. A date is typed by the precision FHIR wrote it
# to: a year is an xsd:gYear, a year and month an xsd:gYearMonth, a day an
# xsd:date, a time an xsd:dateTime.
# A time written to the minute, as C-CDA on FHIR writes one, is padded to the
# second and keeps a cascade:PaddedDateTime node, <version>#padded- and its
# property's local name, holding what was written.

CONSTRUCT {
  ?version cascade:prescribedOrReported ?prescribedOrReported ;
    cascade:drugName ?drugName ;
    ?codeProperty ?codeIri ;
    cascade:userSelectedCode ?selectedCode ;
    cascade:workflowStatus ?status ;
    cascade:medicationRequestIntent ?requestIntent ;
    cascade:medicationUseStartDate ?startDate ;
    cascade:prescriptionWrittenDate ?writtenDate ;
    cascade:medicationUseEndDate ?endDate ;
    cascade:dosage ?dosage .
  ?version cascade:paddedDateTime ?startDatePadded .
  ?startDatePadded cascade:paddedDateTimeProperty cascade:medicationUseStartDate ;
    cascade:writtenDate ?startDateWritten .
  ?version cascade:paddedDateTime ?authoredDatePadded .
  ?authoredDatePadded cascade:paddedDateTimeProperty cascade:prescriptionWrittenDate ;
    cascade:writtenDate ?authoredDateWritten .
  ?version cascade:paddedDateTime ?endDatePadded .
  ?endDatePadded cascade:paddedDateTimeProperty cascade:medicationUseEndDate ;
    cascade:writtenDate ?endDateWritten .
}
WHERE {
  FILTER NOT EXISTS {
    bridge:thisDocument cascade:sourceFormatVersion ?stated .
    FILTER (!STRSTARTS(?stated, "4.0."))
  }
  bridge:thisRecord bridge:selector ?recordSelector .
  ?root a fx:root .
  { ?root xyz:resourceType ?topType . BIND (?root AS ?top) BIND ("" AS ?topStep) }
  UNION
  { ?root xyz:resource ?top . ?top xyz:resourceType ?topType . BIND ("/resource" AS ?topStep) }
  { BIND ("" AS ?containedStep) }
  UNION
  {
    ?top xyz:contained ?containedList .
    ?containedList ?containedSlot ?contained .
    ?contained xyz:resourceType ?containedType .
    BIND (CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?containedSlot), "#_")) - 1)) AS ?containedStep)
  }
  BIND (COALESCE(?contained, ?top) AS ?resource)
  ?resource xyz:resourceType ?type .
  FILTER (?type IN ("MedicationRequest", "MedicationStatement", "MedicationDispense"))
  BIND (CONCAT(?recordSelector, ?topStep, ?containedStep) AS ?resourcePointer)
  BIND (IRI(CONCAT("urn:cascade:version-at:", SHA256(?resourcePointer))) AS ?version)
  OPTIONAL { ?resource xyz:reportedBoolean ?reportedBoolean }
  OPTIONAL { ?resource xyz:reportedReference ?reportedReference }
  BIND (IF(?type = "MedicationDispense", 1/0,
           IF(?type = "MedicationRequest" && COALESCE(?reportedBoolean, "") != "true" && !BOUND(?reportedReference),
              "prescribed", "reportedUse")) AS ?prescribedOrReported)
  OPTIONAL { ?resource xyz:intent ?statedIntent }
  BIND (IF(?prescribedOrReported = "prescribed" && ?statedIntent IN ("proposal", "plan", "order", "original-order", "reflex-order",
                                                       "filler-order", "instance-order", "option"),
           ?statedIntent, 1/0) AS ?requestIntent)

  OPTIONAL {
    ?reference fhirr4:medicationReferenceFrom ?resourcePointer ;
      fhirr4:medicationReferenceTo ?key ;
      fhirr4:medicationScope ?scope .
    ?held fhirr4:medicationAt ?medicationPointer ;
      fhirr4:medicationKey ?key ;
      fhirr4:medicationScope ?scope .
    FILTER NOT EXISTS {
      ?rival fhirr4:medicationAt ?rivalPointer ;
        fhirr4:medicationKey ?key ;
        fhirr4:medicationScope ?scope .
      FILTER (?rivalPointer != ?medicationPointer)
    }
  }

  OPTIONAL {
    ?resource xyz:medicationCodeableConcept ?textConcept .
    ?textConcept xyz:text ?conceptText .
  }
  OPTIONAL {
    ?resource xyz:medicationCodeableConcept ?displayConcept .
    ?displayConcept xyz:coding ?displayCodings .
    ?displayCodings ?displaySlot ?displayCoding .
    ?displayCoding xyz:display ?conceptDisplay .
    FILTER NOT EXISTS {
      ?displayCodings ?earlierSlot ?earlier . ?earlier xyz:display ?earlierDisplay .
      FILTER (xsd:integer(STRAFTER(STR(?earlierSlot), "#_")) < xsd:integer(STRAFTER(STR(?displaySlot), "#_")))
    }
  }
  OPTIONAL {
    ?nameRow fhirr4:medicationAt ?namePointer ;
      fhirr4:medicationName ?heldName .
    FILTER (?namePointer = ?medicationPointer)
  }
  OPTIONAL {
    ?resource xyz:medicationReference ?displayedReference .
    ?displayedReference xyz:display ?referenceDisplay .
  }
  BIND (COALESCE(?conceptText, ?conceptDisplay, ?heldName, ?referenceDisplay) AS ?drugName)

  OPTIONAL {
    {
      ?resource xyz:medicationCodeableConcept ?codedConcept .
      ?codedConcept xyz:coding ?codedCodings .
      ?codedCodings ?codedSlot ?codedCoding .
      ?codedCoding xyz:system ?codedSystemWritten ;
        xyz:code ?codedWritten .
      OPTIONAL { ?codedCoding xyz:userSelected ?userSelected }
    }
    UNION
    {
      ?codeRow fhirr4:medicationAt ?codePointer ;
        fhirr4:medicationCodeSystem ?codedSystemWritten ;
        fhirr4:medicationCodeValue ?codedWritten .
    }
    FILTER (!BOUND(?codePointer) || ?codePointer = ?medicationPointer)
    ?codedSystemRow fhirr4:systemWritten ?codedSystemWritten ;
      fhirr4:systemRead ?codedSystem .
    BIND (REPLACE(STR(?codedWritten), "^\\s+|\\s+$", "") AS ?codedValue)
    FILTER (?codedValue != "")
    OPTIONAL {
      VALUES (?codedSystem ?listedProperty) {
        ("http://www.nlm.nih.gov/research/umls/rxnorm" cascade:rxNormCode)
        ("http://hl7.org/fhir/sid/ndc" cascade:ndcCode)
      }
      ?codeSystem skos:inScheme fhirr4:codeSystems ;
        cascade:codingSystemUri ?codedSystemUri ;
        void:uriSpace ?stem .
      FILTER (STR(?codedSystemUri) = ?codedSystem)
    }
    BIND (COALESCE(?listedProperty, cascade:medicationCodeInOtherSystem) AS ?codeProperty)
    BIND (IF(?codeProperty = cascade:rxNormCode, ?codedValue,
             IF(REGEX(?codedValue, "^[0-9]{11}$"), ?codedValue,
               IF(REGEX(?codedValue, "^[0-9]{5}-[0-9]{4}-[0-9]{2}$"), REPLACE(?codedValue, "-", ""),
                 IF(REGEX(?codedValue, "^[0-9]{4}-[0-9]{4}-[0-9]{2}$"), CONCAT("0", REPLACE(?codedValue, "-", "")),
                   IF(REGEX(?codedValue, "^[0-9]{5}-[0-9]{3}-[0-9]{2}$"),
                      CONCAT(SUBSTR(?codedValue, 1, 5), "0", SUBSTR(?codedValue, 7, 3), SUBSTR(?codedValue, 11, 2)),
                     IF(REGEX(?codedValue, "^[0-9]{5}-[0-9]{4}-[0-9]$"),
                        CONCAT(SUBSTR(?codedValue, 1, 5), SUBSTR(?codedValue, 7, 4), "0", SUBSTR(?codedValue, 12, 1)),
                       1/0)))))) AS ?codeDigits)
    BIND (IF(BOUND(?listedProperty), IRI(CONCAT(?stem, ENCODE_FOR_URI(?codeDigits))),
             STRDT(?codedValue, IRI(?codedSystem))) AS ?codeIri)
    BIND (IF(STR(?userSelected) = "true" && BOUND(?listedProperty) && BOUND(?codeIri) && NOT EXISTS {
             ?codedCodings ?earlierSlot ?earlier .
             ?earlier xyz:userSelected ?earlierSelected ;
               xyz:system ?earlierSystemWritten ;
               xyz:code ?earlierWritten .
             ?earlierSystemRow fhirr4:systemWritten ?earlierSystemWritten ;
               fhirr4:systemRead ?earlierSystem .
             BIND (REPLACE(STR(?earlierWritten), "^\\s+|\\s+$", "") AS ?earlierValue)
             FILTER (STR(?earlierSelected) = "true"
               && xsd:integer(STRAFTER(STR(?earlierSlot), "#_")) < xsd:integer(STRAFTER(STR(?codedSlot), "#_"))
               && ((?earlierSystem = "http://www.nlm.nih.gov/research/umls/rxnorm" && ?earlierValue != "")
                   || (?earlierSystem = "http://hl7.org/fhir/sid/ndc"
                       && REGEX(?earlierValue, "^([0-9]{11}|[0-9]{5}-[0-9]{4}-[0-9]{2}|[0-9]{4}-[0-9]{4}-[0-9]{2}|[0-9]{5}-[0-9]{3}-[0-9]{2}|[0-9]{5}-[0-9]{4}-[0-9])$"))))
           }, ?codeIri, 1/0) AS ?selectedCode)
  }

  OPTIONAL { ?resource xyz:status ?status }

  OPTIONAL { ?resource xyz:effectiveDateTime ?effective }
  OPTIONAL { ?resource xyz:effectivePeriod ?startPeriod . ?startPeriod xyz:start ?periodStart }
  OPTIONAL { ?resource xyz:authoredOn ?authored }
  BIND (COALESCE(?effective, ?periodStart) AS ?started)
  BIND (IF(REGEX(?started, "^[0-9]{4}$"), STRDT(?started, xsd:gYear),
           IF(REGEX(?started, "^[0-9]{4}-[0-9]{2}$"), STRDT(?started, xsd:gYearMonth),
           IF(REGEX(?started, "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"), STRDT(?started, xsd:date),
           IF(REGEX(?started, "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})?$"), STRDT(CONCAT(SUBSTR(?started, 1, 16), ":00", SUBSTR(?started, 17)), xsd:dateTime),
             IF(REGEX(?started, "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"), STRDT(?started, xsd:dateTime), 1/0))))) AS ?startDate)
  BIND (IF(REGEX(?authored, "^[0-9]{4}$"), STRDT(?authored, xsd:gYear),
           IF(REGEX(?authored, "^[0-9]{4}-[0-9]{2}$"), STRDT(?authored, xsd:gYearMonth),
           IF(REGEX(?authored, "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"), STRDT(?authored, xsd:date),
           IF(REGEX(?authored, "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})?$"), STRDT(CONCAT(SUBSTR(?authored, 1, 16), ":00", SUBSTR(?authored, 17)), xsd:dateTime),
             IF(REGEX(?authored, "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"), STRDT(?authored, xsd:dateTime), 1/0))))) AS ?writtenDate)

  OPTIONAL { ?resource xyz:effectivePeriod ?endPeriod . ?endPeriod xyz:end ?ended }
  BIND (IF(REGEX(?ended, "^[0-9]{4}$"), STRDT(?ended, xsd:gYear),
           IF(REGEX(?ended, "^[0-9]{4}-[0-9]{2}$"), STRDT(?ended, xsd:gYearMonth),
           IF(REGEX(?ended, "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"), STRDT(?ended, xsd:date),
           IF(REGEX(?ended, "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})?$"), STRDT(CONCAT(SUBSTR(?ended, 1, 16), ":00", SUBSTR(?ended, 17)), xsd:dateTime),
             IF(REGEX(?ended, "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"), STRDT(?ended, xsd:dateTime), 1/0))))) AS ?endDate)

  OPTIONAL {
    ?resource ?dosageMember ?dosages .
    FILTER (?dosageMember IN (xyz:dosage, xyz:dosageInstruction) && ?type != "MedicationDispense")
    ?dosages rdf:_1 ?firstDosage .
    ?firstDosage xyz:text ?dosage .
  }
  BIND (IF(REGEX(?started, "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})?$"), ?started, 1/0) AS ?startDateWritten)
  BIND (IF(BOUND(?startDateWritten), IRI(CONCAT(STR(?version), "#padded-medicationUseStartDate")), 1/0) AS ?startDatePadded)
  BIND (IF(REGEX(?authored, "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})?$"), ?authored, 1/0) AS ?authoredDateWritten)
  BIND (IF(BOUND(?authoredDateWritten), IRI(CONCAT(STR(?version), "#padded-prescriptionWrittenDate")), 1/0) AS ?authoredDatePadded)
  BIND (IF(REGEX(?ended, "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})?$"), ?ended, 1/0) AS ?endDateWritten)
  BIND (IF(BOUND(?endDateWritten), IRI(CONCAT(STR(?version), "#padded-medicationUseEndDate")), 1/0) AS ?endDatePadded)
}
