PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX fx:       <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:      <http://sparql.xyz/facade-x/data/>
PREFIX bridge:   <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX cascade:  <https://ns.cascadeprotocol.org/cascade#>
PREFIX fhirr4:   <https://ns.cascadeprotocol.org/adapter/fhir-r4/v1-draft#>

# A report's or a note's text is its first attachment whose text the Bridge
# decodes (bridge:textDecodedFromBase64: inline data of a text/* content type),
# else its narrative's div. HTML, the div and a text/html attachment, loses
# its markup: a tag of a block, a line or a cell (p, div, br, li, tr, td, th,
# h1 to h6, table, thead, tbody, tfoot, ul, ol, dl, dt, dd, pre, blockquote,
# caption) breaks the line, any other tag goes, and the five entities of XML
# and &nbsp; are read; each line's runs of white space become one space, and
# empty lines go. Text of any other text/* type is kept as written, trimmed.
# narrative-findings.rq reports a div that is not the text carried.

CONSTRUCT {
  ?version cascade:narrativeText ?text .
}
WHERE {
  FILTER NOT EXISTS {
    bridge:thisDocument cascade:sourceFormatVersion ?stated .
    FILTER (!STRSTARTS(?stated, "4.0."))
  }
  bridge:thisRecord bridge:selector ?recordSelector .
  ?root a fx:root .
  { ?root xyz:resourceType ?topType . BIND (?root AS ?top) BIND ("" AS ?topStep) }
  UNION
  { ?root xyz:resource ?top . ?top xyz:resourceType ?topType . BIND ("/resource" AS ?topStep) }
  { BIND ("" AS ?containedStep) }
  UNION
  {
    ?top xyz:contained ?containedList .
    ?containedList ?containedSlot ?contained .
    ?contained xyz:resourceType ?containedType .
    BIND (CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?containedSlot), "#_")) - 1)) AS ?containedStep)
  }
  BIND (COALESCE(?contained, ?top) AS ?resource)
  BIND (CONCAT(?recordSelector, ?topStep, ?containedStep) AS ?resourcePointer)
  ?resource xyz:resourceType ?resourceType .
  FILTER (?resourceType = "DiagnosticReport"
          || (?resourceType = "DocumentReference" && EXISTS { ?note fhirr4:noteOrDocumentAt ?resourcePointer }))
  BIND (IRI(CONCAT("urn:cascade:version-at:", SHA256(?resourcePointer))) AS ?version)

  OPTIONAL {
    {
      SELECT ?resource (MIN(?position) AS ?first) WHERE {
        { ?resource xyz:presentedForm ?forms . ?forms ?formSlot ?decoded . BIND (?formSlot AS ?slot) }
        UNION
        { ?resource xyz:content ?contents . ?contents ?contentSlot ?content . ?content xyz:attachment ?decoded .
          BIND (?contentSlot AS ?slot) }
        ?decoded bridge:textDecodedFromBase64 ?anyText .
        BIND (xsd:integer(STRAFTER(STR(?slot), "#_")) AS ?position)
      } GROUP BY ?resource
    }
    { ?resource xyz:presentedForm ?firstForms . ?firstForms ?firstSlot ?firstAttachment }
    UNION
    { ?resource xyz:content ?firstContents . ?firstContents ?firstSlot ?firstContent . ?firstContent xyz:attachment ?firstAttachment }
    FILTER (xsd:integer(STRAFTER(STR(?firstSlot), "#_")) = ?first)
    ?firstAttachment bridge:textDecodedFromBase64 ?decodedText .
    OPTIONAL { ?firstAttachment xyz:contentType ?decodedType }
  }
  OPTIONAL { ?resource xyz:text ?narrative . ?narrative xyz:div ?div }
  BIND (BOUND(?decodedText) && !REGEX(COALESCE(STR(?decodedType), ""), "^\\s*text/html", "i") AS ?plain)
  BIND (IF(BOUND(?decodedText), STR(?decodedText), STR(?div)) AS ?raw)
  BIND (REPLACE(?raw, "<\\s*/?\\s*(p|div|br|li|tr|td|th|h[1-6]|table|thead|tbody|tfoot|ul|ol|dl|dt|dd|pre|blockquote|caption)([\\s/][^>]*)?>", "&#10;", "i")
        AS ?broken)
  BIND (REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(?broken,
          "<[^>]*>", ""), "&lt;", "<"), "&gt;", ">"), "&quot;", "\""), "&apos;", "'"), "&#39;", "'"), "&nbsp;", " "),
          "&#10;", "\n"), "&amp;", "&") AS ?unmarked)
  BIND (REPLACE(REPLACE(REPLACE(?unmarked, "[ \\t\\r ]+", " "), " ?\\n ?", "\n"), "\\n+", "\n") AS ?lines)
  BIND (IF(?plain, REPLACE(?raw, "^\\s+|\\s+$", ""), REPLACE(?lines, "^\\n|\\n$|^ | $", "")) AS ?trimmed)
  BIND (IF(BOUND(?raw) && ?trimmed != "", ?trimmed, 1/0) AS ?text)
}
