PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:      <http://www.w3.org/ns/shacl#>
PREFIX oa:      <http://www.w3.org/ns/oa#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX fx:      <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:     <http://sparql.xyz/facade-x/data/>
PREFIX bridge:  <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX fhirr4:  <https://ns.cascadeprotocol.org/adapter/fhir-r4/v1-draft#>
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>

# What an Observation's components give that no mapping reads. A component's
# code or coded answer given as text with no coding is reported as that text;
# text beside a coding is that coding's label and is not. Every coding's code,
# and a coded answer's display, is reported but for the members that
# variant.rq and variant-interpretation.rq read or variant-findings.rq and
# variant-interpretation-findings.rq report, and the display beside a code that
# is read, which is that code's label: on a variant whose value is Present, the
# code of the LOINC coding of the code of an HGVS, ClinVar or gene component;
# the code of an HGVS component's answer in HGVS's system, and of a ClinVar
# component's answer in any system, with the display of the coding in HGVS's
# system or in ClinVar's; the display of a gene component's answer in either
# system HGNC is written with, and its code where it has no display. On a
# diagnostic implication, the code of the LOINC coding of the classification
# component's code, and of its answer's LOINC coding that is one of the five
# answers, with the display of that coding. So another coding of those
# components, a display beside a code that is not read, and any member of any
# other component or Observation, is reported here. The rest of a component, its quantities, ranges and string, is
# reported by its entries of the source accounting.

CONSTRUCT {
  [] a oa:Annotation ;
    oa:hasTarget [
      oa:hasSource bridge:thisRecord ;
      oa:hasSelector [
        a oa:FragmentSelector ;
        dcterms:conformsTo <https://www.rfc-editor.org/rfc/rfc6901> ;
        rdf:value ?pointer
      ]
    ] ;
    oa:hasBody fhirr4:observationComponentDataNotCarried ;
    oa:motivatedBy oa:classifying ;
    sh:value ?value .
}
WHERE {
  FILTER NOT EXISTS {
    bridge:thisDocument cascade:sourceFormatVersion ?stated .
    FILTER (!STRSTARTS(?stated, "4.0."))
  }
  bridge:thisRecord bridge:selector ?recordSelector .
  ?root a fx:root .
  { ?root xyz:resourceType ?topType . BIND (?root AS ?top) BIND ("" AS ?topStep) }
  UNION
  { ?root xyz:resource ?top . ?top xyz:resourceType ?topType . BIND ("/resource" AS ?topStep) }
  { BIND ("" AS ?containedStep) }
  UNION
  {
    ?top xyz:contained ?containedList .
    ?containedList ?containedSlot ?contained .
    ?contained xyz:resourceType ?containedType .
    BIND (CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?containedSlot), "#_")) - 1)) AS ?containedStep)
  }
  BIND (COALESCE(?contained, ?top) AS ?resource)
  ?resource xyz:resourceType "Observation" .
  BIND (CONCAT(?topStep, ?containedStep) AS ?resourcePointer)
  BIND (CONCAT(?recordSelector, ?resourcePointer) AS ?recordPointer)
  ?resource xyz:component ?components .
  ?components ?componentSlot ?component .
  FILTER (STRSTARTS(STR(?componentSlot), STR(rdf:_)))
  BIND (CONCAT(?resourcePointer, "/component/", STR(xsd:integer(STRAFTER(STR(?componentSlot), "#_")) - 1)) AS ?componentPointer)

  {
    ?component xyz:code ?concept .
    ?concept xyz:text ?value .
    FILTER NOT EXISTS { ?concept xyz:coding ?anyCoding }
    BIND ("/code/text" AS ?step)
  }
  UNION
  {
    ?component xyz:valueCodeableConcept ?concept .
    ?concept xyz:text ?value .
    FILTER NOT EXISTS { ?concept xyz:coding ?anyCoding }
    BIND ("/valueCodeableConcept/text" AS ?step)
  }
  UNION
  {
    {
      ?component xyz:code ?concept .
      BIND ("/code" AS ?conceptStep)
      BIND (xyz:code AS ?member) BIND ("code" AS ?memberName)
    }
    UNION
    {
      ?component xyz:valueCodeableConcept ?concept .
      BIND ("/valueCodeableConcept" AS ?conceptStep)
      BIND (xyz:code AS ?member) BIND ("code" AS ?memberName)
    }
    UNION
    {
      ?component xyz:valueCodeableConcept ?concept .
      BIND ("/valueCodeableConcept" AS ?conceptStep)
      BIND (xyz:display AS ?member) BIND ("display" AS ?memberName)
    }
    ?concept xyz:coding ?codings .
    ?codings ?codingSlot ?coding .
    FILTER (STRSTARTS(STR(?codingSlot), STR(rdf:_)))
    ?coding ?member ?value .
    BIND (CONCAT(?conceptStep, "/coding/", STR(xsd:integer(STRAFTER(STR(?codingSlot), "#_")) - 1), "/",
                 ?memberName) AS ?step)
  }
  BIND (BOUND(?conceptStep) && EXISTS { ?variant fhirr4:variantAt ?recordPointer } AS ?onVariant)
  BIND (BOUND(?conceptStep) && EXISTS { ?interpretation fhirr4:interpretationAt ?recordPointer } AS ?onInterpretation)
  BIND (?onVariant && EXISTS {
         ?component xyz:code ?readConcept . ?readConcept xyz:coding ?readCodings .
         ?readCodings ?readSlot ?readCoding .
         ?readCoding xyz:system "http://loinc.org" ;
           xyz:code "48004-6" .
       } AS ?isHgvs)
  BIND (?onVariant && EXISTS {
         ?component xyz:code ?readConcept . ?readConcept xyz:coding ?readCodings .
         ?readCodings ?readSlot ?readCoding .
         ?readCoding xyz:system "http://loinc.org" ;
           xyz:code "81252-9" .
       } AS ?isClinvar)
  BIND (?onVariant && EXISTS {
         ?component xyz:code ?readConcept . ?readConcept xyz:coding ?readCodings .
         ?readCodings ?readSlot ?readCoding .
         ?readCoding xyz:system "http://loinc.org" ;
           xyz:code "48018-6" .
       } AS ?isGene)
  BIND (?onInterpretation && EXISTS {
         ?component xyz:code ?readConcept . ?readConcept xyz:coding ?readCodings .
         ?readCodings ?readSlot ?readCoding .
         ?readCoding xyz:system "http://loinc.org" ;
           xyz:code "53037-8" .
       } AS ?isClassification)
  FILTER (!BOUND(?conceptStep)
          || !(
               (?conceptStep = "/code"
                && EXISTS { ?coding xyz:system "http://loinc.org" }
                && ((?onVariant && ?value IN ("48004-6", "81252-9", "48018-6"))
                    || (?onInterpretation && ?value = "53037-8")))
               || (?conceptStep = "/valueCodeableConcept" && ?memberName = "code"
                   && ((?isHgvs && EXISTS { ?coding xyz:system "http://varnomen.hgvs.org" })
                       || (?isClinvar && EXISTS { ?coding xyz:system ?anySystem })
                       || (?isGene
                           && EXISTS { ?coding xyz:system ?geneSystem
                                       FILTER (?geneSystem IN ("http://www.genenames.org/geneId", "http://www.genenames.org")) }
                           && NOT EXISTS { ?coding xyz:display ?anyDisplay })
                       || (?isClassification
                           && EXISTS { ?coding xyz:system "http://loinc.org" .
                                       ?answer skos:inScheme fhirr4:acmgClassifications ;
                                         skos:notation ?answerKey .
                                       FILTER (?answerKey = LCASE(REPLACE(STR(?value), "^\\s+|\\s+$", ""))) })))
               || (?conceptStep = "/valueCodeableConcept" && ?memberName = "display"
                   && ((?isGene
                        && EXISTS { ?coding xyz:system ?geneSystem
                                    FILTER (?geneSystem IN ("http://www.genenames.org/geneId", "http://www.genenames.org")) })
                       || (?isHgvs && EXISTS { ?coding xyz:system "http://varnomen.hgvs.org" })
                       || (?isClinvar && EXISTS { ?coding xyz:system "http://www.ncbi.nlm.nih.gov/clinvar" })
                       || (?isClassification
                           && EXISTS { ?coding xyz:system "http://loinc.org" ;
                                         xyz:code ?codeBesideDisplay .
                                       ?answer skos:inScheme fhirr4:acmgClassifications ;
                                         skos:notation ?answerKey .
                                       FILTER (?answerKey = LCASE(REPLACE(STR(?codeBesideDisplay), "^\\s+|\\s+$", ""))) })))
              ))
  FILTER (!BOUND(?value) || ?value != "53034-5")
  BIND (CONCAT(?componentPointer, ?step) AS ?pointer)
}
