PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX oa:      <http://www.w3.org/ns/oa#>
PREFIX foaf:    <http://xmlns.com/foaf/0.1/>
PREFIX org:     <http://www.w3.org/ns/org#>
PREFIX fx:      <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:     <http://sparql.xyz/facade-x/data/>
PREFIX bridge:  <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX fhirr4:  <https://ns.cascadeprotocol.org/adapter/fhir-r4/v1-draft#>

# An Organization a document names as its custodian or an author, as
# organization-table.rq resolves the reference, is a record named by
# cascade-vocabulary's OrganizationNamingRule from its first identifier whose
# system is the NPI's or an OID, its system and value as written; never by its
# id, which only the document gives it. One with no such identifier is no record,
# and the document names nothing in its place. The document names the record in
# each role a reference gives it.
#
# Its version carries its name, every identifier with a value, typed by its
# system where it states one, and each address: its text, or else its first four
# lines, then city, state, postal code and country, one to a line.

CONSTRUCT {
  ?organization a cascade:Organization .
  ?attributing prov:qualifiedAttribution ?attribution .
  ?attribution prov:agent ?organization ;
    prov:hadRole ?role .
  ?version prov:specializationOf ?organization ;
    foaf:name ?name ;
    org:identifier ?identifier ;
    cascade:organizationAddress ?address .
  ?arrival bridge:arrivedAs ?version ;
    oa:hasSelector ?selectorNode .
  ?selectorNode a oa:FragmentSelector ;
    dcterms:conformsTo <https://www.rfc-editor.org/rfc/rfc6901> ;
    rdf:value ?selector .
}
WHERE {
  bridge:thisRecord bridge:selector ?recordSelector .
  bridge:thisDocument bridge:sha256 ?sha256 .
  BIND (IRI(?sha256) AS ?document)
  FILTER NOT EXISTS {
    bridge:thisDocument cascade:sourceFormatVersion ?stated .
    FILTER (!STRSTARTS(?stated, "4.0."))
  }
  ?root a fx:root .
  { ?root xyz:resourceType ?topType . BIND (?root AS ?top) BIND ("" AS ?topStep) }
  UNION
  { ?root xyz:resource ?top . ?top xyz:resourceType ?topType . BIND ("/resource" AS ?topStep) }
  { BIND ("" AS ?containedStep) }
  UNION
  {
    ?top xyz:contained ?containedList .
    ?containedList ?containedSlot ?contained .
    ?contained xyz:resourceType ?containedType .
    BIND (CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?containedSlot), "#_")) - 1)) AS ?containedStep)
  }
  BIND (COALESCE(?contained, ?top) AS ?resource)
  ?resource xyz:resourceType "Organization" .
  BIND (CONCAT(?recordSelector, ?topStep, ?containedStep) AS ?pointer)
  {
    SELECT DISTINCT ?pointer WHERE {
      ?reference fhirr4:organizationReferenceFrom ?from ;
        fhirr4:organizationReferenceTo ?key ;
        fhirr4:organizationScope ?scope .
      ?held fhirr4:organizationAt ?pointer ;
        fhirr4:organizationKey ?key ;
        fhirr4:organizationScope ?scope .
      FILTER NOT EXISTS {
        ?rival fhirr4:organizationAt ?rivalPointer ;
          fhirr4:organizationKey ?key ;
          fhirr4:organizationScope ?scope .
        FILTER (?rivalPointer != ?pointer)
      }
    }
  }
  {
    SELECT ?resource (MIN(?ranked) AS ?first) WHERE {
      ?resource xyz:resourceType "Organization" ;
        xyz:identifier ?identifiers .
      ?identifiers ?identifierSlot ?named .
      ?named xyz:system ?namingSystem ;
        xyz:value ?namingValue .
      FILTER (STRLEN(?namingValue) > 0
              && (?namingSystem = "http://hl7.org/fhir/sid/us-npi" || STRSTARTS(?namingSystem, "urn:oid:")))
      BIND (STRAFTER(STR(?identifierSlot), "#_") AS ?at)
      BIND (CONCAT(SUBSTR("0000000000", STRLEN(?at) + 1), ?at,
                   "|", REPLACE(REPLACE(?namingSystem, "%", "%25"), "\\|", "%7C"),
                   "|", REPLACE(REPLACE(?namingValue, "%", "%25"), "\\|", "%7C")) AS ?ranked)
    } GROUP BY ?resource
  }
  BIND (REPLACE(REPLACE(STRBEFORE(STRAFTER(?first, "|"), "|"), "%7C", "|"), "%25", "%") AS ?input1)
  BIND (REPLACE(REPLACE(STRAFTER(STRAFTER(?first, "|"), "|"), "%7C", "|"), "%25", "%") AS ?input2)
  BIND (SHA256(CONCAT("90c60849-c5ef-4ca6-bfb8-8662bd07d2b5|https://ns.cascadeprotocol.org/cascade#OrganizationNamingRule",
                       "|", REPLACE(REPLACE(?input1, "%", "%25"), "\\|", "%7C"),
                       "|", REPLACE(REPLACE(?input2, "%", "%25"), "\\|", "%7C"),
                       COALESCE(CONCAT("|", REPLACE(REPLACE(?noThirdInput, "%", "%25"), "\\|", "%7C")), ""))) AS ?hash)
  BIND (REPLACE(REPLACE(REPLACE(REPLACE(SUBSTR(?hash, 17, 1), "[048c]", "8"), "[159d]", "9"), "[26ae]", "a"), "[37bf]", "b")
        AS ?variant)
  BIND (IRI(CONCAT("urn:uuid:", SUBSTR(?hash, 1, 8), "-", SUBSTR(?hash, 9, 4), "-8", SUBSTR(?hash, 14, 3), "-", ?variant,
                   SUBSTR(?hash, 18, 3), "-", SUBSTR(?hash, 21, 12))) AS ?organization)
  BIND (IRI(CONCAT("urn:cascade:version-at:", SHA256(?pointer))) AS ?resourceVersion)

  {
    {
      SELECT DISTINCT ?pointer ?role WHERE {
        ?reference fhirr4:organizationReferenceFrom ?from ;
          fhirr4:organizationReferenceTo ?key ;
          fhirr4:organizationScope ?scope ;
          fhirr4:organizationRole ?role .
        ?held fhirr4:organizationAt ?pointer ;
          fhirr4:organizationKey ?key ;
          fhirr4:organizationScope ?scope .
        FILTER NOT EXISTS {
          ?rival fhirr4:organizationAt ?rivalPointer ;
            fhirr4:organizationKey ?key ;
            fhirr4:organizationScope ?scope .
          FILTER (?rivalPointer != ?pointer)
        }
      }
    }
    BIND ("attribution" AS ?branch)
  }
  UNION
  {
    BIND ("arrival" AS ?branch)
  }
  UNION
  {
    ?resource xyz:name ?name .
    FILTER (isLiteral(?name) && STRLEN(?name) > 0)
  }
  UNION
  {
    ?resource xyz:identifier ?identifierList .
    ?identifierList ?identifierAt ?identifierNode .
    ?identifierNode xyz:value ?identifierValue .
    FILTER (STRLEN(?identifierValue) > 0)
    OPTIONAL { ?identifierNode xyz:system ?identifierSystem }
    BIND (IF(BOUND(?identifierSystem), STRDT(?identifierValue, IRI(?identifierSystem)), ?identifierValue) AS ?identifier)
  }
  UNION
  {
    ?resource xyz:address ?addresses .
    ?addresses ?addressAt ?postal .
    OPTIONAL { ?postal xyz:text ?text }
    OPTIONAL { ?postal xyz:line ?lines . ?lines rdf:_1 ?line1 }
    OPTIONAL { ?postal xyz:line ?lines . ?lines rdf:_2 ?line2 }
    OPTIONAL { ?postal xyz:line ?lines . ?lines rdf:_3 ?line3 }
    OPTIONAL { ?postal xyz:line ?lines . ?lines rdf:_4 ?line4 }
    OPTIONAL { ?postal xyz:city ?city }
    OPTIONAL { ?postal xyz:state ?state }
    OPTIONAL { ?postal xyz:postalCode ?postalCode }
    OPTIONAL { ?postal xyz:country ?country }
    BIND (CONCAT(COALESCE(CONCAT("\n", ?line1), ""), COALESCE(CONCAT("\n", ?line2), ""), COALESCE(CONCAT("\n", ?line3), ""),
                 COALESCE(CONCAT("\n", ?line4), ""), COALESCE(CONCAT("\n", ?city), ""), COALESCE(CONCAT("\n", ?state), ""),
                 COALESCE(CONCAT("\n", ?postalCode), ""), COALESCE(CONCAT("\n", ?country), "")) AS ?joined)
    BIND (IF(BOUND(?text) && STRLEN(?text) > 0, ?text, SUBSTR(?joined, 2)) AS ?address)
    FILTER (STRLEN(?address) > 0)
  }
  BIND (IF(?branch = "attribution", ?document, 1/0) AS ?attributing)
  BIND (IF(?branch = "attribution", BNODE(), 1/0) AS ?attribution)
  BIND (IF(COALESCE(?branch, "") != "attribution", ?resourceVersion, 1/0) AS ?version)
  BIND (IF(?branch = "arrival", BNODE(), 1/0) AS ?arrival)
  BIND (IF(?branch = "arrival" && BOUND(?contained), BNODE(), 1/0) AS ?selectorNode)
  BIND (IF(BOUND(?selectorNode), ?pointer, 1/0) AS ?selector)
}
