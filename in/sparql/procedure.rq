PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX fx:       <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:      <http://sparql.xyz/facade-x/data/>
PREFIX skos:     <http://www.w3.org/2004/02/skos/core#>
PREFIX void:     <http://rdfs.org/ns/void#>
PREFIX bridge:   <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX cascade:  <https://ns.cascadeprotocol.org/cascade#>
PREFIX fhirr4:   <https://ns.cascadeprotocol.org/adapter/fhir-r4/v1-draft#>
PREFIX foaf:     <http://xmlns.com/foaf/0.1/>

# Every coding of a procedure's code is carried: one in SNOMED CT as its IRI,
# the first in CPT as its IRI, the vocabulary holding one CPT code, and one in
# any other system, HCPCS, ICD-10-PCS, CDT and LOINC among them, as a
# cascade:procedureCodeInOtherSystem literal typed by the system. A coding's
# system is read as coding-system-table.rq reads it, and its code trimmed of
# leading and trailing whitespace; one with no system, a system no row reads,
# or no code is not carried, nor a later CPT code, and code-findings.rq reports
# each.
# A date is typed by the precision FHIR wrote it to: a year is an xsd:gYear, a
# year and month an xsd:gYearMonth, a day an xsd:date, a time an xsd:dateTime.
# A time written to the minute, as C-CDA on FHIR writes one, is padded to the
# second and keeps a cascade:PaddedDateTime node, <version>#padded- and its
# property's local name, holding what was written.

CONSTRUCT {
  ?version ?p ?o .
  ?version cascade:paddedDateTime ?paddedNode .
  ?paddedNode cascade:paddedDateTimeProperty ?p ;
    cascade:writtenDate ?writtenTime .
}
WHERE {
  FILTER NOT EXISTS {
    bridge:thisDocument cascade:sourceFormatVersion ?stated .
    FILTER (!STRSTARTS(?stated, "4.0."))
  }
  bridge:thisRecord bridge:selector ?recordSelector .
  ?root a fx:root .
  { ?root xyz:resourceType ?topType . BIND (?root AS ?top) BIND ("" AS ?topStep) }
  UNION
  { ?root xyz:resource ?top . ?top xyz:resourceType ?topType . BIND ("/resource" AS ?topStep) }
  { BIND ("" AS ?containedStep) }
  UNION
  {
    ?top xyz:contained ?containedList .
    ?containedList ?containedSlot ?contained .
    ?contained xyz:resourceType ?containedType .
    BIND (CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?containedSlot), "#_")) - 1)) AS ?containedStep)
  }
  BIND (COALESCE(?contained, ?top) AS ?resource)
  ?resource xyz:resourceType "Procedure" .
  BIND (IRI(CONCAT("urn:cascade:version-at:", SHA256(CONCAT(?recordSelector, ?topStep, ?containedStep)))) AS ?version)

  {
    ?resource xyz:code ?concept . ?concept xyz:text ?o .
    BIND (cascade:procedureName AS ?p)
  }
  UNION
  {
    ?resource xyz:code ?concept . ?concept xyz:coding ?codings .
    ?codings ?codingSlot ?coding . ?coding xyz:display ?o .
    FILTER NOT EXISTS { ?concept xyz:text ?text }
    FILTER NOT EXISTS {
      ?codings ?earlierSlot ?earlier . ?earlier xyz:display ?earlierDisplay .
      FILTER (xsd:integer(STRAFTER(STR(?earlierSlot), "#_")) < xsd:integer(STRAFTER(STR(?codingSlot), "#_")))
    }
    BIND (cascade:procedureName AS ?p)
  }
  UNION
  {
    ?resource xyz:code ?coded . ?coded xyz:coding ?codings . ?codings ?codingSlot ?coding .
    ?coding xyz:system ?systemWritten ;
      xyz:code ?codeWritten .
    ?systemRow fhirr4:systemWritten ?systemWritten ;
      fhirr4:systemRead ?system .
    BIND (REPLACE(STR(?codeWritten), "^\\s+|\\s+$", "") AS ?code)
    FILTER (?code != "")
    FILTER (?system != "http://www.ama-assn.org/go/cpt" || NOT EXISTS {
      ?codings ?earlierSlot ?earlier .
      ?earlier xyz:system ?earlierSystemWritten ;
        xyz:code ?earlierWritten .
      ?earlierSystemRow fhirr4:systemWritten ?earlierSystemWritten ;
        fhirr4:systemRead "http://www.ama-assn.org/go/cpt" .
      FILTER (REPLACE(STR(?earlierWritten), "^\\s+|\\s+$", "") != ""
        && xsd:integer(STRAFTER(STR(?earlierSlot), "#_")) < xsd:integer(STRAFTER(STR(?codingSlot), "#_")))
    })
    OPTIONAL {
      VALUES (?system ?listedProperty) {
        ("http://snomed.info/sct" cascade:snomedCode)
        ("http://www.ama-assn.org/go/cpt" cascade:cptCode)
      }
      ?codeSystem skos:inScheme fhirr4:codeSystems ;
        cascade:codingSystemUri ?listedSystem ;
        void:uriSpace ?stem .
      FILTER (STR(?listedSystem) = ?system)
    }
    BIND (COALESCE(?listedProperty, cascade:procedureCodeInOtherSystem) AS ?p)
    BIND (IF(BOUND(?listedProperty), IRI(CONCAT(?stem, ENCODE_FOR_URI(?code))), STRDT(?code, IRI(?system))) AS ?o)
  }
  UNION
  {
    ?resource xyz:performedDateTime ?when .
    BIND (cascade:procedureDate AS ?p)
    BIND (IF(!REGEX(?when, "^(([0-9]{3}[1-9]|[0-9]{2}[1-9]0|[0-9][1-9]00|[1-9]000)(-(0[1-9]|1[0-2])|-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))(T([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9]([.][0-9]+)?)?(Z|[+-]((0[0-9]|1[0-3]):[0-5][0-9]|14:00)))?)?|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29(T([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9]([.][0-9]+)?)?(Z|[+-]((0[0-9]|1[0-3]):[0-5][0-9]|14:00)))?)$"), 1/0,
             IF(STRLEN(?when) = 4, STRDT(?when, xsd:gYear),
             IF(STRLEN(?when) = 7, STRDT(?when, xsd:gYearMonth),
             IF(STRLEN(?when) = 10, STRDT(?when, xsd:date),
                STRDT(CONCAT(SUBSTR(?when, 1, 16), IF(SUBSTR(?when, 17, 1) = ":", "", ":00"), SUBSTR(?when, 17)), xsd:dateTime))))) AS ?o)
    BIND (IF(BOUND(?o) && STRLEN(?when) > 10 && SUBSTR(?when, 17, 1) != ":", ?when, 1/0) AS ?writtenTime)
  }
  UNION
  {
    ?resource xyz:status ?o .
    BIND (cascade:workflowStatus AS ?p)
  }
  BIND (IF(BOUND(?writtenTime), IRI(CONCAT(STR(?version), "#padded-", STRAFTER(STR(?p), "#"))), 1/0) AS ?paddedNode)
}
