PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX prov:     <http://www.w3.org/ns/prov#>
PREFIX pav:      <http://purl.org/pav/>
PREFIX fx:       <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:      <http://sparql.xyz/facade-x/data/>
PREFIX bridge:   <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX rec:      <https://ns.cascadeprotocol.org/records/v1-draft#>
PREFIX cascade:  <https://ns.cascadeprotocol.org/core/v1#>
PREFIX health:   <https://ns.cascadeprotocol.org/health/v1#>
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX fhirr4:   <https://ns.cascadeprotocol.org/adapter/fhir-r4/v1-draft#>

# Names are the naming convention of
# https://github.com/jayostis/cascade-bridge-spec/blob/main/engine/sparql.md#naming-a-record,
# computed as that repository's fixtures/naming/name.rq computes them. A version
# is written as an IRI of its resource's pointer, which each type's mapping
# computes alike, so the content it writes lands on the same version.
#
# A nested group cannot see variables bound outside it, so a group binds a
# step of the pointer and the pointer is joined up after it.

CONSTRUCT {
  ?record a ?class ;
    rec:sourceUrl ?sourceUrl ;
    ?sourceIdPredicate ?resourceId .
  ?version prov:specializationOf ?record ;
    rec:patient ?patient .
  [] bridge:arrivedAs ?version ;
    pav:version ?versionId ;
    pav:lastUpdateOn ?lastUpdated ;
    bridge:selector ?containedSelector .
}
WHERE {
  bridge:thisRecord bridge:selector ?recordSelector .
  bridge:thisDocument bridge:sha256 ?document .
  OPTIONAL { bridge:thisDocument bridge:serverBaseUrl ?server }
  FILTER NOT EXISTS {
    bridge:thisDocument bridge:sourceFormatVersion ?stated .
    FILTER (!STRSTARTS(?stated, "4.0."))
  }

  ?root a fx:root .
  { ?root xyz:resourceType ?topType . BIND (?root AS ?top) BIND ("" AS ?topStep) }
  UNION
  { ?root xyz:resource ?top . ?top xyz:resourceType ?topType . BIND ("/resource" AS ?topStep) }
  OPTIONAL { ?top xyz:id ?topId }
  OPTIONAL { ?root xyz:fullUrl ?fullUrl }

  BIND (BOUND(?topId) && NOT EXISTS {
          ?sameId fhirr4:resourceType ?topType ;
            fhirr4:resourceId ?topId ;
            fhirr4:heldAt ?sameIdSelector .
          FILTER (?sameIdSelector != ?recordSelector)
        } AS ?idUnique)
  BIND (BOUND(?fullUrl) && STRSTARTS(?fullUrl, "urn:uuid:") && NOT EXISTS {
          ?sameUrl fhirr4:fullUrl ?fullUrl ;
            fhirr4:heldAt ?sameUrlSelector .
          FILTER (?sameUrlSelector != ?recordSelector)
        } AS ?urnUnique)
  BIND (IF(BOUND(?topId),
           IF(?idUnique && BOUND(?server), CONCAT(?server, "|", ?topType, "|", ?topId), CONCAT(?document, "|", ?recordSelector)),
           IF(?urnUnique, ?fullUrl, CONCAT(?document, "|", ?recordSelector))) AS ?topInput)
  BIND (IF(BOUND(?topId),
           IF(?idUnique && BOUND(?server), CONCAT(?server, "/", ?topType, "/", ?topId), 1/0),
           IF(?urnUnique, ?fullUrl, 1/0)) AS ?topAddress)
  BIND (SHA256(CONCAT("90c60849-c5ef-4ca6-bfb8-8662bd07d2b5|", ?topInput)) AS ?topHash)
  BIND (REPLACE(REPLACE(REPLACE(REPLACE(SUBSTR(?topHash, 17, 1),
          "[048c]", "8"), "[159d]", "9"), "[26ae]", "a"), "[37bf]", "b") AS ?topVariant)
  BIND (CONCAT("urn:uuid:", SUBSTR(?topHash, 1, 8), "-", SUBSTR(?topHash, 9, 4), "-8", SUBSTR(?topHash, 14, 3),
               "-", ?topVariant, SUBSTR(?topHash, 18, 3), "-", SUBSTR(?topHash, 21, 12)) AS ?topName)

  { BIND ("" AS ?containedStep) }
  UNION
  {
    ?top xyz:contained ?containedList .
    ?containedList ?containedSlot ?contained .
    ?contained xyz:resourceType ?containedType .
    BIND (CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?containedSlot), "#_")) - 1)) AS ?containedStep)
  }
  BIND (COALESCE(?contained, ?top) AS ?resource)
  BIND (CONCAT(?recordSelector, ?topStep, ?containedStep) AS ?resourcePointer)

  ?resource xyz:resourceType ?resourceType .
  VALUES (?resourceType ?class ?sourceIdPredicate) {
    ("AllergyIntolerance" health:AllergyRecord      health:sourceRecordId)
    ("Condition"          health:ConditionRecord    health:sourceRecordId)
    ("Immunization"       health:ImmunizationRecord health:sourceRecordId)
    ("Procedure"          clinical:Procedure        clinical:sourceRecordId)
    ("Patient"            cascade:PatientProfile    cascade:sourceRecordId)
  }
  OPTIONAL { ?resource xyz:id ?resourceId }

  BIND (IF(BOUND(?contained),
           IF(BOUND(?resourceId), CONCAT(?topName, "|", ?resourceId), CONCAT(?document, "|", ?resourcePointer)),
           ?topInput) AS ?input)
  BIND (SHA256(CONCAT("90c60849-c5ef-4ca6-bfb8-8662bd07d2b5|", ?input)) AS ?hash)
  BIND (REPLACE(REPLACE(REPLACE(REPLACE(SUBSTR(?hash, 17, 1),
          "[048c]", "8"), "[159d]", "9"), "[26ae]", "a"), "[37bf]", "b") AS ?variant)
  BIND (IRI(CONCAT("urn:uuid:", SUBSTR(?hash, 1, 8), "-", SUBSTR(?hash, 9, 4), "-8", SUBSTR(?hash, 14, 3),
                   "-", ?variant, SUBSTR(?hash, 18, 3), "-", SUBSTR(?hash, 21, 12))) AS ?record)
  BIND (IRI(CONCAT("urn:cascade:version-at:", SHA256(?resourcePointer))) AS ?version)
  BIND (IF(BOUND(?contained), IF(BOUND(?resourceId), IRI(CONCAT(?topAddress, "#", ?resourceId)), 1/0),
           IRI(?topAddress)) AS ?sourceUrl)
  BIND (IF(BOUND(?contained), ?resourcePointer, 1/0) AS ?containedSelector)

  OPTIONAL { ?resource xyz:meta ?meta . ?meta xyz:versionId ?versionId }
  OPTIONAL { ?resource xyz:meta ?updatedMeta . ?updatedMeta xyz:lastUpdated ?updated }
  BIND (STRDT(?updated, xsd:dateTime) AS ?lastUpdated)

  # The patient a version is about, named as its target is named, in this
  # document or not: by a urn:uuid, by type and id on the record's own server,
  # or by an absolute URL, whose base is normalised as a server's is. A
  # reference relative to a server names nothing where no server is known.
  OPTIONAL {
    ?resource ?patientMember ?patientReference .
    FILTER (?patientMember IN (xyz:patient, xyz:subject))
    ?patientReference xyz:reference ?reference .
  }
  OPTIONAL {
    {
      SELECT ?key (COUNT(DISTINCT ?keySelector) AS ?heldAtKey) (SAMPLE(?keyInput) AS ?inputAtKey)
      WHERE {
        bridge:thisDocument bridge:sha256 ?keyDocument .
        OPTIONAL { bridge:thisDocument bridge:serverBaseUrl ?keyServer }
        ?held fhirr4:heldAt ?keySelector ;
          fhirr4:resourceType "Patient" ;
          fhirr4:fullUrl ?key .
        FILTER (STRSTARTS(?key, "urn:uuid:"))
        OPTIONAL { ?held fhirr4:resourceId ?keyId }
        BIND (BOUND(?keyId) && NOT EXISTS {
                ?sameKeyId fhirr4:resourceType "Patient" ;
                  fhirr4:resourceId ?keyId ;
                  fhirr4:heldAt ?sameKeyIdSelector .
                FILTER (?sameKeyIdSelector != ?keySelector)
              } AS ?keyIdUnique)
        BIND (NOT EXISTS {
                ?sameKeyUrl fhirr4:fullUrl ?key ;
                  fhirr4:heldAt ?sameKeyUrlSelector .
                FILTER (?sameKeyUrlSelector != ?keySelector)
              } AS ?keyUrnUnique)
        BIND (IF(BOUND(?keyId),
                 IF(?keyIdUnique && BOUND(?keyServer), CONCAT(?keyServer, "|Patient|", ?keyId),
                    CONCAT(?keyDocument, "|", ?keySelector)),
                 IF(?keyUrnUnique, ?key, CONCAT(?keyDocument, "|", ?keySelector))) AS ?keyInput)
      }
      GROUP BY ?key
    }
    FILTER (?key = ?reference)
  }
  BIND (IF(BOUND(?heldAtKey), IF(?heldAtKey = 1, ?inputAtKey, 1/0),
        IF(STRSTARTS(?reference, "urn:uuid:"), ?reference,
        IF(REGEX(?reference, "^Patient/[A-Za-z0-9.-]{1,64}$"),
           CONCAT(?server, "|Patient|", STRAFTER(?reference, "Patient/")),
        IF(REGEX(?reference, "^[A-Za-z][A-Za-z0-9+.-]*://[^/]+(/.*)?/Patient/[A-Za-z0-9.-]{1,64}$"),
           CONCAT(LCASE(REPLACE(?reference, "^([^:]+://[^/]+).*$", "$1")),
                  REPLACE(REPLACE(?reference, "^[^:]+://[^/]+", ""), "/+Patient/[^/]+$", ""),
                  "|Patient|", REPLACE(?reference, "^.*/Patient/", "")),
           1/0)))) AS ?patientInput)
  BIND (SHA256(CONCAT("90c60849-c5ef-4ca6-bfb8-8662bd07d2b5|", ?patientInput)) AS ?patientHash)
  BIND (REPLACE(REPLACE(REPLACE(REPLACE(SUBSTR(?patientHash, 17, 1),
          "[048c]", "8"), "[159d]", "9"), "[26ae]", "a"), "[37bf]", "b") AS ?patientVariant)
  BIND (IRI(CONCAT("urn:uuid:", SUBSTR(?patientHash, 1, 8), "-", SUBSTR(?patientHash, 9, 4), "-8",
                   SUBSTR(?patientHash, 14, 3), "-", ?patientVariant, SUBSTR(?patientHash, 18, 3), "-",
                   SUBSTR(?patientHash, 21, 12))) AS ?patient)
}
