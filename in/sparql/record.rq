PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms:  <http://purl.org/dc/terms/>
PREFIX prov:     <http://www.w3.org/ns/prov#>
PREFIX pav:      <http://purl.org/pav/>
PREFIX oa:       <http://www.w3.org/ns/oa#>
PREFIX fx:       <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:      <http://sparql.xyz/facade-x/data/>
PREFIX bridge:   <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX cascade:  <https://ns.cascadeprotocol.org/cascade#>
PREFIX fhirr4:   <https://ns.cascadeprotocol.org/adapter/fhir-r4/v1-draft#>

# A record is named by one of cascade-vocabulary's naming rules, each hashed text
# written exactly as the rule's body in
# https://github.com/jayostis/cascade-vocabulary/tree/main/tests/vectors/naming
# writes it: RecordFromServerNamingRule, RecordFromDocumentNamingRule or
# ContainedRecordNamingRule. Each name picks its rule's text with IF and hashes
# once: a rule body in a UNION branch would not see the bindings outside it.
#
# A version is written as an IRI of its resource's pointer, which each type's
# mapping computes alike, so the content it writes lands on the same version.
# A nested group cannot see variables bound outside it, so a group binds a step
# of the pointer and the pointer is joined up after it.

CONSTRUCT {
  ?record a ?class ;
    cascade:sourceUrl ?sourceUrl ;
    ?sourceIdPredicate ?resourceId .
  ?version prov:specializationOf ?record ;
    cascade:patient ?patient .
  [] bridge:arrivedAs ?version ;
    pav:version ?versionId ;
    pav:lastUpdateOn ?lastUpdated ;
    oa:hasSelector ?containedSelectorNode .
  ?containedSelectorNode a oa:FragmentSelector ;
    dcterms:conformsTo <https://www.rfc-editor.org/rfc/rfc6901> ;
    rdf:value ?containedSelector .
}
WHERE {
  bridge:thisRecord bridge:selector ?recordSelector .
  bridge:thisDocument bridge:sha256 ?document .
  OPTIONAL { bridge:thisDocument cascade:serverBaseUrl ?server }
  FILTER NOT EXISTS {
    bridge:thisDocument cascade:sourceFormatVersion ?stated .
    FILTER (!STRSTARTS(?stated, "4.0."))
  }

  ?root a fx:root .
  { ?root xyz:resourceType ?topType . BIND (?root AS ?top) BIND ("" AS ?topStep) }
  UNION
  { ?root xyz:resource ?top . ?top xyz:resourceType ?topType . BIND ("/resource" AS ?topStep) }
  OPTIONAL { ?root xyz:fullUrl ?fullUrl }
  OPTIONAL { ?top xyz:id ?topId }
  OPTIONAL { ?top xyz:meta ?topMeta . ?topMeta xyz:versionId ?topVersionId . FILTER (STR(?topVersionId) != "") }
  OPTIONAL { ?top xyz:meta ?topUpdatedMeta . ?topUpdatedMeta xyz:lastUpdated ?topUpdated }

  BIND (BOUND(?topId) && BOUND(?server) && !STRSTARTS(COALESCE(?fullUrl, ""), "urn:uuid:") && NOT EXISTS {
          ?sameId fhirr4:resourceId ?sameIdValue ;
            fhirr4:resourceType ?topType ;
            fhirr4:heldAt ?sameIdSelector .
          FILTER (?sameIdValue = ?topId && ?sameIdSelector != ?recordSelector)
        } AS ?fromServer)
  BIND (IF(?fromServer,
           CONCAT("90c60849-c5ef-4ca6-bfb8-8662bd07d2b5|https://ns.cascadeprotocol.org/cascade#RecordFromServerNamingRule",
                  "|", REPLACE(REPLACE(?server, "%", "%25"), "\\|", "%7C"),
                  "|", REPLACE(REPLACE(?topType, "%", "%25"), "\\|", "%7C"),
                  "|", REPLACE(REPLACE(?topId, "%", "%25"), "\\|", "%7C")),
           CONCAT("90c60849-c5ef-4ca6-bfb8-8662bd07d2b5|https://ns.cascadeprotocol.org/cascade#RecordFromDocumentNamingRule",
                  "|", REPLACE(REPLACE(?document, "%", "%25"), "\\|", "%7C"),
                  "|", REPLACE(REPLACE(?recordSelector, "%", "%25"), "\\|", "%7C"))) AS ?topNamed)
  BIND (IF(?fromServer, CONCAT(?server, "/", ?topType, "/", ?topId), 1/0) AS ?topAddress)
  BIND (SHA256(?topNamed) AS ?topHash)
  BIND (REPLACE(REPLACE(REPLACE(REPLACE(SUBSTR(?topHash, 17, 1), "[048c]", "8"), "[159d]", "9"), "[26ae]", "a"), "[37bf]", "b")
        AS ?topVariant)
  BIND (CONCAT("urn:uuid:", SUBSTR(?topHash, 1, 8), "-", SUBSTR(?topHash, 9, 4), "-8", SUBSTR(?topHash, 14, 3), "-", ?topVariant,
               SUBSTR(?topHash, 18, 3), "-", SUBSTR(?topHash, 21, 12)) AS ?topName)

  { BIND ("" AS ?containedStep) }
  UNION
  {
    ?top xyz:contained ?containedList .
    ?containedList ?containedSlot ?contained .
    ?contained xyz:resourceType ?containedType .
    BIND (CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?containedSlot), "#_")) - 1)) AS ?containedStep)
  }
  BIND (COALESCE(?contained, ?top) AS ?resource)
  BIND (CONCAT(?recordSelector, ?topStep, ?containedStep) AS ?resourcePointer)

  ?resource xyz:resourceType ?resourceType .
  VALUES (?resourceType ?class ?sourceIdPredicate) {
    ("AllergyIntolerance"  cascade:AllergyOrIntolerance            cascade:sourceRecordId)
    ("Condition"           cascade:ProblemOrDiagnosis              cascade:sourceRecordId)
    ("Immunization"        cascade:Vaccination                     cascade:sourceRecordId)
    ("Procedure"           cascade:MedicalProcedure                cascade:sourceRecordId)
    ("Patient"             cascade:PatientProfile                  cascade:sourceRecordId)
    ("MedicationRequest"   cascade:PrescribedOrReportedMedication  cascade:sourceRecordId)
    ("MedicationStatement" cascade:PrescribedOrReportedMedication  cascade:sourceRecordId)
    ("Observation"         cascade:LaboratoryTestResult            cascade:sourceRecordId)
    ("Observation"         cascade:GeneticVariantFinding           UNDEF)
    ("Observation"         cascade:VariantInterpretation           UNDEF)
    ("DiagnosticReport"    cascade:DiagnosticReport                cascade:sourceRecordId)
    ("DocumentReference"   cascade:ClinicalNoteOrDocument          cascade:sourceRecordId)
    ("MedicationDispense"  cascade:MedicationDispense              cascade:sourceRecordId)
  }
  FILTER ((?resourceType != "Observation" && ?resourceType != "DocumentReference")
          || (?class = cascade:ClinicalNoteOrDocument && EXISTS { ?note fhirr4:noteOrDocumentAt ?resourcePointer })
          || (?class = cascade:LaboratoryTestResult && EXISTS { ?lab fhirr4:labResultAt ?resourcePointer })
          || (?class = cascade:GeneticVariantFinding && EXISTS { ?variantRow fhirr4:variantAt ?resourcePointer })
          || (?class = cascade:VariantInterpretation && EXISTS { ?interpretationRow fhirr4:interpretationAt ?resourcePointer }))
  OPTIONAL { ?resource xyz:id ?resourceId }

  BIND (IF(BOUND(?contained),
           IF(BOUND(?resourceId),
              CONCAT("90c60849-c5ef-4ca6-bfb8-8662bd07d2b5|https://ns.cascadeprotocol.org/cascade#ContainedRecordNamingRule",
                     "|", REPLACE(REPLACE(?topName, "%", "%25"), "\\|", "%7C"),
                     "|", REPLACE(REPLACE(COALESCE(?topVersionId, ?topUpdated, ""), "%", "%25"), "\\|", "%7C"),
                     "|", REPLACE(REPLACE(?resourceId, "%", "%25"), "\\|", "%7C")),
              CONCAT("90c60849-c5ef-4ca6-bfb8-8662bd07d2b5|https://ns.cascadeprotocol.org/cascade#RecordFromDocumentNamingRule",
                     "|", REPLACE(REPLACE(?document, "%", "%25"), "\\|", "%7C"),
                     "|", REPLACE(REPLACE(?resourcePointer, "%", "%25"), "\\|", "%7C"))),
           ?topNamed) AS ?named)
  BIND (SHA256(?named) AS ?hash)
  BIND (REPLACE(REPLACE(REPLACE(REPLACE(SUBSTR(?hash, 17, 1), "[048c]", "8"), "[159d]", "9"), "[26ae]", "a"), "[37bf]", "b")
        AS ?variant)
  BIND (IRI(CONCAT("urn:uuid:", SUBSTR(?hash, 1, 8), "-", SUBSTR(?hash, 9, 4), "-8", SUBSTR(?hash, 14, 3), "-", ?variant,
                   SUBSTR(?hash, 18, 3), "-", SUBSTR(?hash, 21, 12))) AS ?record)
  BIND (IRI(CONCAT("urn:cascade:version-at:", SHA256(?resourcePointer))) AS ?version)
  BIND (IF(BOUND(?contained), IF(BOUND(?resourceId), IRI(CONCAT(?topAddress, "#", ?resourceId)), 1/0),
           IRI(?topAddress)) AS ?sourceUrl)
  BIND (IF(BOUND(?contained), ?resourcePointer, 1/0) AS ?containedSelector)
  BIND (IF(BOUND(?contained), BNODE(), 1/0) AS ?containedSelectorNode)

  OPTIONAL { ?resource xyz:meta ?meta . ?meta xyz:versionId ?versionId }
  OPTIONAL { ?resource xyz:meta ?updatedMeta . ?updatedMeta xyz:lastUpdated ?updated }
  BIND (STRDT(?updated, xsd:dateTime) AS ?lastUpdated)

  # The patient a version is about, named as its target is named: a Patient
  # this document holds under the reference's urn:uuid as that record is named,
  # by type and id on the record's own server, or by type and id on the server
  # an absolute URL names, its scheme and host in lower case and its scheme's
  # default port dropped. A reference relative to a server names nothing where
  # no server is known, nor when it is made from an entry whose fullUrl is a
  # urn:uuid or to an entry held under one, which FHIR gives no meaning; a
  # urn:uuid this document does not hold names nothing,
  # and neither does an absolute URL whose base is not a plain scheme, host,
  # port and path: patient-reference-findings.rq reports those.
  OPTIONAL {
    ?resource ?patientMember ?patientReference .
    FILTER (?patientMember IN (xyz:patient, xyz:subject))
    ?patientReference xyz:reference ?reference .
  }
  OPTIONAL {
    {
      SELECT ?key (COUNT(DISTINCT ?keySelector) AS ?heldAtKey) (SAMPLE(?keyNamed) AS ?namedAtKey)
      WHERE {
        bridge:thisDocument bridge:sha256 ?keyDocument .
        ?held fhirr4:heldAt ?keySelector ;
          fhirr4:resourceType "Patient" ;
          fhirr4:fullUrl ?key .
        FILTER (STRSTARTS(?key, "urn:uuid:"))
        BIND (CONCAT("90c60849-c5ef-4ca6-bfb8-8662bd07d2b5|https://ns.cascadeprotocol.org/cascade#RecordFromDocumentNamingRule",
                     "|", REPLACE(REPLACE(?keyDocument, "%", "%25"), "\\|", "%7C"),
                     "|", REPLACE(REPLACE(?keySelector, "%", "%25"), "\\|", "%7C")) AS ?keyNamed)
      }
      GROUP BY ?key
    }
    FILTER (?key = ?reference)
  }
  BIND (REPLACE(?reference, "/_history/[A-Za-z0-9.-]{1,64}$", "") AS ?referenceWithoutVersion)
  BIND (IF(REGEX(?referenceWithoutVersion, "^[A-Za-z][A-Za-z0-9+.-]*://[^/]+(/.*)?/Patient/[A-Za-z0-9.-]{1,64}$"),
           REPLACE(?referenceWithoutVersion, "/+Patient/[A-Za-z0-9.-]{1,64}$", ""), 1/0) AS ?patientBase)
  BIND (REPLACE(?patientBase, "^[^:]+://(\\[[^\\]]*\\]|[^/:]*)(:([0-9]*))?(/.*)?$", "$3") AS ?patientPort)
  BIND (REGEX(?patientBase, "^[A-Za-z][A-Za-z0-9+.-]*://([A-Za-z0-9._~!$&'()*+,;=-]+|\\[[0-9A-Fa-f:.]+\\])(:[0-9]*)?(/[A-Za-z0-9._~!$&'()*+,;=:@-]*)*$")
        && !REGEX(?patientBase, "/\\.\\.?(/|$)")
        && (!REGEX(?patientBase, "^[^:]+://\\[") || REGEX(REPLACE(REPLACE(?patientBase, "^[^:]+://\\[([^\\]]*)\\].*$", "$1"),
                                                          ":((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])$", ":0:0"),
                                                  "^(([0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|([0-9A-Fa-f]{1,4}:){1,7}:|([0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|([0-9A-Fa-f]{1,4}:){1,5}(:[0-9A-Fa-f]{1,4}){1,2}|([0-9A-Fa-f]{1,4}:){1,4}(:[0-9A-Fa-f]{1,4}){1,3}|([0-9A-Fa-f]{1,4}:){1,3}(:[0-9A-Fa-f]{1,4}){1,4}|([0-9A-Fa-f]{1,4}:){1,2}(:[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(:[0-9A-Fa-f]{1,4}){1,6}|:((:[0-9A-Fa-f]{1,4}){1,7}|:))$"))
        && STRLEN(REPLACE(?patientPort, "^0+", "")) <= 5
        && (?patientPort = "" || xsd:integer(?patientPort) <= 65535) AS ?patientBaseAccepted)
  BIND (LCASE(STRBEFORE(?patientBase, "://")) AS ?patientScheme)
  BIND (IF(?patientPort = "", "", STR(xsd:integer(?patientPort))) AS ?patientPortNumber)
  BIND (REGEX(?referenceWithoutVersion, "^Patient/[A-Za-z0-9.-]{1,64}$") AS ?patientRelative)
  BIND (?patientRelative && (STRSTARTS(COALESCE(?fullUrl, ""), "urn:uuid:") || EXISTS {
          ?urnPatient fhirr4:resourceType "Patient" ;
            fhirr4:resourceId ?urnPatientId ;
            fhirr4:fullUrl ?urnPatientUrl .
          FILTER (STRSTARTS(?urnPatientUrl, "urn:uuid:") && ?urnPatientId = STRAFTER(?referenceWithoutVersion, "Patient/"))
        }) AS ?patientRelativeUndefined)
  BIND (IF(?patientRelative, IF(?patientRelativeUndefined, 1/0, ?server),
        IF(?patientBaseAccepted,
           CONCAT(?patientScheme, "://", LCASE(REPLACE(?patientBase, "^[^:]+://(\\[[^\\]]*\\]|[^/:]*).*$", "$1")),
                  IF(?patientPortNumber = "" || (?patientScheme = "https" && ?patientPortNumber = "443")
                     || (?patientScheme = "http" && ?patientPortNumber = "80"), "", CONCAT(":", ?patientPortNumber)),
                  REPLACE(?patientBase, "^[^:]+://(\\[[^\\]]*\\]|[^/:]*)(:[0-9]*)?", "")),
           1/0)) AS ?patientServer)
  BIND (REPLACE(?referenceWithoutVersion, "^.*Patient/", "") AS ?patientId)
  BIND (IF(BOUND(?heldAtKey), IF(?heldAtKey = 1, ?namedAtKey, 1/0),
           CONCAT("90c60849-c5ef-4ca6-bfb8-8662bd07d2b5|https://ns.cascadeprotocol.org/cascade#RecordFromServerNamingRule",
                  "|", REPLACE(REPLACE(?patientServer, "%", "%25"), "\\|", "%7C"),
                  "|", REPLACE(REPLACE("Patient", "%", "%25"), "\\|", "%7C"),
                  "|", REPLACE(REPLACE(?patientId, "%", "%25"), "\\|", "%7C"))) AS ?patientNamed)
  BIND (SHA256(?patientNamed) AS ?patientHash)
  BIND (REPLACE(REPLACE(REPLACE(REPLACE(SUBSTR(?patientHash, 17, 1), "[048c]", "8"), "[159d]", "9"), "[26ae]", "a"), "[37bf]", "b")
        AS ?patientVariant)
  BIND (IRI(CONCAT("urn:uuid:", SUBSTR(?patientHash, 1, 8), "-", SUBSTR(?patientHash, 9, 4), "-8", SUBSTR(?patientHash, 14, 3), "-",
                   ?patientVariant, SUBSTR(?patientHash, 18, 3), "-", SUBSTR(?patientHash, 21, 12))) AS ?patient)
}
