PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:      <http://www.w3.org/ns/oa#>
PREFIX sh:      <http://www.w3.org/ns/shacl#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX fx:      <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:     <http://sparql.xyz/facade-x/data/>
PREFIX bridge:  <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX fhirr4:  <https://ns.cascadeprotocol.org/adapter/fhir-r4/v1-draft#>

# What note-or-document.rq and attachments.rq leave behind: a DocumentReference
# whose content is a C-CDA document, at the format code
# note-or-document-table.rq reads it by, the code as its value; and a report's
# or a note's attachment whose content is not read, at its data or, given by
# URL only, at its URL, its content type as its value: any but text/plain or
# text/html data the Bridge decodes; a text attachment after the first
# narrative-text.rq carries, at its data; and, of a report or a note from a
# server, each performer's or author's reference where they name more than one
# Organization, as report-and-note-performer.rq reads them and
# lab-result-findings.rq reports a lab result's.

CONSTRUCT {
  [] a oa:Annotation ;
    oa:hasTarget [
      oa:hasSource bridge:thisRecord ;
      oa:hasSelector [
        a oa:FragmentSelector ;
        dcterms:conformsTo <https://www.rfc-editor.org/rfc/rfc6901> ;
        rdf:value ?pointer
      ]
    ] ;
    oa:hasBody ?gap ;
    oa:motivatedBy oa:classifying ;
    sh:value ?value .
}
WHERE {
  FILTER NOT EXISTS {
    bridge:thisDocument cascade:sourceFormatVersion ?stated .
    FILTER (!STRSTARTS(?stated, "4.0."))
  }
  bridge:thisRecord bridge:selector ?recordSelector .
  ?root a fx:root .
  { ?root xyz:resourceType ?topType . BIND (?root AS ?top) BIND ("" AS ?topStep) }
  UNION
  { ?root xyz:resource ?top . ?top xyz:resourceType ?topType . BIND ("/resource" AS ?topStep) }
  { BIND ("" AS ?containedStep) }
  UNION
  {
    ?top xyz:contained ?containedList .
    ?containedList ?containedSlot ?contained .
    ?contained xyz:resourceType ?containedType .
    BIND (CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?containedSlot), "#_")) - 1)) AS ?containedStep)
  }
  BIND (COALESCE(?contained, ?top) AS ?resource)
  BIND (CONCAT(?topStep, ?containedStep) AS ?resourceStep)
  BIND (CONCAT(?recordSelector, ?resourceStep) AS ?resourcePointer)
  ?resource xyz:resourceType ?resourceType .
  FILTER (?resourceType IN ("DiagnosticReport", "DocumentReference"))
  BIND (EXISTS { ?note fhirr4:noteOrDocumentAt ?resourcePointer } AS ?isNote)
  {
    ?resource xyz:content ?ccdaContents . ?ccdaContents ?slot ?ccdaContent .
    ?ccdaContent xyz:format ?format .
    ?format xyz:system ?formatSystem ;
      xyz:code ?value .
    FILTER (?formatSystem IN ("http://terminology.hl7.org/CodeSystem/v3-HL7DocumentFormatCodes",
                              "http://ihe.net/fhir/ValueSet/IHE.FormatCode.codesystem",
                              "http://ihe.net/fhir/ihe.formatcode.fhir/CodeSystem/formatcode")
            && STRSTARTS(STR(?value), "urn:hl7-org:sdwg:ccda-structuredBody:"))
    BIND ("/content/" AS ?list)
    BIND ("/format/code" AS ?part)
    BIND (fhirr4:documentReferenceToCcdaDocument AS ?gap)
  }
  UNION
  {
    { ?resource xyz:presentedForm ?forms . ?forms ?slot ?attachment . BIND ("/presentedForm/" AS ?list) BIND ("" AS ?within) }
    UNION
    { ?resource xyz:content ?contents . ?contents ?slot ?content . ?content xyz:attachment ?attachment .
      BIND ("/content/" AS ?list) BIND ("/attachment" AS ?within) }
    { ?attachment xyz:data ?given . BIND ("/data" AS ?member) }
    UNION
    { ?attachment xyz:url ?given . FILTER NOT EXISTS { ?attachment xyz:data ?inline } BIND ("/url" AS ?member) }
    FILTER NOT EXISTS {
      ?attachment bridge:textDecodedFromBase64 ?decoded ;
        xyz:contentType ?readType .
      FILTER (REGEX(STR(?readType), "^\\s*text/(plain|html)\\s*(;.*)?$", "i"))
    }
    OPTIONAL { ?attachment xyz:contentType ?contentType }
    BIND (?contentType AS ?value)
    BIND (CONCAT(?within, ?member) AS ?part)
    BIND (fhirr4:attachmentDataNotRead AS ?gap)
  }
  UNION
  {
    {
      SELECT ?resource (MIN(?position) AS ?first) WHERE {
        { ?resource xyz:presentedForm ?firstForms . ?firstForms ?firstSlot ?readable }
        UNION
        { ?resource xyz:content ?firstContents . ?firstContents ?firstSlot ?firstContent . ?firstContent xyz:attachment ?readable }
        ?readable bridge:textDecodedFromBase64 ?firstText ;
          xyz:contentType ?firstType .
        BIND (REGEX(STR(?firstType), "^\\s*text/html\\s*(;.*)?$", "i") AS ?firstHtml)
        FILTER ((?firstHtml || REGEX(STR(?firstType), "^\\s*text/plain\\s*(;.*)?$", "i"))
                && REGEX(IF(?firstHtml, REPLACE(STR(?firstText), "<[^>]*>|&nbsp;|&#160;|&#[xX][aA]0;", ""), STR(?firstText)), "\\S"))
        BIND (xsd:integer(STRAFTER(STR(?firstSlot), "#_")) AS ?position)
      } GROUP BY ?resource
    }
    { ?resource xyz:presentedForm ?laterForms . ?laterForms ?slot ?later . BIND ("/presentedForm/" AS ?list) BIND ("/data" AS ?part) }
    UNION
    { ?resource xyz:content ?laterContents . ?laterContents ?slot ?laterContent . ?laterContent xyz:attachment ?later .
      BIND ("/content/" AS ?list) BIND ("/attachment/data" AS ?part) }
    FILTER (xsd:integer(STRAFTER(STR(?slot), "#_")) > ?first)
    ?later bridge:textDecodedFromBase64 ?laterText ;
      xyz:contentType ?value .
    BIND (REGEX(STR(?value), "^\\s*text/html\\s*(;.*)?$", "i") AS ?laterHtml)
    FILTER ((?laterHtml || REGEX(STR(?value), "^\\s*text/plain\\s*(;.*)?$", "i"))
            && REGEX(IF(?laterHtml, REPLACE(STR(?laterText), "<[^>]*>|&nbsp;|&#160;|&#[xX][aA]0;", ""), STR(?laterText)), "\\S"))
    BIND (fhirr4:textAttachmentNotCarried AS ?gap)
  }
  UNION
  {
    {
      SELECT ?resource (COUNT(DISTINCT ?performerId) AS ?organizations) WHERE {
        bridge:thisDocument cascade:serverBaseUrl ?performerServer .
        { ?resource xyz:resourceType "DiagnosticReport" ; xyz:performer ?countedPerformers }
        UNION
        { ?resource xyz:resourceType "DocumentReference" ; xyz:author ?countedPerformers }
        ?countedPerformers ?countedSlot ?countedPerformer .
        ?countedPerformer xyz:reference ?written .
        BIND (REPLACE(?written, "/_history/[A-Za-z0-9.-]{1,64}$", "") AS ?unversioned)
        BIND (IF(STRSTARTS(?unversioned, CONCAT(?performerServer, "/")), STRAFTER(?unversioned, CONCAT(?performerServer, "/")),
                 ?unversioned) AS ?relative)
        FILTER (REGEX(?relative, "^Organization/[A-Za-z0-9.-]{1,64}$"))
        BIND (STRAFTER(?relative, "Organization/") AS ?performerId)
      } GROUP BY ?resource
    }
    FILTER (?organizations > 1)
    { ?resource xyz:performer ?performers . BIND ("/performer/" AS ?list) }
    UNION
    { ?resource xyz:author ?performers . BIND ("/author/" AS ?list) }
    ?performers ?slot ?performer .
    ?performer xyz:reference ?value .
    BIND ("/reference" AS ?part)
    BIND (fhirr4:performerCarriedOnlyAsOneOrganizationRecord AS ?gap)
  }
  FILTER (?gap = fhirr4:documentReferenceToCcdaDocument || ?resourceType = "DiagnosticReport" || ?isNote)
  BIND (CONCAT(?resourceStep, ?list, STR(xsd:integer(STRAFTER(STR(?slot), "#_")) - 1), ?part) AS ?pointer)
}
