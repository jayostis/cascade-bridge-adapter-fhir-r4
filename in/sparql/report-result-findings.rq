PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX obo:      <http://purl.obolibrary.org/obo/>
PREFIX oa:       <http://www.w3.org/ns/oa#>
PREFIX sh:       <http://www.w3.org/ns/shacl#>
PREFIX dcterms:  <http://purl.org/dc/terms/>
PREFIX fx:       <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:      <http://sparql.xyz/facade-x/data/>
PREFIX bridge:   <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX cascade:  <https://ns.cascadeprotocol.org/cascade#>
PREFIX fhirr4:   <https://ns.cascadeprotocol.org/adapter/fhir-r4/v1-draft#>

# Each result of a report that names no record, as report-results.rq resolves
# it, at its reference, the reference as its value.

CONSTRUCT {
  [] a oa:Annotation ;
    oa:hasTarget [
      oa:hasSource bridge:thisRecord ;
      oa:hasSelector [
        a oa:FragmentSelector ;
        dcterms:conformsTo <https://www.rfc-editor.org/rfc/rfc6901> ;
        rdf:value ?pointer
      ]
    ] ;
    oa:hasBody fhirr4:reportResultNotNamed ;
    oa:motivatedBy oa:classifying ;
    sh:value ?written .
}
WHERE {
  FILTER NOT EXISTS {
    bridge:thisDocument cascade:sourceFormatVersion ?stated .
    FILTER (!STRSTARTS(?stated, "4.0."))
  }
  bridge:thisRecord bridge:selector ?recordSelector .
  bridge:thisDocument bridge:sha256 ?document .
  OPTIONAL { bridge:thisDocument cascade:serverBaseUrl ?server }
  ?root a fx:root .
  OPTIONAL { ?root xyz:fullUrl ?fullUrl }
  { ?root xyz:resourceType ?topType . BIND (?root AS ?top) BIND ("" AS ?topStep) }
  UNION
  { ?root xyz:resource ?top . ?top xyz:resourceType ?topType . BIND ("/resource" AS ?topStep) }
  { BIND ("" AS ?containedStep) }
  UNION
  {
    ?top xyz:contained ?containedList .
    ?containedList ?containedSlot ?contained .
    ?contained xyz:resourceType ?containedType .
    BIND (CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?containedSlot), "#_")) - 1)) AS ?containedStep)
  }
  BIND (COALESCE(?contained, ?top) AS ?resource)
  ?resource xyz:resourceType "DiagnosticReport" ;
    xyz:result ?results .
  ?results ?resultSlot ?result .
  ?result xyz:reference ?written .
  BIND (CONCAT(?recordSelector, ?topStep, ?containedStep) AS ?resourcePointer)
  OPTIONAL {
    ?top xyz:contained ?targetList .
    ?targetList ?targetSlot ?targetResource .
    ?targetResource xyz:id ?targetId .
    FILTER (CONCAT("#", STR(?targetId)) = ?written)
  }
  BIND (IF(BOUND(?targetSlot),
           CONCAT(?recordSelector, ?topStep, "/contained/", STR(xsd:integer(STRAFTER(STR(?targetSlot), "#_")) - 1)), 1/0)
        AS ?containedTarget)
  BIND (REPLACE(?written, "/_history/[A-Za-z0-9.-]{1,64}$", "") AS ?unversioned)
  BIND (IF(BOUND(?server) && STRSTARTS(?unversioned, CONCAT(?server, "/")), STRAFTER(?unversioned, CONCAT(?server, "/")),
           ?unversioned) AS ?relative)
  OPTIONAL {
    {
      SELECT ?key (COUNT(DISTINCT ?keySelector) AS ?heldAtKey) (SAMPLE(?keySelector) AS ?heldSelector)
      WHERE {
        ?held fhirr4:heldAt ?keySelector ;
          fhirr4:fullUrl ?key .
        FILTER (STRSTARTS(?key, "urn:uuid:"))
      }
      GROUP BY ?key
    }
    FILTER (?key = ?written)
  }
  BIND (IF(BOUND(?heldAtKey), IF(?heldAtKey = 1, CONCAT(?heldSelector, "/resource"), 1/0),
           IF(BOUND(?server) && !STRSTARTS(COALESCE(?fullUrl, ""), "urn:uuid:")
              && REGEX(?relative, "^Observation/[A-Za-z0-9.-]{1,64}$"), "", 1/0)) AS ?target)
  BIND (STRAFTER(?relative, "Observation/") AS ?resultId)
  BIND (IF(BOUND(?containedTarget),
           EXISTS { ?containedLab fhirr4:labResultAt ?containedTarget }
           || EXISTS { ?containedVariant fhirr4:variantAt ?containedTarget }
           || EXISTS { ?containedInterpretation fhirr4:interpretationAt ?containedTarget },
        BOUND(?target) && IF(?target != "",
             EXISTS { ?lab fhirr4:labResultAt ?target } || EXISTS { ?variantRow fhirr4:variantAt ?target }
             || EXISTS { ?interpretationRow fhirr4:interpretationAt ?target },
             NOT EXISTS {
               ?urnHeld fhirr4:resourceType "Observation" ;
                 fhirr4:resourceId ?urnId ;
                 fhirr4:fullUrl ?urnUrl .
               FILTER (STRSTARTS(?urnUrl, "urn:uuid:") && ?urnId = ?resultId)
             }
             && NOT EXISTS {
               ?onceHeld fhirr4:resourceType "Observation" ;
                 fhirr4:resourceId ?onceId ;
                 fhirr4:heldAt ?onceAt .
               ?twiceHeld fhirr4:resourceType "Observation" ;
                 fhirr4:resourceId ?twiceId ;
                 fhirr4:heldAt ?twiceAt .
               FILTER (?onceId = ?resultId && ?twiceId = ?resultId && ?onceAt != ?twiceAt)
             }
             && NOT EXISTS {
               ?sameHeld fhirr4:resourceType "Observation" ;
                 fhirr4:resourceId ?sameId ;
                 fhirr4:heldAt ?sameAt .
               FILTER (?sameId = ?resultId)
               FILTER NOT EXISTS {
                 { ?sameRow fhirr4:labResultAt ?samePointer }
                 UNION
                 { ?sameRow fhirr4:variantAt ?samePointer }
                 UNION
                 { ?sameRow fhirr4:interpretationAt ?samePointer }
                 FILTER (?samePointer = CONCAT(?sameAt, "/resource"))
               }
             })) AS ?namesRecord)
  FILTER (!?namesRecord)
  BIND (CONCAT(?topStep, ?containedStep, "/result/", STR(xsd:integer(STRAFTER(STR(?resultSlot), "#_")) - 1), "/reference")
        AS ?pointer)
}
