PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:      <http://www.w3.org/ns/shacl#>
PREFIX oa:      <http://www.w3.org/ns/oa#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX fx:      <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:     <http://sparql.xyz/facade-x/data/>
PREFIX bridge:  <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX fhirr4:  <https://ns.cascadeprotocol.org/adapter/fhir-r4/v1-draft#>
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>

# An Observation is reported by observation-findings.rq, and a DocumentReference
# that makes no record by report-and-note-findings.rq. A Medication is read
# through the medication whose reference resolves to it, as medication-table.rq
# says, so only one no reference resolves to is reported; an Organization is
# read where it is from a server, or where a document's custodian or author, or a
# Diagnostic Implication's performer, resolves to it, as organization-table.rq
# says, and has an identifier organization.rq names it by, so only another is
# reported.

CONSTRUCT {
  [] a oa:Annotation ;
    oa:hasTarget [
      oa:hasSource bridge:thisRecord ;
      oa:hasSelector [
        a oa:FragmentSelector ;
        dcterms:conformsTo <https://www.rfc-editor.org/rfc/rfc6901> ;
        rdf:value ?pointer
      ]
    ] ;
    oa:hasBody fhirr4:resourceTypeNotMapped ;
    oa:motivatedBy oa:classifying ;
    sh:value ?value .
}
WHERE {
  FILTER NOT EXISTS {
    bridge:thisDocument cascade:sourceFormatVersion ?stated .
    FILTER (!STRSTARTS(?stated, "4.0."))
  }
  bridge:thisRecord bridge:selector ?recordSelector .
  ?root a fx:root .
  { ?root xyz:resourceType ?topType . BIND (?root AS ?top) BIND ("" AS ?topStep) }
  UNION
  { ?root xyz:resource ?top . ?top xyz:resourceType ?topType . BIND ("/resource" AS ?topStep) }
  { BIND ("" AS ?containedStep) }
  UNION
  {
    ?top xyz:contained ?containedList .
    ?containedList ?containedSlot ?contained .
    ?contained xyz:resourceType ?containedType .
    BIND (CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?containedSlot), "#_")) - 1)) AS ?containedStep)
  }
  BIND (COALESCE(?contained, ?top) AS ?resource)
  BIND (CONCAT(?topStep, ?containedStep) AS ?resourcePointer)
  ?resource xyz:resourceType ?value .
  FILTER (?value NOT IN ("AllergyIntolerance", "Condition", "Immunization", "Procedure", "Patient",
                        "MedicationRequest", "MedicationStatement", "Observation",
                        "DiagnosticReport", "DocumentReference"))
  BIND (CONCAT(?recordSelector, ?resourcePointer) AS ?medicationPointer)
  FILTER (?value != "Medication" || NOT EXISTS {
    ?resolving fhirr4:medicationReferenceFrom ?from ;
      fhirr4:medicationReferenceTo ?key ;
      fhirr4:medicationScope ?scope .
    ?held fhirr4:medicationAt ?medicationPointer ;
      fhirr4:medicationKey ?key ;
      fhirr4:medicationScope ?scope .
    FILTER NOT EXISTS {
      ?rival fhirr4:medicationAt ?rivalPointer ;
        fhirr4:medicationKey ?key ;
        fhirr4:medicationScope ?scope .
      FILTER (?rivalPointer != ?medicationPointer)
    }
  })
  FILTER (?value != "Organization" || NOT EXISTS {
    ?serverOrganization fhirr4:organizationAt ?medicationPointer ;
      fhirr4:organizationIdOnServer ?organizationId .
  } && (NOT EXISTS {
    ?organizationReference fhirr4:organizationReferenceFrom ?organizationFrom ;
      fhirr4:organizationReferenceTo ?organizationKey ;
      fhirr4:organizationScope ?organizationScope .
    ?heldOrganization fhirr4:organizationAt ?medicationPointer ;
      fhirr4:organizationKey ?organizationKey ;
      fhirr4:organizationScope ?organizationScope .
    FILTER NOT EXISTS {
      ?rivalOrganization fhirr4:organizationAt ?rivalOrganizationPointer ;
        fhirr4:organizationKey ?organizationKey ;
        fhirr4:organizationScope ?organizationScope .
      FILTER (?rivalOrganizationPointer != ?medicationPointer)
    }
  } || NOT EXISTS {
    ?namedOrganization fhirr4:organizationAt ?medicationPointer ;
      fhirr4:organizationIdentifierSystem ?organizationIdentifierSystem .
  }))
  BIND (CONCAT(?resourcePointer, "/resourceType") AS ?pointer)
}
