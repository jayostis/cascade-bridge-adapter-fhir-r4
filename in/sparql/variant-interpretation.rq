PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:     <http://www.w3.org/2004/02/skos/core#>
PREFIX fx:       <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:      <http://sparql.xyz/facade-x/data/>
PREFIX bridge:   <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX cascade:  <https://ns.cascadeprotocol.org/cascade#>
PREFIX fhirr4:   <https://ns.cascadeprotocol.org/adapter/fhir-r4/v1-draft#>

# Which Observation is a diagnostic implication is
# variant-interpretation-table.rq's to say.
#
# The classification is the LOINC answer of the classification component, mapped
# by vocab/fhir-acmg-classifications.ttl, and is carried only where the
# interpretation states one classification. The day is that of the source's own
# clock, as written: issued, else the effective time, and none where the time
# has less than a day's precision.
#
# The variant is the record of the one Observation derivedFrom names, named as
# record.rq names a record from the reference, in this document or not; a
# urn:uuid this document does not hold, an absolute URL whose base
# record.rq refuses, and a reference of the form Observation/<id> made from
# an entry whose fullUrl is a urn:uuid or to an entry held under one, which
# FHIR gives no meaning, name none. A
# reference to a record of this document must be to a variant; the
# interpretation is a record without a link, and variant-interpretation-
# findings.rq reports it, where derivedFrom names no variant, more than one, or
# anything else beside one. A reference that is not to an Observation, and a
# reference to a contained resource, are not read.

CONSTRUCT {
  ?version cascade:acmgClassification ?classification ;
    cascade:variantInterpreted ?variantRecord ;
    cascade:interpretedDate ?interpretedDate ;
    cascade:workflowStatus ?status .
}
WHERE {
  FILTER NOT EXISTS {
    bridge:thisDocument cascade:sourceFormatVersion ?stated .
    FILTER (!STRSTARTS(?stated, "4.0."))
  }
  bridge:thisRecord bridge:selector ?recordSelector .
  ?root a fx:root .
  { ?root xyz:resourceType ?topType . BIND (?root AS ?top) BIND ("" AS ?topStep) }
  UNION
  { ?root xyz:resource ?top . ?top xyz:resourceType ?topType . BIND ("/resource" AS ?topStep) }
  { BIND ("" AS ?containedStep) }
  UNION
  {
    ?top xyz:contained ?containedList .
    ?containedList ?containedSlot ?contained .
    ?contained xyz:resourceType ?containedType .
    BIND (CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?containedSlot), "#_")) - 1)) AS ?containedStep)
  }
  BIND (COALESCE(?contained, ?top) AS ?resource)
  ?resource xyz:resourceType "Observation" .
  BIND (CONCAT(?recordSelector, ?topStep, ?containedStep) AS ?resourcePointer)
  ?interpretation fhirr4:interpretationAt ?resourcePointer .
  BIND (IRI(CONCAT("urn:cascade:version-at:", SHA256(?resourcePointer))) AS ?version)

  OPTIONAL {
    {
      SELECT ?resource (COUNT(DISTINCT ?mapped) AS ?classDistinct) (MIN(?mapped) AS ?classSole)
      WHERE {
        ?resource xyz:component ?classComponents .
        ?classComponents ?classComponentSlot ?classComponent .
        ?classComponent xyz:code ?classConcept . ?classConcept xyz:coding ?classCodings .
        ?classCodings ?classCodingSlot ?classCoding .
        ?classCoding xyz:system "http://loinc.org" ;
          xyz:code "53037-8" .
        ?classComponent xyz:valueCodeableConcept ?classValue . ?classValue xyz:coding ?classValueCodings .
        ?classValueCodings ?classValueSlot ?classValueCoding .
        ?classValueCoding xyz:system "http://loinc.org" ;
          xyz:code ?classWritten .
        BIND (LCASE(REPLACE(STR(?classWritten), "^\\s+|\\s+$", "")) AS ?classKey)
        ?answer skos:inScheme fhirr4:acmgClassifications ;
          skos:notation ?classKey ;
          skos:exactMatch ?mapped .
      }
      GROUP BY ?resource
    }
    FILTER (?classDistinct = 1)
    BIND (?classSole AS ?classification)
  }

  OPTIONAL { ?resource xyz:issued ?issued }
  OPTIONAL { ?resource xyz:effectiveDateTime ?effective }
  OPTIONAL { ?resource xyz:effectivePeriod ?period . ?period xyz:start ?periodStart }
  OPTIONAL { ?resource xyz:effectiveInstant ?instant }
  BIND (COALESCE(?issued, ?effective, ?periodStart, ?instant) AS ?interpreted)
  BIND (IF(REGEX(?interpreted, "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T|$)"),
           STRDT(SUBSTR(?interpreted, 1, 10), xsd:date), 1/0) AS ?interpretedDate)

  OPTIONAL {
    {
      SELECT ?resource
             (COUNT(DISTINCT ?variantInput) AS ?variantTargets)
             (COUNT(DISTINCT ?otherTarget) AS ?otherTargets)
             (MIN(?variantInput) AS ?soleInput)
      WHERE {
        bridge:thisDocument bridge:sha256 ?document .
        OPTIONAL { bridge:thisDocument cascade:serverBaseUrl ?server }
        ?resource xyz:derivedFrom ?derivedFrom .
        ?derivedFrom ?derivedSlot ?derivedItem .
        ?derivedItem xyz:reference ?reference .

        OPTIONAL {
          ?held fhirr4:fullUrl ?reference ;
            fhirr4:heldAt ?heldSelector ;
            fhirr4:resourceType ?heldType .
          FILTER (STRSTARTS(?reference, "urn:uuid:"))
        }
        BIND (STRSTARTS(?reference, "urn:uuid:") AS ?isUrn)
        BIND (BOUND(?heldSelector) && EXISTS {
                ?otherHeld fhirr4:fullUrl ?reference ;
                  fhirr4:heldAt ?otherHeldSelector .
                FILTER (?otherHeldSelector != ?heldSelector)
              } AS ?ambiguous)
        BIND (BOUND(?heldSelector) && ?heldType = "Observation" && EXISTS {
                ?heldVariant fhirr4:variantAt ?heldPointer .
                FILTER (?heldPointer = ?heldSelector || ?heldPointer = CONCAT(?heldSelector, "/resource"))
              } AS ?heldIsVariant)
        BIND (CONCAT("90c60849-c5ef-4ca6-bfb8-8662bd07d2b5|https://ns.cascadeprotocol.org/cascade#RecordFromDocumentNamingRule",
                     "|", REPLACE(REPLACE(?document, "%", "%25"), "\\|", "%7C"),
                     "|", REPLACE(REPLACE(?heldSelector, "%", "%25"), "\\|", "%7C")) AS ?heldInput)

        BIND (REPLACE(?reference, "/_history/[A-Za-z0-9.-]{1,64}$", "") AS ?bare)
        BIND (REGEX(?bare, "^Observation/[A-Za-z0-9.-]{1,64}$") AS ?isRelative)
        BIND (REGEX(?bare, "^[A-Za-z][A-Za-z0-9+.-]*://[^/]+(/.*)?/Observation/[A-Za-z0-9.-]{1,64}$") AS ?isAbsolute)
        BIND (IF(?isAbsolute, REPLACE(?bare, "/+Observation/[A-Za-z0-9.-]{1,64}$", ""), 1/0) AS ?base)
        BIND (REPLACE(?base, "^[^:]+://(\\[[^\\]]*\\]|[^/:]*)(:([0-9]*))?(/.*)?$", "$3") AS ?port)
        BIND (REGEX(?base, "^[A-Za-z][A-Za-z0-9+.-]*://([A-Za-z0-9._~!$&'()*+,;=-]+|\\[[0-9A-Fa-f:.]+\\])(:[0-9]*)?(/[A-Za-z0-9._~!$&'()*+,;=:@-]*)*$")
              && !REGEX(?base, "/\\.\\.?(/|$)")
        && (!REGEX(?base, "^[^:]+://\\[") || REGEX(REPLACE(REPLACE(?base, "^[^:]+://\\[([^\\]]*)\\].*$", "$1"),
                                                          ":((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])$", ":0:0"),
                                                  "^(([0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|([0-9A-Fa-f]{1,4}:){1,7}:|([0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|([0-9A-Fa-f]{1,4}:){1,5}(:[0-9A-Fa-f]{1,4}){1,2}|([0-9A-Fa-f]{1,4}:){1,4}(:[0-9A-Fa-f]{1,4}){1,3}|([0-9A-Fa-f]{1,4}:){1,3}(:[0-9A-Fa-f]{1,4}){1,4}|([0-9A-Fa-f]{1,4}:){1,2}(:[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(:[0-9A-Fa-f]{1,4}){1,6}|:((:[0-9A-Fa-f]{1,4}){1,7}|:))$"))
              && STRLEN(REPLACE(?port, "^0+", "")) <= 5
              && (?port = "" || xsd:integer(?port) <= 65535) AS ?baseAccepted)
        BIND (LCASE(STRBEFORE(?base, "://")) AS ?scheme)
        BIND (IF(?port = "", "", STR(xsd:integer(?port))) AS ?portNumber)
        BIND (IF(?isRelative, ?server,
                 IF(?baseAccepted,
                    CONCAT(?scheme, "://", LCASE(REPLACE(?base, "^[^:]+://(\\[[^\\]]*\\]|[^/:]*).*$", "$1")),
                           IF(?portNumber = "" || (?scheme = "https" && ?portNumber = "443")
                              || (?scheme = "http" && ?portNumber = "80"), "", CONCAT(":", ?portNumber)),
                           REPLACE(?base, "^[^:]+://(\\[[^\\]]*\\]|[^/:]*)(:[0-9]*)?", "")),
                    1/0)) AS ?referenceServer)
        BIND (REPLACE(?bare, "^.*Observation/", "") AS ?referenceId)
        BIND (CONCAT("90c60849-c5ef-4ca6-bfb8-8662bd07d2b5|https://ns.cascadeprotocol.org/cascade#RecordFromServerNamingRule",
                     "|", REPLACE(REPLACE(?referenceServer, "%", "%25"), "\\|", "%7C"),
                     "|", REPLACE(REPLACE("Observation", "%", "%25"), "\\|", "%7C"),
                     "|", REPLACE(REPLACE(?referenceId, "%", "%25"), "\\|", "%7C")) AS ?referenceInput)
        BIND (BOUND(?referenceInput) && EXISTS {
                ?known fhirr4:resourceType "Observation" ;
                  fhirr4:resourceId ?knownId ;
                  fhirr4:heldAt ?knownSelector .
                FILTER (BOUND(?server) && ?referenceServer = ?server && ?referenceId = ?knownId)
              } AS ?inDocument)
        BIND (?inDocument && EXISTS {
                ?known fhirr4:resourceType "Observation" ;
                  fhirr4:resourceId ?knownId ;
                  fhirr4:heldAt ?knownSelector .
                FILTER (?referenceServer = ?server && ?referenceId = ?knownId)
                ?knownVariant fhirr4:variantAt ?knownPointer .
                FILTER (?knownPointer = ?knownSelector || ?knownPointer = CONCAT(?knownSelector, "/resource"))
              } AS ?knownIsVariant)

        BIND (?isRelative && (EXISTS {
                ?entryRoot xyz:fullUrl ?entryUrl .
                FILTER (STRSTARTS(?entryUrl, "urn:uuid:"))
                { ?entryRoot xyz:resource ?entryTop } UNION { ?entryRoot xyz:resourceType ?entryTopType . BIND (?entryRoot AS ?entryTop) }
                { ?entryTop xyz:resourceType ?entryMemberType . BIND (?entryTop AS ?entryMember) }
                UNION { ?entryTop xyz:contained ?entryList . ?entryList ?entrySlot ?entryMember }
                FILTER (?entryMember = ?resource)
              } || EXISTS {
                ?urnKnown fhirr4:resourceType "Observation" ;
                  fhirr4:resourceId ?urnKnownId ;
                  fhirr4:fullUrl ?urnKnownUrl .
                FILTER (STRSTARTS(?urnKnownUrl, "urn:uuid:") && ?urnKnownId = STRAFTER(?bare, "Observation/"))
              }) AS ?relativeUndefined)
        BIND (IF(?isUrn,
                 IF(BOUND(?heldSelector) && !?ambiguous && ?heldIsVariant, ?heldInput, 1/0),
                 IF(?relativeUndefined, 1/0,
                    IF(BOUND(?referenceInput) && (!?inDocument || ?knownIsVariant), ?referenceInput, 1/0))) AS ?variantInput)
        BIND (IF(!BOUND(?variantInput) && (?isUrn || ?isRelative || ?isAbsolute), ?reference, 1/0) AS ?otherTarget)
        FILTER (BOUND(?variantInput) || BOUND(?otherTarget))
      }
      GROUP BY ?resource
    }
    FILTER (?variantTargets = 1 && ?otherTargets = 0)
    BIND (SHA256(?soleInput) AS ?variantHash)
    BIND (REPLACE(REPLACE(REPLACE(REPLACE(SUBSTR(?variantHash, 17, 1), "[048c]", "8"), "[159d]", "9"), "[26ae]", "a"), "[37bf]", "b")
          AS ?variantVariant)
    BIND (IRI(CONCAT("urn:uuid:", SUBSTR(?variantHash, 1, 8), "-", SUBSTR(?variantHash, 9, 4), "-8", SUBSTR(?variantHash, 14, 3), "-",
                     ?variantVariant, SUBSTR(?variantHash, 18, 3), "-", SUBSTR(?variantHash, 21, 12))) AS ?variantRecord)
  }

  OPTIONAL { ?resource xyz:status ?status }
}
