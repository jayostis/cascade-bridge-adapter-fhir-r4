PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX fx:      <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:     <http://sparql.xyz/facade-x/data/>
PREFIX bridge:  <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX fhirr4:  <https://ns.cascadeprotocol.org/adapter/fhir-r4/v1-draft#>

# One row for each Observation of the record that the Genomics Reporting IG
# calls a Variant, by its LOINC code 69548-6 and not by its profile, which
# senders omit. Its value is Present (LA9633-4) or absent, and then it is a
# variant record, or it is another answer or another kind of value, and then it
# is neither a record nor a lab result. lab-result-table.rq leaves out all of
# them.

CONSTRUCT {
  [] ?table ?pointer .
}
WHERE {
  bridge:thisRecord bridge:selector ?recordSelector .
  ?root a fx:root .
  { ?root xyz:resourceType ?topType . BIND (?root AS ?top) BIND ("" AS ?topStep) }
  UNION
  { ?root xyz:resource ?top . ?top xyz:resourceType ?topType . BIND ("/resource" AS ?topStep) }
  { BIND ("" AS ?containedStep) }
  UNION
  {
    ?top xyz:contained ?containedList .
    ?containedList ?containedSlot ?contained .
    ?contained xyz:resourceType ?containedType .
    BIND (CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?containedSlot), "#_")) - 1)) AS ?containedStep)
  }
  BIND (COALESCE(?contained, ?top) AS ?resource)
  ?resource xyz:resourceType "Observation" .
  FILTER EXISTS {
    ?resource xyz:code ?concept . ?concept xyz:coding ?codings . ?codings ?codingSlot ?coding .
    ?coding xyz:system "http://loinc.org" ;
      xyz:code "69548-6" .
  }
  BIND (EXISTS {
          ?resource xyz:valueCodeableConcept ?value . ?value xyz:coding ?valueCodings .
          ?valueCodings ?valueCodingSlot ?valueCoding .
          ?valueCoding xyz:system "http://loinc.org" ;
            xyz:code "LA9633-4" .
        } AS ?present)
  BIND (EXISTS {
          ?resource ?valueMember ?valueNode .
          FILTER (STRSTARTS(STR(?valueMember), "http://sparql.xyz/facade-x/data/value"))
        } AS ?valued)
  BIND (IF(?present || !?valued, fhirr4:variantAt, fhirr4:variantNotPresentAt) AS ?table)
  BIND (CONCAT(?recordSelector, ?topStep, ?containedStep) AS ?pointer)
}
