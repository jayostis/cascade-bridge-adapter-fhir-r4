@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix void:    <http://rdfs.org/ns/void#> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix fhirr4:  <https://ns.cascadeprotocol.org/adapter/fhir-r4/v1-draft#> .

fhirr4:codeSystems a skos:ConceptScheme ;
  skos:prefLabel "The code systems whose codes the mappings write as IRIs"@en .

fhirr4:codeSystemSnomedCt a skos:Concept ;
  skos:inScheme fhirr4:codeSystems ;
  skos:prefLabel "SNOMED CT"@en ;
  cascade:codingSystemUri "http://snomed.info/sct"^^xsd:anyURI ;
  void:uriSpace "http://snomed.info/id/" ;
  dct:source <https://terminology.hl7.org/SNOMEDCT.html> , <https://github.com/jayostis/cascade-vocabulary/blob/main/decisions/code-iris.md> .

fhirr4:codeSystemRxNorm a skos:Concept ;
  skos:inScheme fhirr4:codeSystems ;
  skos:prefLabel "RxNorm"@en ;
  cascade:codingSystemUri "http://www.nlm.nih.gov/research/umls/rxnorm"^^xsd:anyURI ;
  void:uriSpace "https://ns.cascadeprotocol.org/codes/rxnorm/" ;
  dct:source <https://github.com/jayostis/cascade-vocabulary/blob/main/decisions/code-iris.md> .

fhirr4:codeSystemNdc a skos:Concept ;
  skos:inScheme fhirr4:codeSystems ;
  skos:prefLabel "NDC"@en ;
  cascade:codingSystemUri "http://hl7.org/fhir/sid/ndc"^^xsd:anyURI ;
  void:uriSpace "https://ns.cascadeprotocol.org/codes/ndc11/" ;
  dct:source <https://hl7.org/fhir/R4/ndc.html> , <https://github.com/jayostis/cascade-vocabulary/blob/main/decisions/code-iris.md> .

fhirr4:codeSystemIcd10Cm a skos:Concept ;
  skos:inScheme fhirr4:codeSystems ;
  skos:prefLabel "ICD-10-CM"@en ;
  cascade:codingSystemUri "http://hl7.org/fhir/sid/icd-10-cm"^^xsd:anyURI ;
  void:uriSpace "https://ns.cascadeprotocol.org/codes/icd10cm/" ;
  dct:source <https://github.com/jayostis/cascade-vocabulary/blob/main/decisions/code-iris.md> .

fhirr4:codeSystemLoinc a skos:Concept ;
  skos:inScheme fhirr4:codeSystems ;
  skos:prefLabel "LOINC"@en ;
  cascade:codingSystemUri "http://loinc.org"^^xsd:anyURI ;
  void:uriSpace "http://loinc.org/rdf/" ;
  dct:source <https://github.com/HL7/UTG/blob/18bfa0662fbf6c9f6f51922e46c534b00d987848/input/sourceOfTruth/external/v3/namingSystems/v3-loinc.xml> , <https://github.com/jayostis/cascade-vocabulary/blob/main/decisions/code-iris.md> .

fhirr4:codeSystemCvx a skos:Concept ;
  skos:inScheme fhirr4:codeSystems ;
  skos:prefLabel "CVX"@en ;
  cascade:codingSystemUri "http://hl7.org/fhir/sid/cvx"^^xsd:anyURI ;
  void:uriSpace "https://ns.cascadeprotocol.org/codes/cvx/" ;
  dct:source <https://github.com/jayostis/cascade-vocabulary/blob/main/decisions/code-iris.md> .

fhirr4:codeSystemDataAbsentReason a skos:Concept ;
  skos:inScheme fhirr4:codeSystems ;
  skos:prefLabel "FHIR data absent reason"@en ;
  cascade:codingSystemUri "http://terminology.hl7.org/CodeSystem/data-absent-reason"^^xsd:anyURI ;
  void:uriSpace "https://ns.cascadeprotocol.org/codes/data-absent-reason/" ;
  dct:source <https://terminology.hl7.org/CodeSystem-data-absent-reason.html> , <https://github.com/jayostis/cascade-vocabulary/blob/main/decisions/partial-dates-and-absent-reasons.md> .

fhirr4:codeSystemNullFlavor a skos:Concept ;
  skos:inScheme fhirr4:codeSystems ;
  skos:prefLabel "HL7 v3 NullFlavor"@en ;
  cascade:codingSystemUri "http://terminology.hl7.org/CodeSystem/v3-NullFlavor"^^xsd:anyURI ;
  void:uriSpace "https://ns.cascadeprotocol.org/codes/nullflavor/" ;
  dct:source <https://terminology.hl7.org/CodeSystem-v3-NullFlavor.html> , <https://github.com/jayostis/cascade-vocabulary/blob/main/decisions/partial-dates-and-absent-reasons.md> .

fhirr4:absentReasonCodes a skos:ConceptScheme ;
  skos:prefLabel "The codes a reason a value is absent may be: those HL7 Terminology's data-absent-reason and v3-NullFlavor CodeSystems define, which the vocabulary's shapes list"@en ;
  dct:source <https://terminology.hl7.org/CodeSystem-data-absent-reason.json> , <https://terminology.hl7.org/CodeSystem-v3-NullFlavor.json> .

