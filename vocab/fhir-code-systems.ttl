fhirr4:codeSystems a skos:ConceptScheme ;
  skos:prefLabel "The code systems a Coding.system is read as, by the system's URI, its OID after urn:oid: or a URI HL7 Terminology lists as not preferred, each with the stem of its codes' IRIs where a mapping writes them as IRIs"@en .

fhirr4:codeSystemSnomedCt a skos:Concept ;
  skos:inScheme fhirr4:codeSystems ;
  skos:prefLabel "SNOMED CT"@en ;
  skos:notation "2.16.840.1.113883.6.96" ;
  cascade:codingSystemUri "http://snomed.info/sct"^^xsd:anyURI ;
  void:uriSpace "http://snomed.info/id/" ;
  dct:source <https://terminology.hl7.org/SNOMEDCT.html> , <https://hl7.org/fhir/R4/terminologies-systems.html> , <https://github.com/jayostis/cascade-vocabulary/blob/main/decisions/code-iris.md> .

