@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#> .
@prefix fhirr4: <https://ns.cascadeprotocol.org/adapter/fhir-r4/v1-draft#> .

fhirr4:gaps a skos:ConceptScheme ;
  skos:prefLabel "FHIR R4 JSON gaps"@en .

fhirr4:documentNotR4 a skos:Concept ;
  skos:prefLabel "A document states a FHIR version other than R4, and nothing in it is carried."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:valueNotMapped ;
  sh:resultSeverity sh:Warning .

fhirr4:administrativeGenderNotMapped a skos:Concept ;
  skos:prefLabel "A patient's gender is not one of the four codes of FHIR's administrative gender, which its binding requires, so no gender is carried."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:valueNotMapped ;
  sh:resultSeverity sh:Warning .

fhirr4:recordedDate a skos:Concept ;
  skos:prefLabel "An allergy or a condition carries the date it was first recorded, and no Cascade predicate carries it."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:noPredicate .

fhirr4:referenceDisplay a skos:Concept ;
  skos:prefLabel "A reference carries a display string beside the resource it points at, and no Cascade predicate carries it."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:noPredicate .

fhirr4:resourceTypeNotMapped a skos:Concept ;
  skos:prefLabel "A resource is of a type this release of the adapter does not map, and nothing in it is carried."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:valueNotMapped ;
  sh:resultSeverity sh:Warning .

fhirr4:resourceIdRepeated a skos:Concept ;
  skos:prefLabel "A resource shares its type and id, or its urn:uuid fullUrl, with another resource of its document: a reference to the shared id names nothing, and the document names the record, or, for an Organization from a server, nothing names one."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:idRepeated .

fhirr4:narrative a skos:Concept ;
  skos:prefLabel "A resource carries a human-readable narrative, and no Cascade predicate carries it."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:noPredicate .

fhirr4:serverSource a skos:Concept ;
  skos:prefLabel "A resource's metadata names the system its server received it from, and no Cascade predicate carries it."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:noPredicate .

fhirr4:procedureReason a skos:Concept ;
  skos:prefLabel "A procedure references the resource it was performed for, and no Cascade predicate carries the link."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:noPredicate .

fhirr4:referenceWithoutServer a skos:Concept ;
  skos:prefLabel "A resource references its patient relative to a server, in a document from no known server, so the reference names no record and nothing carries it."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:carriedWithLoss ;
  sh:resultSeverity sh:Warning .

fhirr4:referenceNotHeld a skos:Concept ;
  skos:prefLabel "A resource references its patient by a urn:uuid no entry of its document has as its fullUrl, so the reference names no record and nothing carries it."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:carriedWithLoss ;
  sh:resultSeverity sh:Warning .

fhirr4:referenceBaseRefused a skos:Concept ;
  skos:prefLabel "A resource references its patient by an absolute URL whose server base is not a plain scheme, host, port and path, as one holding userinfo, a query, a fragment, a percent-encoding, a dot segment, a space or a control character, or a port that is not a number up to 65535, so the reference names no record and nothing carries it."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:carriedWithLoss ;
  sh:resultSeverity sh:Warning .

fhirr4:referenceRelativeUndefined a skos:Concept ;
  skos:prefLabel "A resource references its patient as Patient/<id> from an entry whose fullUrl is a urn:uuid, or to an entry held under a urn:uuid, which FHIR gives no meaning, so the reference names no record and nothing carries it."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:carriedWithLoss ;
  sh:resultSeverity sh:Warning .

fhirr4:observationNotLabResult a skos:Concept ;
  skos:prefLabel "An Observation is not a laboratory result, by its category or, where it has none, by its code, or it is a panel of other results, and nothing in it is carried."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:valueNotMapped ;
  sh:resultSeverity sh:Warning .

fhirr4:medicationReferenceUnresolved a skos:Concept ;
  skos:prefLabel "A medication names its drug by a reference that resolves to no one Medication resource of its document, so only the reference's display is carried as the drug's name, and no code."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:carriedWithLoss ;
  sh:resultSeverity sh:Warning .

fhirr4:medicationNote a skos:Concept ;
  skos:prefLabel "A medication carries a note, and no Cascade predicate carries it."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:noPredicate .

fhirr4:ndcNotNormalised a skos:Concept ;
  skos:prefLabel "An NDC not in the 10-digit hyphenated forms 4-4-2, 5-3-2 or 5-4-1, nor 11 digits, so no 11-digit form can be made of it."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:noPredicate .

fhirr4:medicationDosageRepeated a skos:Concept ;
  skos:prefLabel "A medication carries more than one dosage, and only the first dosage's text is carried: each dosage's structure is, but no Cascade term holds a later dosage's text."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:carriedWithLoss ;
  sh:resultSeverity sh:Warning .

fhirr4:labResultPeriodEnd a skos:Concept ;
  skos:prefLabel "A lab result carries the end of the period it was performed over, and no Cascade predicate carries it."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:noPredicate .

fhirr4:labResultRangeRepeated a skos:Concept ;
  skos:prefLabel "A lab result carries more than one reference range, and only the first is carried."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:carriedWithLoss ;
  sh:resultSeverity sh:Warning .

fhirr4:labResultUnitCodeOutsideUcum a skos:Concept ;
  skos:prefLabel "A number of a lab result carries a unit code in a system other than UCUM, which is not carried as a UCUM unit; its unit text is."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:carriedWithLoss .

fhirr4:labResultBoundWithComparator a skos:Concept ;
  skos:prefLabel "A bound of a lab result's reference range or range value carries a comparator, which FHIR's SimpleQuantity forbids (sqty-1), and the bound is not carried as a number."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:carriedWithLoss ;
  sh:resultSeverity sh:Warning .

fhirr4:labResultNumberRefused a skos:Concept ;
  skos:prefLabel "A number of a lab result is not in FHIR's decimal form, lies beyond twenty digits of the point, carries a comparator other than R4's four, or is a bound carrying a comparator, so it is not carried as a typed number: its value is carried as text, and a reference range holding it types neither bound."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:carriedWithLoss ;
  sh:resultSeverity sh:Warning .

fhirr4:labResultValueCode a skos:Concept ;
  skos:prefLabel "A lab result's coded value carries a code in a system other than SNOMED CT or LOINC, which is not carried as a code; its text is."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:carriedWithLoss .

fhirr4:variantNotPresent a skos:Concept ;
  skos:prefLabel "A genetic variant assessment states a value other than Present, and a variant record says the person has the variant, so the assessment is no record."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:valueNotMapped ;
  sh:resultSeverity sh:Warning .

fhirr4:variantHgvsGeneOrProtein a skos:Concept ;
  skos:prefLabel "A variant's c.HGVS expression names a gene in parentheses or a protein change after the change, and the normal form carries neither."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:carriedWithLoss .

fhirr4:variantHgvsNoReferenceSequence a skos:Concept ;
  skos:prefLabel "A variant's c.HGVS expression names no reference sequence with a version, of a kind the vocabulary takes, so no expression is carried."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:valueNotMapped ;
  sh:resultSeverity sh:Warning .

fhirr4:variantHgvsNotCoding a skos:Concept ;
  skos:prefLabel "A variant's c.HGVS element holds an expression that is not a coding (c.) expression, so no expression is carried."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:valueNotMapped ;
  sh:resultSeverity sh:Warning .

fhirr4:variantHgvsRepeated a skos:Concept ;
  skos:prefLabel "A variant states more than one different c.HGVS expression, and a variant states one, so none is carried."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:valueNotMapped ;
  sh:resultSeverity sh:Warning .

fhirr4:variantClinvarNotVariation a skos:Concept ;
  skos:prefLabel "A variant's ClinVar code is no variation's ID, as an RCV or SCV accession is not, so no ClinVar ID is carried."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:valueNotMapped ;
  sh:resultSeverity sh:Warning .

fhirr4:variantClinvarRepeated a skos:Concept ;
  skos:prefLabel "A variant states more than one different ClinVar variation ID, and a variant states one, so none is carried."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:valueNotMapped ;
  sh:resultSeverity sh:Warning .

fhirr4:variantDiscreteVariantCode a skos:Concept ;
  skos:prefLabel "A variant's discrete genetic variant element carries a code from a system other than ClinVar, and no Cascade predicate carries it."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:noPredicate .

fhirr4:variantGeneWithoutSymbol a skos:Concept ;
  skos:prefLabel "A variant's gene studied coding has no display, and the gene symbol is the display, so no gene symbol is carried."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:valueNotMapped ;
  sh:resultSeverity sh:Warning .

fhirr4:variantGeneRepeated a skos:Concept ;
  skos:prefLabel "A variant names more than one different gene symbol, and a variant has one, so none is carried."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:valueNotMapped ;
  sh:resultSeverity sh:Warning .

fhirr4:interpretationClassification a skos:Concept ;
  skos:prefLabel "A diagnostic implication's classification is not exactly one of the five ACMG/AMP answers of LOINC, so no classification is carried."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:valueNotMapped ;
  sh:resultSeverity sh:Warning .

fhirr4:interpretationVariantLink a skos:Concept ;
  skos:prefLabel "A diagnostic implication is derived from no variant record, from more than one, or from something else beside one, so it states no link to a variant."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:carriedWithLoss ;
  sh:resultSeverity sh:Warning .

fhirr4:performerCarriedOnlyAsOneOrganizationRecord a skos:Concept ;
  skos:prefLabel "A performer is carried only as the one organization record it names: a diagnostic implication's, an Organization of its document, and a lab result's from a server, an Organization of that server by type and id; one whose performers name no organization record, or more than one, is attributed to none, and any other performer is not carried."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:carriedWithLoss ;
  sh:resultSeverity sh:Warning .

fhirr4:variantComponentNotCarried a skos:Concept ;
  skos:prefLabel "A variant or a diagnostic implication carries components no Cascade term carries, as the genomic and protein HGVS, the allelic state, the predicted phenotype and the level of evidence."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:carriedWithLoss .

fhirr4:identifierCarriedForLabResultsAndOrganizationsOnly a skos:Concept ;
  skos:prefLabel "A resource's business identifiers are carried for a lab result, which the matcher compares within one organization, and for an Organization a document names, which is named by one, or one from a server, whose version states them; any other record's are not, since nothing reads them. An identifier's assigner (Identifier.assigner) is not read: the organization a lab result's identifier belongs to is the one its document names as custodian or author."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:carriedWithLoss .

fhirr4:issuedNotCarried a skos:Concept ;
  skos:prefLabel "A result carries the time it was issued, which is not when it was performed, and only a diagnostic implication's is carried, as its date."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:carriedWithLoss .

fhirr4:variantTimeNotCarried a skos:Concept ;
  skos:prefLabel "A variant carries the time it was collected or resulted, and no Cascade term carries it, though a lab result's and a diagnostic implication's are."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:carriedWithLoss .

fhirr4:absentReasonNotCarried a skos:Concept ;
  skos:prefLabel "A value FHIR says is absent gives a reason in a code system other than FHIR's data absent reasons and v3 NullFlavor, or a code its system does not define, or only text, and that reason is not carried; the absence is, where another reason is given."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:carriedWithLoss .

fhirr4:duplicateOrganizationNotCarried a skos:Concept ;
  skos:prefLabel "Two Organizations of one document carry the identifier one organization record is named by, and the record's one version is read from the one a custodian names, else the first: a name, an identifier or an address only the other holds is not carried."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:carriedWithLoss .

fhirr4:addressCarriedForOrganizationsOnly a skos:Concept ;
  skos:prefLabel "An address is carried only for an Organization a document names, as its record's version's cascade:organizationAddress: any other resource's address, a patient's among them, is not, since no Cascade predicate carries it, and nor is an Organization's whose record another Organization of the document gives the version of."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:carriedWithLoss .

fhirr4:medicationRequestIntentNotMapped a skos:Concept ;
  skos:prefLabel "A prescribed request's intent is not one of the eight codes of FHIR's medicationrequest-intent, which its binding requires, so no intent is carried."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:valueNotMapped ;
  sh:resultSeverity sh:Warning .

fhirr4:codingNotCarried a skos:Concept ;
  skos:prefLabel "A coding of a lab result's test, a medication's drug, a condition or a procedure states no system, a system that is no absolute URI or holds a character an IRI may not, or no code, or a code of blanks, so its code is not carried."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:carriedWithLoss .

fhirr4:procedureCptCodeRepeated a skos:Concept ;
  skos:prefLabel "A procedure carries more than one CPT code, and a procedure holds one, so only the first is carried."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:carriedWithLoss ;
  sh:resultSeverity sh:Warning .

fhirr4:labResultInterpretationNotCarried a skos:Concept ;
  skos:prefLabel "A lab result's interpretation is a coding in a system other than HL7's v3 ObservationInterpretation, v2's table 0078 among them, a coding with no system or no code, or text where none of its codings is carried, and it is not carried."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:carriedWithLoss .

fhirr4:dispenseQuantityNotCarried a skos:Concept ;
  skos:prefLabel "A prescription states the quantity its dispense supplies, and no Cascade predicate carries it, so a supply is not computed from the quantity and the dose."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:noPredicate .

fhirr4:expectedSupplyDurationNotInUnitOfTime a skos:Concept ;
  skos:prefLabel "A prescription's expected supply duration is not in one of UCUM's seven units of time FHIR's Duration allows, so nothing of it is carried."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:valueNotMapped ;
  sh:resultSeverity sh:Warning .

fhirr4:expectedSupplyDurationBound a skos:Concept ;
  skos:prefLabel "A prescription's expected supply duration carries a comparator: it is carried with the comparator where that is one of R4's four, and not at all where it is another, and a bound gives the exposure derivation no end."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:carriedWithLoss ;
  sh:resultSeverity sh:Warning .

fhirr4:courseOfTherapyTypeNotMapped a skos:Concept ;
  skos:prefLabel "A prescription's course of therapy is a coding in a system other than FHIR's medicationrequest-course-of-therapy, a code that system does not define, or text where no coding is carried, so it is not carried."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:valueNotMapped ;
  sh:resultSeverity sh:Warning .

fhirr4:dosageElementNotCarried a skos:Concept ;
  skos:prefLabel "A dosage carries an element no Cascade predicate carries, such as its timing's count, duration, days, times of day or events, a bound that is no period, an as-needed condition, a site, a method, a rate, a dose range or a dose after the first, a maximum dose, or an instruction beside its text."@en ;
  skos:inScheme fhirr4:gaps ;
  skos:broader bridge:noPredicate .
